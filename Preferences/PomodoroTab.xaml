<UserControl x:Class="Focus_Bear.Preferences.PomodoroTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
             d:DesignHeight="670" d:DesignWidth="670" Background="#fff">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="auto" MinHeight="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0"  Name="Heading" Margin="20,0,20,0"  TextWrapping="Wrap" Text="xPomodoro Mode cycles between deep work blocks where a focus mode is turned on (and distractions turned off) and break periods."  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"  />
        <TextBlock Grid.Row="1" x:Name="LearnMore" Margin="20,10,20,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" TextDecorations="{x:Null}"   FontSize="14" MinHeight="22" Cursor="Hand">
             <Hyperlink x:Name="btnLearnMore"  Foreground="#000" Click="btnLearnMore_Click"   TextDecorations="Underline" ><Run x:Name="btnLearnMoreTXT" Text="xLearn more about the pomodoro technique here."/></Hyperlink>
        </TextBlock>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock   Name="PomodoroMode" Margin="0,0,0,0" Width="245" TextWrapping="Wrap" Text="xPomodoro Mode:"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Left"  />
            <CheckBox Name="EnterPomodoroCheck" Margin="20,3,0,0"  VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="14" Checked="EnterPomodoroCheck_Checked" Unchecked="EnterPomodoroCheck_Unchecked" Cursor="Hand" Padding="5,-2,0,0">
                <TextBlock Width="340" TextWrapping="Wrap" Name="EnterPomodoroCheckTxt">xEnter Pomodoro mode after completing morning routine </TextBlock></CheckBox>
        </StackPanel>
        <Button  Grid.Row="3"  x:Name="btnAdvanced"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"  Height="27" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="285,0,0,0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnAdvanced_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnAdvancedTXT" Text="xAdvanced"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <TextBlock Grid.Row="4"   Name="SuperPomodoroStatus" Margin="285,0,20,20"  TextWrapping="Wrap"    Text="xSuper Pomodoro mode not enabled."  Foreground="Gray" FontSize="13" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"  />

        <StackPanel Grid.Row="5"  Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock  Name="PomodoroModeDuration"  Width="245" Margin="0,0,0,0" TextWrapping="Wrap" Text="xPomodoro Mode duration:" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Center"/>

            <TextBox    TabIndex="1" x:Name="PomodoroMinutes" Margin="20,0,0,0" MinHeight="25"  Width="35"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="MinutesBreak_PreviewTextInput" PreviewKeyDown="MinutesBreak_PreviewKeyDown" PreviewKeyUp="MinutesBreak_PreviewKeyUp" TextChanged="PomodoroMinutes_TextChanged"  >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <TextBlock  Name="MinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="6"  Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock  Name="BreakDuration"  Width="245" Margin="0,0,0,0" TextWrapping="Wrap" Text="xBreak duration:" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Center"/>

            <TextBox    TabIndex="1" x:Name="BreakMinutes" Margin="20,0,0,0" MinHeight="25"  Width="35"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="MinutesBreak_PreviewTextInput" PreviewKeyDown="MinutesBreak_PreviewKeyDown" PreviewKeyUp="MinutesBreak_PreviewKeyUp" TextChanged="MinutesBreak_TextChanged" >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <TextBlock  Name="BreakMinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
