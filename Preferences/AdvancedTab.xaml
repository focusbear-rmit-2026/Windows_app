<UserControl x:Class="Focus_Bear.Preferences.AdvancedTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
              d:DesignHeight="670" d:DesignWidth="670" Background="#fff" IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="{DynamicResource SoftCreamColor}"/>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray">

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="EnableMeetingDetection" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection</TextBlock>
                    <TextBlock x:Name="EnableMeetingDetectionDesc" Margin="0,0,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection to automatically suggest starting \"Meetings\" focus mode when Focus Bear detects you are in a call.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableMeetingDetection" AutomationProperties.AutomationId="tglEnableMeetingDetection"  Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableMeetingDetection_Checked" Unchecked="btnEnableMeetingDetection_Unchecked" />

            </Grid>

            <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="SuggestStartMeetings" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAutomatically suggest starting \"Meetings\" focus mode</TextBlock>
                    <TextBlock x:Name="SuggestStartMeetingsDesc" Margin="0,0,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWhen you start a video call, Focus Bear can prompt you to start the Meeting focus mode to help you stay focused during the meeting.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnSuggestStartMeetingsFocus" AutomationProperties.AutomationId="tglSuggestStartMeetingsFocus" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnSuggestStartMeetingsFocus_Checked" Unchecked="btnSuggestStartMeetingsFocus_Unchecked" />
            </Grid>

            <Grid Grid.Row="3"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="BlockSuperDistracting" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xBlock \"Super Distracting Sites\" during Meetings</TextBlock>
                    <TextBlock x:Name="BlockSuperDistractingDesc" Margin="0,0,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAvoid awkward screensharing moments. Turn this setting off if you don’t want blocking to happen while you’re in meetings.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnBlockSuperDistracting" AutomationProperties.AutomationId="tglBlockSuperDistracting" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnBlockSuperDistracting_Checked" Unchecked="btnBlockSuperDistracting_Unchecked"/>
            </Grid>

                <Grid Grid.Row="5"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="ShowBreaksWhileInCall" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xShow breaks while in call</TextBlock>
                        <TextBlock x:Name="ShowBreaksWhileInCallDesc" Margin="0,0,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xIn large meetings where you’re not actively participating, it can be helpful to still have break reminders. We’ll choose office friendly break activities (e.g. chair stretches) and won’t play sound effects.. </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnShowBreaksWhileInCall" AutomationProperties.AutomationId="tglShowBreaksWhileInCall" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnShowBreaksWhileInCall_Checked" Unchecked="btnShowBreaksWhileInCall_Unchecked"/>
                </Grid>

                <Grid Grid.Row="7"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="EnableFBTT" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable Focus Bear Time Tracker</TextBlock>
                        <TextBlock x:Name="EnableFBTTDesc" Margin="0,0,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAnalyse your productivity by tracking how much time you spend on different websites and apps. You can automatically categorise time logs into different projects (helpful for timesheets). Data is stored locally for privacy reasons.</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableFBTT" AutomationProperties.AutomationId="tglEnableFBTT" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableFBTT_Checked" Unchecked="btnEnableFBTT_Unchecked"/>
                </Grid>
            
            </Grid>
        </Border>

        


    </Grid>
</UserControl>
