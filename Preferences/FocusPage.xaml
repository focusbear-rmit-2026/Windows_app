<Page x:Class="Focus_Bear.Preferences.FocusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d" 
      d:DesignHeight="670" d:DesignWidth="670"
      Title="FocusPage" Background="#fff" >

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource rowContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border  x:Name="IconBorder" Background="{x:Null}" CornerRadius="5" Margin="0,1" >
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#e9912c" Opacity="1" />

                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#e9912c" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="{Binding isShowAbleInList, Converter={StaticResource BoolToVis}}" />
        </Style>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <TextBlock  Grid.Row="0" Name="Heading" Margin="32,0,0,5" Width="600" TextWrapping="Wrap" Text="xFocus Type" Foreground="#272727" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />

        <Grid  Grid.Row="1" Margin="30,0,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#fcf8f0" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <ListView   Grid.Row="0"   x:Name="ListFocusModes"  SelectionMode="Single" ItemContainerStyle="{StaticResource ListViewItemStyle}"  Margin="10,10,10,10" VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="White" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" SelectionChanged="ListFocusModes_SelectionChanged" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ItemHeader"  Height="40"  Background="Transparent"  Margin="10,0,10,0" IsHitTestVisible="True" Cursor="Hand" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{Binding color, StringFormat=\{0\}}" Width="25" Height="25"  RadiusX="4" RadiusY="4"></Rectangle>
                                <TextBlock Grid.Column="1" Text="{Binding name, StringFormat=\{0\}}" Foreground="#000"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                <Image x:Name="InfoImageMeetings" Grid.Column="2" Source="../images/info.png" Width="18"  Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding Path=isMeetings, Converter={StaticResource BoolToVis}}" ToolTip="{Binding sToolTip, StringFormat=\{0\}}"></Image>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <Button Grid.Row="1" x:Name="btnAddFocusMode"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="26"  VerticalAlignment="Center" Padding="0" Margin="10,0,10,0" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddFocusMode_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock x:Name="btnAddFocusModeTXT" Text="xAdd Focus Mode"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </Grid>
            <Grid Grid.Column="1" Background="#fcf8f0" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="142"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="25"/>

                    <RowDefinition Height="25"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="142"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" TabIndex="0" x:Name="TxtFocusName" Margin="20,10,10,10" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" Height="25" LostFocus="TxtFocusName_LostFocus" KeyDown="TxtFocusName_KeyDown">
                </TextBox>

                <RadioButton Grid.Row="1"  Name="AllowAllApps" Margin="20,5,0,0" GroupName="allowApps"  FontSize="13" Checked="AllowAllApps_Checked">
                   xAllow all apps
                </RadioButton>
                <RadioButton Grid.Row="2" Name="AllowSelectedApps" Margin="20,5,0,0" GroupName="allowApps"  FontSize="13" Checked="AllowSelectedApps_Checked">
                    xAllow Selected apps
                </RadioButton>
                <Grid Grid.Row="3" x:Name="SelectedAppsListBG" Background="#fff" Margin="20,5,20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>
                    <ListView   Grid.Row="0"   x:Name="ListApps" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}"  >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AppName, StringFormat=\{0\}}" Foreground="#000"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1"  x:Name="SelectedAppsListBGSeperator" Background="LightGray" ></Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button   x:Name="btnAddAllowedApp"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800"  Height="22" Width="22" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="2,0,0,2" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddAllowedApp_Click" >
                            
                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <Image Name="btnAddAllowedAppTXT" Height="16"  Width="16" Source="../Images/plus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button   x:Name="btnAddDeleteAllowedApp"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800"  Height="22" Width="22" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="2,0,0,2" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddDeleteAllowedApp_Click" >

                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <Image Name="btnAddDeleteAppTXT" Height="16"  Width="16" Source="../Images/minus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="4" Background="LightGray" Margin="20,0,20,0" />
                <TextBlock  Grid.Row="5" Name="HowDoYouWant" Margin="20,0,0,0"   Text="xHow do you want to block URLs"   FontSize="13" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />

                <RadioButton Grid.Row="6"  Name="BlockEverything" Margin="20,10,0,0" GroupName="URLsEverything"  FontSize="13" Checked="BlockEverything_Checked">
                    xBlock everything except safe sites that I choose sdsdsd sdsdsd sdsdsdsd
                </RadioButton>
                <RadioButton Grid.Row="7" Name="AllowEverything" Margin="20,10,0,0" GroupName="URLsEverything"  FontSize="13" Checked="AllowEverything_Checked">
                    xAllow everything except certain distracting sites
                </RadioButton>

               <!--<ComboBox  Grid.Row="8" Name="ComboBoxHowDoYouWant"  Width="250" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0"  SelectedIndex="0" FontSize="13" SelectionChanged="ComboBoxHowDoYouWant_SelectionChanged">
                </ComboBox>-->

                <Grid Grid.Row="9" Background="#fff" Margin="20,5,20,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="25"/>
                    </Grid.RowDefinitions>
                    <ListView   Grid.Row="0"   x:Name="ListURLs" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" MouseDoubleClick="ListURLs_MouseDoubleClick" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ., StringFormat=\{0\}}" Foreground="#000"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1" Background="LightGray" ></Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button   x:Name="btnAddAllowedURLs"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800"  Height="22" Width="22" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="2,0,0,2" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddAllowedURLs_Click">

                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <Image Name="btnAddAllowedURLsTXT" Height="16"  Width="16" Source="../Images/plus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button   x:Name="btnAddDeleteAllowedURLs"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800"  Height="22" Width="22" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="2,0,0,2" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddDeleteAllowedURLs_Click" >

                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <Image Name="btnAddDeleteURLsTXT" Height="16"  Width="16" Source="../Images/minus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="10" x:Name="btnAdvanced"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnadvanced_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock x:Name="btnAdvancedTXT" Text="xAdvanced"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
            </Grid>
        </Grid>
        
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,30,0">
            <Button  x:Name="btnDeleteFocusMode" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,5" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnDeleteFocusMode_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnDeleteFocusModeTXT" Text="xDelete"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  x:Name="btnDuplicateFocusMode"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="15,0,0,5" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnDuplicateFocusMode_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnDuplicateFocusModeTXT" Text="xDuplicate"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
