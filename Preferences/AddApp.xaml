<Window x:Class="Focus_Bear.Preferences.AddApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        xmlns:Models="clr-namespace:Focus_Bear.Models"
        mc:Ignorable="d"
        Title="Focus Bear" Height="600" Width="500" ResizeMode="NoResize" WindowStyle="None">
    <Window.Resources>
        <Models:IconExtractConverter x:Key="IconExtractConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource SoftCreamColor}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0"   Text="xSelect Apps to use while focusing:" FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />

            <TextBox  TabIndex="0" x:Name="SearchBox" AutomationProperties.AutomationId="txtBoxSearch" Margin="45,5,20,0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" Height="25" Width="150"  TextChanged="SearchBox_TextChanged">

            </TextBox>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="162*"/>
                <ColumnDefinition Width="203*"/>
                <ColumnDefinition Width="66*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="81*"/>
                <RowDefinition Height="394*"/>
            </Grid.RowDefinitions>
            <ListView   Grid.Row="0"   x:Name="ListInstalledApps" AutomationProperties.AutomationId="lvInstalledApps" SelectionMode="Multiple"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" Grid.ColumnSpan="4" Grid.RowSpan="2"  >
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Height="20" Width="20" HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="0,0,0,0" Source="{Binding DisplayIcon, Converter={StaticResource IconExtractConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppName, StringFormat=\{0\}}"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

        <Button  Grid.Row="2" x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Left" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,5" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnCancelTXT" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <Button  Grid.Row="2" x:Name="btnAdd" AutomationProperties.AutomationId="btnAdd"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,5" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnAdd_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnAddTXT" Text="xAdd" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <TextBlock  Grid.Row="3" x:Name="EnterManually" AutomationProperties.AutomationId="txtEnterManually" Margin="20,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Left" TextDecorations="{x:Null}"   FontSize="14" Height="22" Cursor="Hand">
             <Hyperlink x:Name="btnEnterManually" Click="btnEnterManually_Click"   TextDecorations="Underline" ><Run x:Name="btnEnterManuallyTXT" Text="xCan't find your app in the above list? Click here to enter manually."/></Hyperlink>
        </TextBlock>

        <Border x:Name="GridShadeAdvanced" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.80"   Visibility="Collapsed" />

    </Grid>
</Window>
