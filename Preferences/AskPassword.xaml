<Window x:Class="Focus_Bear.Preferences.AskPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        xmlns:local1="clr-namespace:Focus_Bear.AccountabilityBuddy"
        mc:Ignorable="d"
        Title="AskPassword" Height="300" Width="450" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" BorderThickness="1" BorderBrush="Gray" AutomationProperties.AutomationId="AskPassword">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <TabControl x:Name="MainTabControl" Margin="20,15,20,20" SelectionChanged="TabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabPanel}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </TabControl.Resources>
            <TabItem Name="PasswordTab" AutomationProperties.AutomationId="tabPassword" Header="xPassword" Style="{DynamicResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap" Text="xPlease enter the password to continue" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <PasswordBox Grid.Row="1" Width="300" MinHeight="27" TabIndex="1" x:Name="TxtPassword" AutomationProperties.AutomationId="txtBoxPassword" Margin="0,20,0,10"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" VerticalContentAlignment="Center">
                        <PasswordBox.Effect>
                            <DropShadowEffect ShadowDepth="3"
                                   Direction="330"
                                   Color="Gray"
                                   Opacity="0.5"
                                   BlurRadius="6"
                                    />
                        </PasswordBox.Effect>
                        <PasswordBox.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </PasswordBox.FocusVisualStyle>
                    </PasswordBox>

                    <Button  Grid.Row="3" x:Name="btnCancel"  AutomationProperties.AutomationId="btnCancel" Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="60,0,0,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click" >
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnCancelTXT" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button  Grid.Row="3" x:Name="btnOK" AutomationProperties.AutomationId="btnOK"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" IsDefault="True"   Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,60,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnOK_Click" >
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnOKTXT" Text="xOK" Style="{DynamicResource ButtonTextBlockStyle}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Name="RandomPasswordTab" AutomationProperties.AutomationId="tabRandomPassword" Header="xRandomPassword" Style="{DynamicResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="RandomPasswordHeading" TextWrapping="Wrap" FontSize="15" FontWeight="Bold" VerticalAlignment="Top" Margin="20,15,20,0" TextAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="xTo unlock your machine without a password, enter these characters. You said you wanted it to be hard to use your computer impulsively "/>
                        <Run Text="😅" FontFamily="Segoe UI Emoji"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Name="TxtGeneratedCode" Margin="20,0,20,0" 
                                TextWrapping="Wrap" FontSize="13" FontFamily="Consolas" 
                                TextAlignment="Center" 
                                Padding="10" VerticalAlignment="Center"/>
                    
                    <TextBox Grid.Row="2" Name="TxtUserEntry" Width="300" Margin="0,10,0,10"
                             TextWrapping="Wrap" FontSize="15" 
                             FontFamily="Consolas" VerticalContentAlignment="Center"
                             Background="#FFF" BorderBrush="#000" BorderThickness="1"
                             Foreground="Black">

                        <TextBox.Effect>
                            <DropShadowEffect ShadowDepth="3" Direction="330" Color="Black" Opacity="0.5" BlurRadius="6"/>
                        </TextBox.Effect>
                    </TextBox>

                    <Grid Grid.Row="3">
                        <Button x:Name="btnCancelRandom" AutomationProperties.AutomationId="btnCancelRandom" Style="{StaticResource BtnStyleClearOrangeBordered}" 
                    Height="26" Width="113" HorizontalAlignment="Left" Margin="60,0,0,15" 
                    VerticalAlignment="Center" Click="btnCancel_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="btnCancelRandomTXT" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button x:Name="btnVerifyRandom" AutomationProperties.AutomationId="btnVerifyRandom" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" 
                    Height="26" Width="113" HorizontalAlignment="Right" Margin="0,0,60,15" 
                    VerticalAlignment="Center" IsDefault="True" Click="btnVerifyRandom_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="btnOKRandomTXT" Text="xVerify" Style="{DynamicResource ButtonTextBlockStyle}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Name="AccountabilityBuddy" AutomationProperties.AutomationId="tabAccountabilityBuddy" Header="xAccountability Buddy" Style="{DynamicResource TabItemStyle}">
                <local1:AccountabilityBuddyView />
            </TabItem>
        </TabControl>
        
       
    </Grid>
</Window>
