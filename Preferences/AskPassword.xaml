<Window x:Class="Focus_Bear.Preferences.AskPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
        Title="AskPassword" Height="250" Width="450" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap" Text="xPlease enter the password to continue" Foreground="#000" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
        <PasswordBox Grid.Row="1" Width="300" Height="27" TabIndex="1" x:Name="TxtPassword" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" >
            <PasswordBox.Effect>
                <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
            </PasswordBox.Effect>
            <PasswordBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </PasswordBox.FocusVisualStyle>
        </PasswordBox>

        <Button  Grid.Row="2" x:Name="btnCancel"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Left" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="60,0,0,15" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnCancel_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnCancelTXT" Text="xCancel"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <Button  Grid.Row="2" x:Name="btnOK"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" IsDefault="True"   Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,60,15" FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnOK_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnOKTXT" Text="xOK"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Window>
