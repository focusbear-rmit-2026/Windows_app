<Window x:Class="Focus_Bear.Preferences.AddAppsManually"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
         Title="Focus Bear" Height="210" Width="450" ResizeMode="NoResize">
    <Grid Background="{DynamicResource SoftCreamColor}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap"  Text="xEnter apps manually:"   FontSize="13" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"  />
        
        
        <TextBox Grid.Row="1" TabIndex="0" x:Name="TxtApps" Margin="20,5,20,10" TextWrapping="Wrap"  BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" Height="25" TextChanged="TxtApps_TextChanged">

        </TextBox>

        <TextBlock  Grid.Row="2" Name="Instructions" Margin="20,0,20,0" TextWrapping="Wrap"  Text="xIf you know the name of the EXE that you want to allow, you can add them here. You can enter multiple exe names seperated with comma. Example: chrome.exe, firefox.exe, notepad.exe"   FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />
        <Grid Grid.Row="3" Background="LightGray" ></Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Grid.Column="0" Height="23" Width="100" Margin="20,0,0,0" HorizontalAlignment="Left" Click="btnCancel_Click" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}">xCancel</Button>
            <Button x:Name="btnAdd"  Grid.Column="1" Height="23" Width="100" Margin="0,0,20,0" HorizontalAlignment="Right" Click="btnAdd_Click" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}">xAdd</Button>

        </Grid>

    </Grid>
</Window>
