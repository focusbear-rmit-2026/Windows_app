<UserControl x:Class="Focus_Bear.Preferences.AlwaysBlockedURLs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d" 
       d:DesignHeight="670" d:DesignWidth="670"
        >

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid Background="{DynamicResource SoftCreamColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0"  Text="xAlways Blocked URLs" FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />
            <TextBlock  Grid.Row="1" Name="Description" Margin="20,0,20,0"   Text="xBlock these URLs even if you're not in a focus block. You might want to put social media or news sites that you would rather not use at any time. You can always set up an evening routine activity where you explicitly allow access to Facebook so that you can still stay connected - just not during your morning routine/work day." FontSize="12" TextWrapping="Wrap" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />

            <Grid Grid.Row="2"  Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <ListView   Grid.Row="0"   x:Name="ListBLockedURLs" AutomationProperties.AutomationId="lvBlockedURLs" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" MouseDoubleClick="ListBLockedURLs_MouseDoubleClick" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ., StringFormat=\{0\}}" Foreground="{DynamicResource ForegroundColor}" FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="1" Background="LightGray" ></Grid>
                <DockPanel Grid.Row="2" LastChildFill="False">
                    <Button   x:Name="btnDeleteURL" AutomationProperties.AutomationId="btnDeleteURL" MaxWidth="100" Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True" Foreground="#e88800"  Height="27" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="10,0,0,2" FontSize="12" Cursor="Hand" FontWeight="Normal" Click="btnDeleteURL_Click" >

                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnDeleteURLTXT" Cursor="Hand"  Text="xRemove" Style="{DynamicResource ButtonTextBlockStyle}" Margin="10,0,10,0"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button   x:Name="btnAddURL" AutomationProperties.AutomationId="btnAddURL" MaxWidth="100"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" Foreground="#e88800"  Height="27"  VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="2,0,10,2" FontSize="12" Cursor="Hand" FontWeight="Normal" Click="btnAddURL_Click" DockPanel.Dock="Right" >

                        <Button.Content>
                            <!--<StackPanel  Orientation="Horizontal">
                                <Image Name="btnAddURLTXT" Height="16"  Width="16" Source="{DynamicResource PlusImage}" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                            </StackPanel>-->
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnAddSiteTXT" Cursor="Hand"  Text="xAdd Site" Style="{DynamicResource ButtonTextBlockStyle}" Margin="10,0,10,0"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                   
                </DockPanel>
            </Grid>
            <CheckBox Grid.Row="3" x:Name="ImmediatelyBlockDistractingURLs" AutomationProperties.AutomationId="cbImmediatelyBlockDistractingURLs" Cursor="Hand" Margin="20,0,20,0" FontSize="13"    Checked="ImmediatelyBlockDistractingURLs_Checked" Unchecked="ImmediatelyBlockDistractingURLs_Unchecked" Visibility="Visible">
                <TextBlock x:Name="ImmediatelyBlockDistractingURLsText" TextWrapping="Wrap" Padding="3,0">xImmediately block super distracting sites</TextBlock>
            </CheckBox>
            
            <Border x:Name="GridShadeAdvanced" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.80"   Visibility="Collapsed" />

        </Grid>
    </Grid>
</UserControl>
