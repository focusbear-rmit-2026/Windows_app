<Page x:Class="Focus_Bear.Preferences.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d" 
       d:DesignHeight="670" d:DesignWidth="670"
      Title="Settings" >

    <Grid Background="{DynamicResource BackgroundCOlor}">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style TargetType="Grid">
                    <Setter Property="Background" Value="{DynamicResource SoftCreamColor}"/>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" >
            <RadioButton x:Name="GeekMode" AutomationProperties.AutomationId="rbGeekMode" Content="xGeek Mode" Style="{StaticResource SegmentRadioButtonStyle}"     Cursor="Hand"    />
            <RadioButton x:Name="SimpleMode" AutomationProperties.AutomationId="rbSimpleMode" Content="xSimple Mode" Style="{StaticResource SegmentRadioButtonStyle}"   Cursor="Hand"  />
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,10,20,15" Background="{DynamicResource BackgroundColor}">
            <TabControl x:Name="TabControlSettings"  BorderBrush="LightGray" >
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabPanel}">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </TabControl.Resources>
                <TabItem Name="GeneralTab" AutomationProperties.AutomationId="tabGeneral" Header="xGeneral" Style="{DynamicResource TabItemStyle}">
                    <ScrollViewer>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,50,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"   Name="FocusBearMode" Margin="0,2,15,0"  TextWrapping="Wrap"    Text="Focus Bear mode:"    FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,50,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <RadioButton Grid.Row="0" VerticalAlignment="Center"  Name="CuddlyMode" AutomationProperties.AutomationId="rbCuddlyMode" Margin="0,0,0,0" Padding="5,-4,0,0" GroupName="FocusBearMode"  FontSize="14" FontWeight="SemiBold" Checked="CuddlyMode_Checked">
                                    xCuddly Bear mode
                                </RadioButton>
                                <TextBlock Grid.Row="1"   Name="CuddlyModeDesc" Margin="20,0,0,20"  TextWrapping="Wrap"    Text="xCuddly Bear mode: kind and gentle - gives you the benefit of the doubt when you open a non-allowed URL. Lets you temporarily allow blocked URLs during a focus mode."   FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />

                                <RadioButton Grid.Row="2" VerticalAlignment="Center"  Name="GrizzlyMode" AutomationProperties.AutomationId="rbGrizzlyMode" Margin="0,0,0,0" Padding="5,-3,0,0" GroupName="FocusBearMode"  FontSize="14" FontWeight="SemiBold" Checked="GrizzlyMode_Checked">
                                    xGrizzly Bear mode
                                </RadioButton>
                                <TextBlock Grid.Row="3"    Name="GrizzlyModeDesc" Margin="20,0,0,20" TextWrapping="Wrap"   Text="xGrizzly Bear mode: super strict - immediately block URLs that aren't allowed and don't let yourself allow them until the focus mode is over."   FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />

                            </Grid>

                        </Grid>
                        <Grid Grid.Row="1" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="FullScreen" Margin="0,0,0,0"  Width="215" TextWrapping="Wrap"   Text="xFull Screen View:"   FontSize="13" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"  />
                                <CheckBox Name="FullScreenCheckbox" AutomationProperties.AutomationId="chkFullScreen" Margin="40,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Checked="FullScreenCheckbox_Checked" Unchecked="FullScreenCheckbox_Unchecked" Cursor="Hand" Padding="5,-2,0,0">xPlay activities in full screen mode</CheckBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="EnableBreaks" Margin="0,0,0,0"  Width="215" TextWrapping="Wrap"   Text="xBreaks"   FontSize="13" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"  />
                                <CheckBox Name="EnableBreaksCheckbox" AutomationProperties.AutomationId="chkEnableBreaks" Margin="40,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="13" Checked="EnableBreaksCheckbox_Checked" Unchecked="EnableBreaksCheckbox_Unchecked" Cursor="Hand" Padding="5,-2,0,0">xEnable Breaks</CheckBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="3" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,40,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="27"/>
                                    <RowDefinition MinHeight="27"/>
                                    <RowDefinition MinHeight="27"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"   Name="SelectFont"     Margin="0,7,15,0"   TextWrapping="Wrap"    Text="xApplication Font:"  FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />
                                <TextBlock Grid.Row="1"   Name="SelectLanguage" Margin="0,10,15,0"  TextWrapping="Wrap"    Text="xxSelect Language:"  FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />
                                <TextBlock Grid.Row="2"   Name="SelectDarkMode" Margin="0,13,15,0"  TextWrapping="Wrap"    Text="xxDark Mode:"        FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,40,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="27"/>
                                    <RowDefinition MinHeight="27"/>
                                    <RowDefinition MinHeight="27"/>
                                </Grid.RowDefinitions>
                                <ComboBox  Grid.Row="0" Name="Fonts" AutomationProperties.AutomationId="cmbFonts"  Width="200" HorizontalAlignment="Left" Margin="20,5,0,0"  SelectionChanged="Fonts_SelectionChanged"></ComboBox>
                                <ComboBox  Grid.Row="1" Name="Language" AutomationProperties.AutomationId="cmbLanguage" Width="200" HorizontalAlignment="Left" Margin="20,15,0,0" SelectionChanged="Language_SelectionChanged"></ComboBox>
                                <ComboBox  Grid.Row="2" Name="DarkMode" AutomationProperties.AutomationId="cmbDarkMode" Width="200" HorizontalAlignment="Left" Margin="20,15,0,0" SelectionChanged="DarkMode_SelectionChanged"></ComboBox>
                            </Grid>

                        </Grid>

                    </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Name="PomodoroTab" AutomationProperties.AutomationId="tabPomodoro" Header="xPomodoro" Style="{DynamicResource TabItemStyle}">
                    <!--<local:PomodoroTab x:Name="PomodoroTAB" />-->
                </TabItem>
                <TabItem Name="AdvancedTab" AutomationProperties.AutomationId="tabAdvanced" Header="xAdvanced" Style="{DynamicResource TabItemStyle}">

                </TabItem>
                <TabItem Name="BlockedURLTab" AutomationProperties.AutomationId="tabBlockedURLs" Header="xBlocked URLs" Style="{DynamicResource TabItemStyle}">
                    <!--<local:AITab x:Name="AITAB" />-->
                </TabItem>
                <TabItem Name="PasswordTab" AutomationProperties.AutomationId="tabPassword" Header="xPassword" Selector.Selected="PasswordTab_Selected" Style="{DynamicResource TabItemStyle}">
                    <ScrollViewer>
                    <Grid HorizontalAlignment="Center" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"   Name="PasswordHeading" Margin="0,0,0,0"  TextWrapping="NoWrap"    Text="xSet Password"   FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"  />
                        <TextBlock Grid.Row="1"   Name="PasswordDesc" Margin="20,0,20,0"  TextWrapping="Wrap"       FontSize="14" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"  >
                            If you're struggling to stick to your habits, get a housemate/partner to set a password. You won't be able to skip habits without the password.
                        </TextBlock>
                        <TextBlock  Grid.Row="2"  Width="300"  Name="lblPassword" Margin="0,15,0,0" TextWrapping="NoWrap" Text="xNew Password:"  FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid  Grid.Row="3" Width="300" VerticalAlignment="Center">

                            <PasswordBox Width="230" TabIndex="2" x:Name="TxtPassword" AutomationProperties.AutomationId="txtBoxPassword" Margin="0"    BorderBrush="#000"  Padding="5,2,5,5" BorderThickness="1" FontSize="14"  PasswordChanged="TxtPassword_PasswordChanged" Background="White"   >
                                <PasswordBox.Effect>
                                    <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6" />
                                </PasswordBox.Effect>
                                <PasswordBox.FocusVisualStyle>
                                    <Style>
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </PasswordBox.FocusVisualStyle>
                            </PasswordBox>

                        </Grid>

                        <TextBlock Grid.Row="4" Width="300" Name="lblConfirmPassword" Margin="0,15,0,0" TextWrapping="Wrap" Text="xConfirm Password:" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Row="5" Width="300" VerticalAlignment="Center">
                            <PasswordBox Width="230" TabIndex="3" x:Name="TxtConfirmPassword" AutomationProperties.AutomationId="txtBoxConfirmPassword" Margin="0" BorderBrush="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="14" PasswordChanged="TxtConfirmPassword_PasswordChanged" Background="White">
                                <PasswordBox.Effect>
                                    <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6"/>
                                </PasswordBox.Effect>
                                <PasswordBox.FocusVisualStyle>
                                    <Style>
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </PasswordBox.FocusVisualStyle>
                            </PasswordBox>
                        </Grid>

                        <!-- Password Mismatch Error Message -->
                        <TextBlock Grid.Row="5" x:Name="MessageDisplay"
           Margin="0,38,0,17"  
           FontSize="12" 
           TextAlignment="Center"
           Text="Passwords do not match!" 
           Visibility="Collapsed"
           HorizontalAlignment="Center" Width="180" Grid.RowSpan="2"/>

                        <!-- Set Password Button (moved to Row 7) -->
                        <Button Grid.Row="6" x:Name="btnSetPassword" AutomationProperties.AutomationId="btnSetPassword" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" MinHeight="27" Width="180" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSetPassword_Click" Grid.RowSpan="2" Margin="0,17,0,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="btnSetPasswordTXT" Text="xSet Password" Style="{DynamicResource ButtonTextBlockStyle}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Disable Password Link (moved to Row 8) -->
                        <TextBlock Grid.Row="7" x:Name="DisablePassword" AutomationProperties.AutomationId="txtDisablePassword" Margin="235,9,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" TextDecorations="{x:Null}" FontSize="14" MinHeight="22" Cursor="Hand" Grid.RowSpan="2">
    <Hyperlink x:Name="btnDisablePassword" Click="btnDisablePassword_Click" TextDecorations="Underline">
        <Run x:Name="btnDisablePasswordTXT" Text="xDisable Password"/>
    </Hyperlink>
                        </TextBlock>


                        <Grid Grid.Row="8" Margin="0,0,0,0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"   Name="AskForPassword" Margin="0,0,0,0"  TextWrapping="Wrap"    Text="xAsk for password"   FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />

                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"   Name="WhenRequire" Margin="20,0,0,0"  TextWrapping="Wrap"    Text="xWhen do you want to require a password?"   FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />
                                <StackPanel  Grid.Row="2"  Orientation="Vertical"   Margin="20,0,0,0" Grid.RowSpan="2" HorizontalAlignment="Left">
                                    <CheckBox Margin="0,10,0,10" x:Name="CheckChangingSettings" AutomationProperties.AutomationId="chkChangingSettings" FontSize="14" Checked="CheckChangingSettings_Checked" Unchecked="CheckChangingSettings_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xChanging Settings</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckPostponingMorningRoutine" AutomationProperties.AutomationId="chkPostponingMorningRoutine" FontSize="14" Checked="CheckPostponingMorningRoutine_Checked"  Unchecked="CheckPostponingMorningRoutine_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/skipping morning routine</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckPostponingEveningRoutine" AutomationProperties.AutomationId="chkPostponingEveningRoutine" FontSize="14" Checked="CheckPostponingEveningRoutine_Checked"  Unchecked="CheckPostponingEveningRoutine_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/skipping evening routine</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckSkipEveningAfterCutOff" AutomationProperties.AutomationId="chkSkipEveningAfterCutOff" FontSize="14" Checked="CheckSkipEveningAfterCutOff_Checked" Unchecked="CheckSkipEveningAfterCutOff_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/Skipping evening routine after cutoff time</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckUsingComputerLateNight" AutomationProperties.AutomationId="chkUsingComputerLateNight" FontSize="14" Checked="CheckUsingComputerLateNight_Checked"  Unchecked="CheckUsingComputerLateNight_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xUsing your computer late at night</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckQuittingApp" AutomationProperties.AutomationId="chkQuittingApp" FontSize="14" Checked="CheckQuittingApp_Checked" Unchecked="CheckQuittingApp_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xQuitting app</CheckBox>
                                    <CheckBox  Margin="0,0,0,10" x:Name="CheckUseRelaxMode" AutomationProperties.AutomationId="chkUseRelaxMode" FontSize="14" Checked="CheckUseRelaxMode_Checked" Unchecked="CheckUseRelaxMode_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xAllow using relax focus mode</CheckBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Name="AccountTab" AutomationProperties.AutomationId="tabAccount" Header="xAccount" Style="{DynamicResource TabItemStyle}">
                    <local:AccountTab x:Name="AccountTab1" />
                </TabItem>

                <TabItem Name="AITab" AutomationProperties.AutomationId="tabAI" Header="xAI" Style="{DynamicResource TabItemStyle}">
                    <local:AITab x:Name="AITAB" />
                </TabItem>

                <TabItem Name="UninstallTab" AutomationProperties.AutomationId="tabUninstall" Header="xUninstall" Style="{DynamicResource TabItemStyle}">
                    <!--<local:Uninstall x:Name="UninstallTab" />-->
                </TabItem>
            </TabControl>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"  >
            <Button  x:Name="btnExportStatistics" AutomationProperties.AutomationId="btnExportStatistics"  Margin="20,0,0,0" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"  Height="27" Width="180" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0"   FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnExportStatistics_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnExportStatisticsTXT" Text="xExport Statistics" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  x:Name="btnCheckForUpdates" AutomationProperties.AutomationId="btnCheckForUpdates" Margin="15,0,0,0"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="27" Width="180" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0"   FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCheckForUpdates_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnCheckForUpdatesTXT" Text="xCheck for Updates" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <TextBlock  Name="Version" Margin="20,4,0,0"   Text="xVersion:xx"  Foreground="Gray" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />

        </StackPanel>

    </Grid>
</Page>
