<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.FocusModeSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Border BorderThickness="1" Margin="0,0,0,0"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray" Background="{DynamicResource SoftCreamColor}">
            <StackPanel Margin="20"   >
                <TextBlock Grid.Row="0"   Name="FocusBearMode" Margin="0,10,0,0"  TextWrapping="Wrap"    Text="xFocus Bear mode:"    FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />
                <RadioButton Grid.Row="0" VerticalAlignment="Center"  Name="CuddlyMode" AutomationProperties.AutomationId="rbCuddlyMode" Margin="0,20,0,0" Padding="5,-4,0,0" GroupName="FocusBearMode"  FontSize="14" FontWeight="SemiBold" Checked="CuddlyMode_Checked">
                    xCuddly Bear mode
                </RadioButton>
                <TextBlock Grid.Row="1"   Name="CuddlyModeDesc" Margin="20,10,0,20"  TextWrapping="Wrap"    Text="xCuddly Bear mode: kind and gentle - gives you the benefit of the doubt when you open a non-allowed URL. Lets you temporarily allow blocked URLs during a focus mode."   FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />

                <RadioButton Grid.Row="2" VerticalAlignment="Center"  Name="GrizzlyMode" AutomationProperties.AutomationId="rbGrizzlyMode" Margin="0,10,0,0" Padding="5,-3,0,0" GroupName="FocusBearMode"  FontSize="14" FontWeight="SemiBold" Checked="GrizzlyMode_Checked">
                    xGrizzly Bear mode
                </RadioButton>
                <TextBlock Grid.Row="3"    Name="GrizzlyModeDesc" Margin="20,10,0,20" TextWrapping="Wrap"   Text="xGrizzly Bear mode: super strict - immediately block URLs that aren't allowed and don't let yourself allow them until the focus mode is over."   FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
