<UserControl x:Class="Focus_Bear.Preferences.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d" 
       d:DesignHeight="670" d:DesignWidth="670" IsVisibleChanged="UserControl_IsVisibleChanged" AutomationProperties.AutomationId="Settings">
    <UserControl.Resources>
 
        <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource SoftCreamColor}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource rowContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border  x:Name="IconBorder" Background="{x:Null}" CornerRadius="5" Margin="0,1" >
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#e9912c" Opacity="1" />

                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#e9912c" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,20,0" >
            <RadioButton x:Name="GeekMode" AutomationProperties.AutomationId="rbGeekMode" Content="xGeek Mode" Style="{StaticResource SegmentRadioButtonStyle}"     Cursor="Hand"    />
            <RadioButton x:Name="SimpleMode" AutomationProperties.AutomationId="rbSimpleMode" Content="xSimple Mode" Style="{StaticResource SegmentRadioButtonStyle}"   Cursor="Hand"  />
        </StackPanel>

        <Grid Grid.Row="1" >
           
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="210" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" >

                <StackPanel DockPanel.Dock="Bottom" >
                    <Button  x:Name="btnExportStatistics" AutomationProperties.AutomationId="btnExportStatistics"  Margin="0,0,0,0" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"  Height="27" Width="180" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0"   FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnExportStatistics_Click" >
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnExportStatisticsTXT" Text="xExport Statistics" Style="{DynamicResource ButtonTextBlockStyle}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button  x:Name="btnCheckForUpdates" AutomationProperties.AutomationId="btnCheckForUpdates" Margin="0,15,0,0"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="27" Width="180" HorizontalAlignment="Center"  HorizontalContentAlignment="Center" Padding="0"   FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCheckForUpdates_Click" >
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnCheckForUpdatesTXT" Text="xCheck for Updates" Style="{DynamicResource ButtonTextBlockStyle}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock  Name="Version" Margin="0,10,0,10"   Text="xVersion:xx"  Foreground="Gray" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"  />
                </StackPanel>
                <ListView  x:Name="ListLeftButtons"  AutomationProperties.AutomationId="lvLeftButtons" SelectionMode="Single" ItemContainerStyle="{StaticResource ListViewItemStyle}"  Margin="10,10,10,10" VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  BorderBrush="{x:Null}" BorderThickness="0"  Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource ForegroundColor}" SelectionChanged="ListLeftButtons_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ItemHeader" HorizontalAlignment="Left" Height="40" Width="200" Background="Transparent"  Margin="10,0,10,0" IsHitTestVisible="True" Cursor="Hand" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>
                                <!--<Rectangle Fill="{Binding color, StringFormat=\{0\}}" Width="25" Height="25"  RadiusX="4" RadiusY="4"></Rectangle>-->
                                <Image local:ImageResourceKeyBehavior.ResourceKey="{Binding IconPath}"  Margin="0,4,0,0" Height="24" Width="24" Grid.Column="0"/>
                                <TextBlock Grid.Column="1" x:Name="ListViewTextBlock" Text="{Binding Name, StringFormat=\{0\}}"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource PreferenceFocusListItemForegroundColor}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
            </DockPanel>
            <!-- Vertical line -->
            <GridSplitter Grid.Column="1" Width="1" Background="Gray" HorizontalAlignment="Stretch" ShowsPreview="False" />
            
            <Grid Grid.Column="2"   HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Background="{DynamicResource BackgroundColor}" >
                <!-- Right side dynamic content -->
                <ContentControl x:Name="RightContent"/>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
