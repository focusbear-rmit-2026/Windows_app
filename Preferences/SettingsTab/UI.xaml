<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.UI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray"  Background="{DynamicResource SoftCreamColor}">
            <Grid Margin="5"  Background="{DynamicResource SoftCreamColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="FullScreen" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxPlay habits in full screen mode</TextBlock>
                        <TextBlock x:Name="FullScreenDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xMinimize distractions by doing your habits in full screen mode...</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="FullScreenCheckbox" AutomationProperties.AutomationId="tglFullScreenCheckbox"  Style="{DynamicResource MacStyleToggleSwitch}" Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="FullScreenCheckbox_Checked" Unchecked="FullScreenCheckbox_Unchecked" />
                </Grid>

                <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Grid.Row="2" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="AutoCloseAfterSkipPostpone" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxAutomatically close window after completing, skipping or postponing a routine</TextBlock>
                        <TextBlock x:Name="AutoCloseAfterSkipPostponeDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWhen enabled, the app window will automatically close after you complete, skip or postpone a routine.</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="AutoCloseAfterSkipPostponeCheckbox" AutomationProperties.AutomationId="tglAutoCloseAfterSkipPostpone" Style="{DynamicResource MacStyleToggleSwitch}" Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="AutoCloseAfterSkipPostponeCheckbox_Checked" Unchecked="AutoCloseAfterSkipPostponeCheckbox_Unchecked" />
                </Grid>

                <Grid Grid.Row="3"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Grid.Row="4" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="SelectFont" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xApplication Font:</TextBlock>
                        <TextBlock x:Name="SelectFontDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEye-friendly option!....</TextBlock>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Name="Fonts" AutomationProperties.AutomationId="cmbFonts"  Width="200" Height="27" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0"  SelectionChanged="Fonts_SelectionChanged"></ComboBox>
                </Grid>

                <Grid Grid.Row="5" Margin="15,0,15,0" Background="LightGray"></Grid>

                <Grid Grid.Row="6" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="SelectLanguage" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxSelect Language:</TextBlock>
                        <TextBlock x:Name="SelectLanguageDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWe've translated the app into a few languages....</TextBlock>
                    </StackPanel>
                    <ComboBox  Grid.Column="1" Name="Language" AutomationProperties.AutomationId="cmbLanguage" Width="200" Height="27" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0" SelectionChanged="Language_SelectionChanged"></ComboBox>
                </Grid>

                <Grid Grid.Row="7"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Grid.Row="8" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="SelectDarkMode" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxDark Mode:</TextBlock>
                        <TextBlock x:Name="SelectDarkModeDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEye-friendly option!...</TextBlock>
                    </StackPanel>
                    <ComboBox  Grid.Column="1" Name="DarkMode" AutomationProperties.AutomationId="cmbDarkMode" Width="200" Height="27" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0" SelectionChanged="DarkMode_SelectionChanged"></ComboBox>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
