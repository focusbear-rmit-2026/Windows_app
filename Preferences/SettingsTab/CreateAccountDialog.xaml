<Window x:Class="Focus_Bear.Preferences.SettingsTab.CreateAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Focus Bear" Height="Auto" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        BorderThickness="1" BorderBrush="Gray" Topmost="True">
    <Border BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <StackPanel Orientation="Vertical" Margin="0,0,0,16">

                <Image Width="56" Height="56" Margin="0,20,0,0"
                       Source="../../Images/FBicon-64.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Fill" HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtTitle" TextWrapping="Wrap" Text="Create your account"
                           HorizontalAlignment="Center" Margin="20,10,20,0" MaxWidth="300"
                           FontWeight="Bold" FontSize="15" TextAlignment="Center"
                           Foreground="{DynamicResource ForegroundColor}"/>

                <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" FontSize="12.5"
                           Text="Enter an email and password to save your progress and settings."
                           MaxWidth="300" HorizontalAlignment="Center" Margin="20,8,20,0" TextAlignment="Center"
                           Foreground="{DynamicResource ForegroundGrey}"/>

                <TextBlock x:Name="LblEmail" Text="Email" FontSize="12.5" Margin="30,14,30,2"
                           HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                <TextBox x:Name="TxtEmail" AutomationProperties.AutomationId="txtCreateEmail"
                         Height="30" Margin="30,0,30,0" FontSize="14" HorizontalAlignment="Stretch"
                         BorderBrush="#888" BorderThickness="1" Padding="6,2"
                         Background="{DynamicResource TextBoxBackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                         VerticalContentAlignment="Center"/>

                <TextBlock x:Name="LblPassword" Text="Password" FontSize="12.5" Margin="30,12,30,2"
                           HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                <PasswordBox x:Name="TxtPassword" AutomationProperties.AutomationId="txtCreatePassword"
                             Height="30" Margin="30,0,30,0" FontSize="14" HorizontalAlignment="Stretch"
                             BorderBrush="#888" BorderThickness="1" Padding="6,2"
                             VerticalContentAlignment="Center"/>

                <TextBlock x:Name="LblConfirm" Text="Confirm password" FontSize="12.5" Margin="30,12,30,2"
                           HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                <PasswordBox x:Name="TxtConfirmPassword" AutomationProperties.AutomationId="txtCreateConfirmPassword"
                             Height="30" Margin="30,0,30,0" FontSize="14" HorizontalAlignment="Stretch"
                             BorderBrush="#888" BorderThickness="1" Padding="6,2"
                             VerticalContentAlignment="Center"/>

                <TextBlock x:Name="TxtError" TextWrapping="Wrap" FontSize="11" Foreground="Red"
                           Visibility="Collapsed" MaxWidth="300" HorizontalAlignment="Center"
                           Margin="20,8,20,0" TextAlignment="Center"/>

                <StackPanel Orientation="Vertical" Margin="0,16,0,0">
                    <Button x:Name="BtnCreate" AutomationProperties.AutomationId="btnCreateConfirm"
                            Style="{StaticResource BtnStyleLightOrangeBorderedSmall}"
                            Height="30" MinWidth="200" HorizontalAlignment="Center"
                            Margin="20,0,20,8" FontSize="14" Cursor="Hand" FontWeight="Semibold"
                            Click="BtnCreate_Click">
                        <TextBlock x:Name="BtnCreateTxt" Text="Create account" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button>
                    <Button x:Name="BtnCancel" AutomationProperties.AutomationId="btnCreateCancel"
                            Style="{StaticResource BtnStyleClearOrangeBordered}"
                            Height="30" MinWidth="200" HorizontalAlignment="Center"
                            Margin="20,0,20,0" FontSize="14" Cursor="Hand" FontWeight="Semibold"
                            Click="BtnCancel_Click">
                        <TextBlock x:Name="BtnCancelTxt" Text="Cancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
