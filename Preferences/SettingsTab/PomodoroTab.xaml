<UserControl x:Class="Focus_Bear.Preferences.PomodoroTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
             d:DesignHeight="670" d:DesignWidth="670" IsVisibleChanged="UserControl_IsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <!-- Remove default chrome -->
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- removes blue rectangle -->

            <!-- Make the button show its content -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Hand cursor on hover -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Style.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <ScrollViewer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="auto" MinHeight="50"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap" FontSize="14" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1" x:Name="LearnMore" AutomationProperties.AutomationId="txtLearnMore" Margin="20,10,20,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" TextDecorations="{x:Null}" FontSize="14" MinHeight="22" Cursor="Hand">
                    <Hyperlink x:Name="btnLearnMore" Click="btnLearnMore_Click" TextDecorations="Underline">
                        <Run x:Name="btnLearnMoreTXT" Text="Learn more about the pomodoro technique here."/>
                    </Hyperlink>    
                </TextBlock>
                <Border Grid.Row="2" BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray"  Background="{DynamicResource SoftCreamColor}">

                    <Grid Margin="5"  Background="{DynamicResource SoftCreamColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                                <TextBlock x:Name="PomodoroMode" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnter Focus session after completing morning routine</TextBlock>
                                <TextBlock x:Name="PomodoroModeDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xSupercharge your morning routine! If you activate this feature,....</TextBlock>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="EnterPomodoroCheck" AutomationProperties.AutomationId="tglEnterPomodoroCheck"  Style="{DynamicResource MacStyleToggleSwitch}" Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="EnterPomodoroCheck_Checked" Unchecked="EnterPomodoroCheck_Unchecked" />
                        </Grid>

                        <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                        <Button Grid.Row="2"  x:Name="btnAdvanced" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Style="{StaticResource TransparentButtonStyle}" Click="btnAdvanced_Click">
                            <Button.Content>
                                <Grid Margin="15,15"  Background="{DynamicResource SoftCreamColor}" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                                        <TextBlock x:Name="btnAdvancedTXT" FontSize="14" FontWeight="Normal" >xAdvanced</TextBlock>
                                        <TextBlock Name="SuperPomodoroStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray" FontSize="13" FontWeight="Normal" VerticalAlignment="Bottom"  />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="❯" FontSize="18" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                </Grid>
                            </Button.Content>
                        </Button>

                        <Grid Grid.Row="3"  Margin="15,0,15,0" Background="LightGray" ></Grid>
                        <Grid Grid.Row="4" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Name="PomodoroModeDuration" Margin="0,0,0,0" TextWrapping="Wrap" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBox x:Name="PomodoroMinutes"
                                     AutomationProperties.AutomationId="txtBoxPomodoroMinutes"
                                     Margin="20,0,0,0" 
                                     MinHeight="25"  
                                     Width="35"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="placeholder"
                                     Foreground="Gray"
                                     MaxLength="3"
                                     FontSize="16"
                                     TextAlignment="Center"
                                     ToolTip="Enter work duration in minutes (1-120)"
                                     PreviewTextInput="Minutes_PreviewTextInput" 
                                     PreviewKeyDown="Minutes_PreviewKeyDown"
                                     LostFocus="PomodoroMinutes_LostFocus">
                                    <TextBox.Effect>
                                        <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6"/>
                                    </TextBox.Effect>
                                </TextBox>

                                <TextBlock Name="MinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

                                <Button Content="Save"
                                        AutomationProperties.AutomationId="btnSavePomodoroMinutes"
                                        Width="80"
                                        Height="30"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        Style="{StaticResource BtnStyleLightOrange}" 
                                        Click="SaveSettings_Click"/>
                            </StackPanel>

                        </Grid>
                        <Grid Grid.Row="5"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                        <Grid Grid.Row="6" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Name="BreakDuration" Margin="0,0,0,0" TextWrapping="Wrap" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBox x:Name="BreakMinutes"
                                     AutomationProperties.AutomationId="txtBoxBreakMinutes"
                                     Margin="20,0,0,0"
                                     MinHeight="25"
                                     Width="35"
                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                     Tag="placeholder"
                                     Foreground="Gray"
                                     MaxLength="3"
                                     FontSize="16"
                                     TextAlignment="Center"
                                     ToolTip="Enter break duration in minutes (1-60)"
                                     PreviewTextInput="Minutes_PreviewTextInput" 
                                     PreviewKeyDown="Minutes_PreviewKeyDown"
                                     LostFocus="BreakMinutes_LostFocus">
                                    <TextBox.Effect>
                                        <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6"/>
                                    </TextBox.Effect>
                                </TextBox>

                                <TextBlock Name="BreakMinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

                                <Button Content="Save"
                                        AutomationProperties.AutomationId="btnSaveBreakMinutes"
                                        Width="80"
                                        Height="30"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        Style="{StaticResource BtnStyleLightOrange}" 
                                        Click="SaveSettings_Click"/>        
                            </StackPanel>

                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>