<Window x:Class="Focus_Bear.Preferences.SettingsTab.DeleteAccountConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Focus Bear" Height="Auto" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        BorderThickness="1" BorderBrush="Gray" Topmost="True">
    <Border BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Width="60" Height="60" Margin="0"
                   Source="../../Images/FBicon-64.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="1" x:Name="TxtTitle" TextWrapping="Wrap"
                       Text="Confirm Account Deletion"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="20,10,20,0" MaxWidth="280"
                       FontWeight="Bold" TextAlignment="Center"/>

            <TextBlock Grid.Row="2" x:Name="TxtPrompt" TextWrapping="Wrap"
                       FontSize="13" Text="Type DELETE to confirm"
                       MaxWidth="280" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="20,12,20,0" TextAlignment="Center"/>

            <TextBox Grid.Row="3" x:Name="TxtInput"
                     AutomationProperties.AutomationId="txtDeleteConfirm"
                     Width="200" Height="30" Margin="20,10,20,0"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="14" BorderBrush="#000" BorderThickness="1"
                     Padding="5,2,5,2" TextAlignment="Center"
                     TextChanged="TxtInput_TextChanged"/>

            <TextBlock Grid.Row="4" x:Name="TxtError" TextWrapping="Wrap"
                       FontSize="11" Foreground="Red" Visibility="Collapsed"
                       MaxWidth="280" HorizontalAlignment="Center"
                       Margin="20,4,20,0" TextAlignment="Center"
                       Text="Please type DELETE (in capitals) to confirm."/>

            <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,16,0,16">
                <Button x:Name="BtnConfirm" AutomationProperties.AutomationId="btnDeleteConfirm"
                        Style="{StaticResource BtnStyleLightOrangeBorderedSmall}"
                        IsEnabled="False" Height="30" MinWidth="200"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="20,0,20,8" FontSize="14" Cursor="Hand" FontWeight="Semibold"
                        Click="BtnConfirm_Click">
                    <Button.Content>
                        <TextBlock x:Name="BtnConfirmTxt" Text="Delete Account"
                                   Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button.Content>
                </Button>
                <Button x:Name="BtnCancel" AutomationProperties.AutomationId="btnDeleteCancel"
                        Style="{StaticResource BtnStyleClearOrangeBordered}"
                        Height="30" MinWidth="200"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="20,0,20,0" FontSize="14" Cursor="Hand" FontWeight="Semibold"
                        Click="BtnCancel_Click">
                    <Button.Content>
                        <TextBlock x:Name="BtnCancelTxt" Text="Cancel"
                                   Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
