<UserControl x:Class="Focus_Bear.Preferences.AITab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="640" MinHeight="300" MinWidth="540"  Background="#fff" IsVisibleChanged="UserControl_IsVisibleChanged" AutomationProperties.AutomationId="AITab">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>


        <Border BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray"  Background="{DynamicResource SoftCreamColor}">
            <Grid Margin="5"  Background="{DynamicResource SoftCreamColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="15,15"  Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="PersonalisedMotivationCheckBoxTXT" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxUse AI to generate a personalised motivational message each morning</TextBlock>
                        <TextBlock x:Name="PersonalisedMotivationCheckBoxDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xxYour routine streak and your morning routine activities will be sent to Open AI. No other details will be shared but if you have anything in the habit titles that would identify you, we recommend you remove it..</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="PersonalisedMotivationCheckBox" AutomationProperties.AutomationId="tglPersonalisedMotivationCheckBox"  Style="{DynamicResource MacStyleToggleSwitch}" Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="PersonalisedMotivationCheckBox_Checked" Unchecked="PersonalisedMotivationCheckBox_Unchecked" />
                </Grid>
                <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="2" Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="UseAIToDecideTXT" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xUse AI to decide if websites should be allowed</TextBlock>
                        <TextBlock x:Name="UseAIToDecideDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWe'll use Open AI to decide if the site is valid based on your current focus mode, intention, the URL, the website title and the first 100 characters of the content. This is anonymous - no identifying details are shared...</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="UseAIToDecideCheckBox" AutomationProperties.AutomationId="tglUseAIToDecideCheckBox" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="UseAIToDecide_Checked" Unchecked="UseAIToDecide_Unchecked"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
