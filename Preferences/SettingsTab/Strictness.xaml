<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.Strictness"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <!-- Main menu -->
        <Grid x:Name="MainMenuPanel" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xStrictness" FontSize="13" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
            <Grid Grid.Row="1" ></Grid>

            <Border  Grid.Row="2" CornerRadius="8" ClipToBounds="True" Background="#F4F5F5"  BorderBrush="LightGray" BorderThickness="1" >
                <StackPanel Orientation="Vertical" >
                    
                    <Button x:Name="btnPassword"  AutomationProperties.AutomationId="btnPassword" Margin="2,2,2,0" Style="{StaticResource  BtnMacStyleSettingsGray}" IsEnabled="True" Height="45"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"  FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnPassword_Click">
                        <Button.Content>
                            <Grid  Background="{x:Null}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{DynamicResource Password}" Margin="10,4,0,0" Height="24" Width="24" Grid.Column="0"/>
                                <TextBlock Name="btnPasswordText" Margin="8,0,0,0" Text="xPassword" Foreground="Black" VerticalAlignment="Center" Grid.Column="1"/>
                                <TextBlock Text="❯" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Foreground="#333" Grid.Column="2" Margin="0,0,10,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Grid Background="LightGray" Height="1" Margin="10,1,10,0"></Grid>
                    <Button x:Name="btnFocusMode"  AutomationProperties.AutomationId="btnFocusMode" Margin="2,2,2,0" Style="{StaticResource  BtnMacStyleSettingsGray}" IsEnabled="True" Height="45"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"  FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnFocusMode_Click">
                        <Button.Content>
                            <Grid  Background="{x:Null}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{DynamicResource FocusModeDark}" Margin="10,4,0,0" Height="24" Width="24" Grid.Column="0"/>
                                <TextBlock Name="btnFocusModeText" Margin="8,0,0,0" Text="xFocus Mode" Foreground="Black" VerticalAlignment="Center" Grid.Column="1"/>
                                <TextBlock Text="❯" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Foreground="#333" Grid.Column="2" Margin="0,0,10,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Grid Background="LightGray" Height="1" Margin="10,1,10,0"></Grid>
                    <Button x:Name="btnDistractingSites"  AutomationProperties.AutomationId="btnDistractingSites" Margin="2,2,2,0" Style="{StaticResource  BtnMacStyleSettingsGray}" IsEnabled="True" Height="45"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"  FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnDistractingSites_Click">
                        <Button.Content>
                            <Grid  Background="{x:Null}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{DynamicResource GlobeImage}" Margin="10,4,0,0" Height="24" Width="24" Grid.Column="0"/>
                                <TextBlock Name="btnDistractingSitesText" Margin="8,0,0,0" Text="xSuper Distracting Sites" Foreground="Black" VerticalAlignment="Center" Grid.Column="1"/>
                                <TextBlock Text="❯" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Foreground="#333" Grid.Column="2" Margin="0,0,10,0"/>
                            </Grid>
                        </Button.Content>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Dynamic content for subviews -->
        <Grid x:Name="SubViewContainer" Visibility="Collapsed" Grid.Row="2" >

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Back button row -->
                <RowDefinition Height="*"/>
                <!-- Subview fills remaining space -->
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                <Button x:Name="btnBack"  AutomationProperties.AutomationId="btnBack" Width="25" Height="25" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"  HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" Margin="20,5,0,0" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnBack_Click"  >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock x:Name="btnbtnBackTXT" Text="❮" FontSize="13" Style="{DynamicResource ButtonTextBlockStyle}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <TextBlock  Grid.Row="0"  Name="SubViewHeading" Margin="10,6,0,0" TextWrapping="Wrap" Text="xBlocking Schedule" FontSize="15" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
            </StackPanel>

            <ContentControl Grid.Row="1" x:Name="ContentArea" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>


    </Grid>
</UserControl>
