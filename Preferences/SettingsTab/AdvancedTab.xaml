<UserControl x:Class="Focus_Bear.Preferences.AdvancedTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
              d:DesignHeight="670" d:DesignWidth="670" Background="#fff" IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray" Background="{DynamicResource SoftCreamColor}">
            <ScrollViewer>
            <Grid Margin="5" Background="{DynamicResource SoftCreamColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
                    <Grid Margin="15,15" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="EnableMeetingDetection" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection</TextBlock>
                    <TextBlock x:Name="EnableMeetingDetectionDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection to automatically suggest starting \"Meetings\" focus mode when Focus Bear detects you are in a call.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableMeetingDetection" AutomationProperties.AutomationId="tglEnableMeetingDetection"  Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableMeetingDetection_Checked" Unchecked="btnEnableMeetingDetection_Unchecked" />

            </Grid>

            <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="2" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="SuggestStartMeetings" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAutomatically suggest starting \"Meetings\" focus mode</TextBlock>
                    <TextBlock x:Name="SuggestStartMeetingsDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWhen you start a video call, Focus Bear can prompt you to start the Meeting focus mode to help you stay focused during the meeting.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnSuggestStartMeetingsFocus" AutomationProperties.AutomationId="tglSuggestStartMeetingsFocus" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnSuggestStartMeetingsFocus_Checked" Unchecked="btnSuggestStartMeetingsFocus_Unchecked" />
            </Grid>

            <Grid Grid.Row="3"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="4" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="BlockSuperDistracting" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xBlock \"Super Distracting Sites\" during Meetings</TextBlock>
                    <TextBlock x:Name="BlockSuperDistractingDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAvoid awkward screensharing moments. Turn this setting off if you don’t want blocking to happen while you’re in meetings.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnBlockSuperDistracting" AutomationProperties.AutomationId="tglBlockSuperDistracting" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnBlockSuperDistracting_Checked" Unchecked="btnBlockSuperDistracting_Unchecked"/>
            </Grid>

                <Grid Grid.Row="5"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="6" Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="EnableFBTT" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable Focus Bear Time Tracker</TextBlock>
                        <TextBlock x:Name="EnableFBTTDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAnalyse your productivity by tracking how much time you spend on different websites and apps. You can automatically categorise time logs into different projects (helpful for timesheets). Data is stored locally for privacy reasons.</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableFBTT" AutomationProperties.AutomationId="tglEnableFBTT" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableFBTT_Checked" Unchecked="btnEnableFBTT_Unchecked"/>
                </Grid>

                <Grid Grid.Row="7" Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="8" Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock x:Name="TabLimitLabel" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xMax tab limit:</TextBlock>
                        <TextBlock x:Name="TabLimitDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xSet the maximum number of browser tabs you want open at once. Focus Bear will alert you when you exceed this limit. Set to 0 to disable.</TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Spinner: TextBox + ▲▼ RepeatButtons, same pattern as HourControl -->
                        <Border BorderBrush="#FF545454" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="14"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="txtMaxTabLimit" AutomationProperties.AutomationId="txtMaxTabLimit"
                                         Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                         FontSize="14" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center" BorderThickness="0"
                                         MaxLength="3" PreviewTextInput="txtMaxTabLimit_PreviewTextInput"
                                         TextChanged="txtMaxTabLimit_TextChanged"
                                         LostFocus="txtMaxTabLimit_LostFocus"/>
                                <RepeatButton x:Name="btnTabLimitUp" AutomationProperties.AutomationId="btnTabLimitUp"
                                              Grid.Column="1" Grid.Row="0"
                                              FontSize="8" FontFamily="Marlett"
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              BorderBrush="#FF545454" Background="#FF989898"
                                              Click="btnTabLimitUp_Click">5</RepeatButton>
                                <RepeatButton x:Name="btnTabLimitDown" AutomationProperties.AutomationId="btnTabLimitDown"
                                              Grid.Column="1" Grid.Row="1"
                                              FontSize="8" FontFamily="Marlett"
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              BorderBrush="#FF545454" Background="#FF989898"
                                              Click="btnTabLimitDown_Click">6</RepeatButton>
                            </Grid>
                        </Border>
                        <Button x:Name="btnSaveTabLimit" AutomationProperties.AutomationId="btnSaveTabLimit"
                                Style="{StaticResource BtnStyleLightOrange}"
                                Width="80" Height="30" FontSize="12" Cursor="Hand" FontWeight="Semibold"
                                Click="btnSaveTabLimit_Click">
                            <TextBlock x:Name="btnSaveTabLimitText" Text="xSave" Foreground="Black"/>
                        </Button>
                    </StackPanel>
                </Grid>
            
            </Grid>
            </ScrollViewer>
        </Border>

        


    </Grid>
</UserControl>
