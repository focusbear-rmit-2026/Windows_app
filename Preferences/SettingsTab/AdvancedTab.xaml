<UserControl x:Class="Focus_Bear.Preferences.AdvancedTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             mc:Ignorable="d" 
              d:DesignHeight="670" d:DesignWidth="670" Background="#fff" IsVisibleChanged="UserControl_IsVisibleChanged" AutomationProperties.AutomationId="AdvancedTab">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" Margin="20"   VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray" Background="{DynamicResource SoftCreamColor}">
            <ScrollViewer>
            <Grid Margin="5" Background="{DynamicResource SoftCreamColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
                    <Grid Margin="15,15" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="EnableMeetingDetection" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection</TextBlock>
                    <TextBlock x:Name="EnableMeetingDetectionDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable meeting detection to automatically suggest starting \"Meetings\" focus mode when Focus Bear detects you are in a call.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableMeetingDetection" AutomationProperties.AutomationId="tglEnableMeetingDetection" AutomationProperties.LabeledBy="{Binding ElementName=EnableMeetingDetection}"  Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableMeetingDetection_Checked" Unchecked="btnEnableMeetingDetection_Unchecked" />

            </Grid>

            <Grid Grid.Row="1"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="2" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="SuggestStartMeetings" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAutomatically suggest starting \"Meetings\" focus mode</TextBlock>
                    <TextBlock x:Name="SuggestStartMeetingsDesc" Margin="0,10,0,0"  TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xWhen you start a video call, Focus Bear can prompt you to start the Meeting focus mode to help you stay focused during the meeting.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnSuggestStartMeetingsFocus" AutomationProperties.AutomationId="tglSuggestStartMeetingsFocus" AutomationProperties.LabeledBy="{Binding ElementName=SuggestStartMeetings}" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnSuggestStartMeetingsFocus_Checked" Unchecked="btnSuggestStartMeetingsFocus_Unchecked" />
            </Grid>

            <Grid Grid.Row="3"  Margin="15,0,15,0" Background="LightGray" ></Grid>

            <Grid Margin="15,15" Grid.Row="4" Background="{DynamicResource SoftCreamColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                    <TextBlock x:Name="BlockSuperDistracting" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xBlock \"Super Distracting Sites\" during Meetings</TextBlock>
                    <TextBlock x:Name="BlockSuperDistractingDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAvoid awkward screensharing moments. Turn this setting off if you don’t want blocking to happen while you’re in meetings.</TextBlock>
                </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnBlockSuperDistracting" AutomationProperties.AutomationId="tglBlockSuperDistracting" AutomationProperties.LabeledBy="{Binding ElementName=BlockSuperDistracting}" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnBlockSuperDistracting_Checked" Unchecked="btnBlockSuperDistracting_Unchecked"/>
            </Grid>

                <Grid Grid.Row="5"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                <Grid Margin="15,15" Grid.Row="6" Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                        <TextBlock x:Name="EnableFBTT" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable Focus Bear Time Tracker</TextBlock>
                        <TextBlock x:Name="EnableFBTTDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xAnalyse your productivity by tracking how much time you spend on different websites and apps. You can automatically categorise time logs into different projects (helpful for timesheets). Data is stored locally for privacy reasons.</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableFBTT" AutomationProperties.AutomationId="tglEnableFBTT" AutomationProperties.LabeledBy="{Binding ElementName=EnableFBTT}" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableFBTT_Checked" Unchecked="btnEnableFBTT_Unchecked"/>
                </Grid>

                <!-- Browser tab limiter moved to Strictness > Browser tab limiter (matches macOS) -->

                    <Grid Grid.Row="9"  Margin="15,0,15,0" Background="LightGray" ></Grid>

                    <Grid Margin="15,15" Grid.Row="10" Background="{DynamicResource SoftCreamColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"  Orientation="Vertical"  >
                            <TextBlock x:Name="EnableAdvancedAnalytics" FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xEnable advanced analytics while using focus mode</TextBlock>
                            <TextBlock x:Name="EnableAdvancedAnalyticsDesc" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" HorizontalAlignment="Left" TextAlignment="Left">xTrack the exact time you spend on each app and browser tab during focus mode. Gain deeper insights into your productivity by understanding how your attention is distributed.</TextBlock>
                            <TextBlock x:Name="EnableAdvancedAnalyticsDesc2" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left">xData is only stored on your computer and not sent to our servers.</TextBlock>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="btnEnableAdvancedAnalytics" AutomationProperties.AutomationId="tglbtnEnableAdvancedAnalytics" AutomationProperties.LabeledBy="{Binding ElementName=EnableAdvancedAnalytics}" Style="{DynamicResource MacStyleToggleSwitch}"      Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableAdvancedAnalytics_Checked" Unchecked="btnEnableAdvancedAnalytics_Unchecked"/>
                    </Grid>
                
                </Grid>
            </ScrollViewer>
        </Border>

        


    </Grid>
</UserControl>
