<UserControl x:Class="Focus_Bear.Preferences.AccountTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d"
      d:DesignHeight="670" d:DesignWidth="670" IsVisibleChanged="UserControl_IsVisibleChanged"
       AutomationProperties.AutomationId="AccountTab">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="28,20,28,20">

                <!-- ===== Your Account Information ===== -->
                <TextBlock Name="Heading" Text="xYour Account Information" Foreground="#e88800"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                <Grid Height="1" Background="{DynamicResource TrayCardBorder}" Margin="0,0,0,14"/>

                <!-- label / value rows -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="LblLeaderboard" Text="xLeaderboard Username" FontSize="14"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Name="LblLeaderboardValue" Text="xNot set" FontSize="14"
                               Foreground="{DynamicResource ForegroundGrey}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="LblEmail" Text="xEmail Id" FontSize="14"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="LblEmailValue" Text="xFocusBear Mail" FontSize="14"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <!-- Email-not-verified banner (registered users only) — aligned with the email value column -->
                <Border x:Name="BannerEmailUnverified" Visibility="Collapsed" Margin="150,6,0,6" HorizontalAlignment="Left"
                        CornerRadius="8" BorderBrush="#e8a000" BorderThickness="1.5"
                        Background="{DynamicResource TrayCardBg}" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="LblEmailNotVerified" Text="xEmail not Verified" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Cursor="Hand">
                            <Hyperlink x:Name="btnResendConfirm" AutomationProperties.AutomationId="btnResendConfirm"
                                       Click="btnResendConfirm_Click" Foreground="#e88800" TextDecorations="Underline">
                                <Run x:Name="btnResendConfirmTXT" Text="xResend Confirmation Email"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Guest account banner (anonymous users only) -->
                <Border x:Name="BannerGuest" Visibility="Collapsed" Margin="0,6,0,6"
                        CornerRadius="8" BorderBrush="#e8a000" BorderThickness="1.5"
                        Background="{DynamicResource TrayCardBg}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F43B;" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock x:Name="LblGuestTitle" Text="xYou're using a guest account" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="LblGuestDesc" Text="xCreate an account to save your progress and settings, and keep them if you change or reinstall on another device."
                                       FontSize="12.5" Foreground="{DynamicResource ForegroundGrey}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="btnCreateAccount" AutomationProperties.AutomationId="btnCreateAccount"
                                Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Height="30" MinWidth="120"
                                VerticalAlignment="Center" Margin="12,0,0,0" Padding="10,0" FontSize="13" Cursor="Hand"
                                FontWeight="Semibold" Click="btnCreateAccount_Click">
                            <TextBlock x:Name="btnCreateAccountTXT" Text="xCreate account" Style="{DynamicResource ButtonTextBlockStyle}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Margin="0,6,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="LblUserId" Text="xUser Id" FontSize="14"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Name="LblUserIdValue" IsReadOnly="True" Text="xuser id" FontSize="14" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                        <Button x:Name="btnCopyUserId" AutomationProperties.AutomationId="btnCopyUserId" Margin="8,0,0,0"
                                Width="22" Height="22" Padding="0" Cursor="Hand" VerticalAlignment="Center"
                                BorderBrush="#eee" Background="#eee" Click="btnCopyUserId_Click" ToolTip="xCopy">
                            <Image Height="20" Width="20" Source="../../Images/copy.png" Stretch="Fill"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Account action buttons — aligned with the value column (where Email / User Id start) -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="150,0,0,8">
                    <Button x:Name="btnResetPassword" AutomationProperties.AutomationId="btnResetPassword"
                            Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Height="30" Width="200"
                            HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,10" FontSize="13" Cursor="Hand"
                            FontWeight="Semibold" Click="btnResetPassword_Click">
                        <TextBlock x:Name="btnResetPasswordTXT" Text="xReset Password" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button>
                    <Button x:Name="btnLogout" AutomationProperties.AutomationId="btnLogout"
                            Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Height="30" Width="200"
                            HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,10" FontSize="13" Cursor="Hand"
                            FontWeight="Semibold" Click="btnLogout_Click">
                        <TextBlock x:Name="btnLogoutTXT" Text="xLogout" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button>
                    <Button x:Name="btnDeleteAccount" AutomationProperties.AutomationId="btnDeleteAccount"
                            Style="{StaticResource BtnStyleClearOrangeBordered}" Height="30" Width="200"
                            HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="13" Cursor="Hand"
                            FontWeight="Semibold" Click="btnDeleteAccount_Click">
                        <TextBlock x:Name="btnDeleteAccountTXT" Text="xDelete Account" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </Button>
                </StackPanel>

                <!-- ===== Subscription Details ===== -->
                <TextBlock Name="SubscriptionHeading" Text="xSubscription Details" Foreground="#e88800"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,18,0,4"/>
                <Grid Height="1" Background="{DynamicResource TrayCardBorder}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Name="LblStatusLabel" Text="xStatus:" FontSize="14"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Name="LblTrialInfo" Text="xTrial Version:" FontSize="14"
                                   Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap"/>
                        <TextBlock Name="LblPurchase" Text="xIf you've already purchased Focus Bear subscription, you can restore that purchase."
                                   FontSize="13" Foreground="{DynamicResource ForegroundGrey}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="btnSyncPayment" AutomationProperties.AutomationId="btnSyncPayment"
                        Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Height="30" Width="200"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center" Padding="0" Margin="150,10,0,10"
                        FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnSyncPayment_Click">
                    <TextBlock x:Name="btnSyncPaymentTXT" Text="xSync Payment Status" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </Button>
                <ProgressBar x:Name="ProgressSync" Height="15" Width="200" IsIndeterminate="True" HorizontalAlignment="Left"
                             Margin="150,0,0,0" Foreground="DodgerBlue" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
