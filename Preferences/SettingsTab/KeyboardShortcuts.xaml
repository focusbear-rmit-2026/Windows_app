<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.KeyboardShortcuts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" AutomationProperties.AutomationId="KeyboardShortcuts"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- A blue-bordered click-to-record box (mirrors the macOS recorder). Theme-aware background so
                     the value text stays readable in both light and dark mode. -->
                <Style x:Key="RecorderBox" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BackgroundColor}"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="MinWidth" Value="200"/>
                    <Setter Property="MinHeight" Value="34"/>
                    <Setter Property="Padding" Value="10,4,6,4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                </Style>

                <!-- Icon button: on hover only a soft rounded square appears (matches the Back / cog buttons),
                     not the default square button chrome. -->
                <Style x:Key="IconHoverButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="hoverBg" CornerRadius="6" Background="Transparent" Padding="5,2,5,2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="hoverBg" Property="Background" Value="#33808080"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" Margin="20" VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray" Background="{DynamicResource SoftCreamColor}">
            <StackPanel Margin="24,20,24,24" Background="Transparent">
                <TextBlock x:Name="Header" Text="Keyboard Shortcuts" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"/>
                <TextBlock x:Name="Description" Margin="0,8,0,18" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource ForegroundGrey}"
                           Text="Set global keyboard shortcuts to instantly open Brain Dump, Focus Music, or Task List from anywhere on your PC."/>

                <!-- Brain Dump -->
                <Grid Margin="0,6,0,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblBrainDump" Grid.Column="0" Text="Open Brain Dump:" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForegroundColor}"/>
                    <Border x:Name="BoxBrainDump" Grid.Column="1" Tag="brainDump" Style="{StaticResource RecorderBox}"
                            MouseLeftButtonDown="Recorder_Click" PreviewKeyDown="Recorder_KeyDown" LostFocus="Recorder_LostFocus">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValBrainDump" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                            <Button x:Name="ClearBrainDump" Grid.Column="1" Tag="brainDump" Content="✕" FontSize="12" Foreground="{DynamicResource ForegroundGrey}" Style="{StaticResource IconHoverButton}" Click="Clear_Click" ToolTip="Clear shortcut" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Focus Music -->
                <Grid Margin="0,6,0,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblFocusMusic" Grid.Column="0" Text="Open Focus Music:" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForegroundColor}"/>
                    <Border x:Name="BoxFocusMusic" Grid.Column="1" Tag="focusMusic" Style="{StaticResource RecorderBox}"
                            MouseLeftButtonDown="Recorder_Click" PreviewKeyDown="Recorder_KeyDown" LostFocus="Recorder_LostFocus">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValFocusMusic" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                            <Button x:Name="ClearFocusMusic" Grid.Column="1" Tag="focusMusic" Content="✕" FontSize="12" Foreground="{DynamicResource ForegroundGrey}" Style="{StaticResource IconHoverButton}" Click="Clear_Click" ToolTip="Clear shortcut" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Task List -->
                <Grid Margin="0,6,0,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblTaskList" Grid.Column="0" Text="Open Task List:" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForegroundColor}"/>
                    <Border x:Name="BoxTaskList" Grid.Column="1" Tag="taskList" Style="{StaticResource RecorderBox}"
                            MouseLeftButtonDown="Recorder_Click" PreviewKeyDown="Recorder_KeyDown" LostFocus="Recorder_LostFocus">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValTaskList" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                            <Button x:Name="ClearTaskList" Grid.Column="1" Tag="taskList" Content="✕" FontSize="12" Foreground="{DynamicResource ForegroundGrey}" Style="{StaticResource IconHoverButton}" Click="Clear_Click" ToolTip="Clear shortcut" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Start Focus Session -->
                <Grid Margin="0,6,0,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblFocusSession" Grid.Column="0" Text="Start focus session:" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ForegroundColor}"/>
                    <Border x:Name="BoxFocusSession" Grid.Column="1" Tag="focusSession" Style="{StaticResource RecorderBox}"
                            MouseLeftButtonDown="Recorder_Click" PreviewKeyDown="Recorder_KeyDown" LostFocus="Recorder_LostFocus">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ValFocusSession" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                            <Button x:Name="ClearFocusSession" Grid.Column="1" Tag="focusSession" Content="✕" FontSize="12" Foreground="{DynamicResource ForegroundGrey}" Style="{StaticResource IconHoverButton}" Click="Clear_Click" ToolTip="Clear shortcut" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="HintText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundGrey}"
                           Text="Click a box and press a key combination (include Ctrl, Alt, Shift or ⊞ Win). Press Esc to cancel."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
