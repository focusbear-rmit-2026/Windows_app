<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.TabLimiterSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="560" AutomationProperties.AutomationId="TabLimiterSetting">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Border BorderThickness="1" VerticalAlignment="Top" CornerRadius="10" BorderBrush="LightGray" Background="{DynamicResource SoftCreamColor}">
            <StackPanel Margin="15" Background="{DynamicResource SoftCreamColor}">

                <!-- Enable / disable the tab limiter -->
                <Grid Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock x:Name="EnableLabel" FontSize="14" FontWeight="Normal" TextWrapping="Wrap" Foreground="{DynamicResource ForegroundColor}" HorizontalAlignment="Left" TextAlignment="Left">xPrevent user from opening more browser tabs</TextBlock>
                        <TextBlock x:Name="SubTitle" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource ForegroundColor}" HorizontalAlignment="Left" TextAlignment="Left">xWorks only during active Focus Sessions or active Blocking Schedules.</TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="btnEnableTabLimiter" AutomationProperties.AutomationId="tglEnableTabLimiter" AutomationProperties.LabeledBy="{Binding ElementName=EnableLabel}" Style="{DynamicResource MacStyleToggleSwitch}" Margin="15,0,0,0" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Cursor="Hand" Focusable="True" Checked="btnEnableTabLimiter_Checked" Unchecked="btnEnableTabLimiter_Unchecked"/>
                </Grid>

                <Grid Margin="0,15,0,0" Background="LightGray" Height="1"/>

                <!-- Tab count (only meaningful when enabled; the count can never be 0) -->
                <Grid x:Name="CountRow" Margin="0,15,0,0" Background="{DynamicResource SoftCreamColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="TabLimitLabel" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource ForegroundColor}" HorizontalAlignment="Left" TextAlignment="Left">xMax tab limit:</TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Spinner: TextBox + up/down RepeatButtons (Marlett glyphs 5=up, 6=down) -->
                        <Border BorderBrush="#FF545454" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="14"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="txtMaxTabLimit" AutomationProperties.AutomationId="txtMaxTabLimit"
                                         Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                         FontSize="14" VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center" BorderThickness="0"
                                         Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource ForegroundColor}"
                                         MaxLength="3" PreviewTextInput="txtMaxTabLimit_PreviewTextInput"
                                         TextChanged="txtMaxTabLimit_TextChanged"
                                         LostFocus="txtMaxTabLimit_LostFocus"/>
                                <RepeatButton x:Name="btnTabLimitUp" AutomationProperties.AutomationId="btnTabLimitUp"
                                              Grid.Column="1" Grid.Row="0"
                                              FontSize="8" FontFamily="Marlett"
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              BorderBrush="#FF545454" Background="#FF989898"
                                              Click="btnTabLimitUp_Click">5</RepeatButton>
                                <RepeatButton x:Name="btnTabLimitDown" AutomationProperties.AutomationId="btnTabLimitDown"
                                              Grid.Column="1" Grid.Row="1"
                                              FontSize="8" FontFamily="Marlett"
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              BorderBrush="#FF545454" Background="#FF989898"
                                              Click="btnTabLimitDown_Click">6</RepeatButton>
                            </Grid>
                        </Border>
                        <Button x:Name="btnSaveTabLimit" AutomationProperties.AutomationId="btnSaveTabLimit"
                                Style="{StaticResource BtnStyleLightOrange}"
                                Width="80" Height="30" FontSize="12" Cursor="Hand" FontWeight="Semibold"
                                Click="btnSaveTabLimit_Click">
                            <TextBlock x:Name="btnSaveTabLimitText" Text="xSave" Foreground="Black"/>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
