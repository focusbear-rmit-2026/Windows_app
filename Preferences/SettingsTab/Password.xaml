<UserControl x:Class="Focus_Bear.Preferences.SettingsTab.Password"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences.SettingsTab"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <ScrollViewer>
            <Grid HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"   Name="PasswordHeading" Margin="0,0,0,0"  TextWrapping="NoWrap"    Text="xSet Password"   FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"  />
                <TextBlock Grid.Row="1"   Name="PasswordDesc" Margin="20,0,20,0"  TextWrapping="Wrap"       FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock  Grid.Row="2"  Width="300"  Name="lblPassword" Margin="0,15,0,0" TextWrapping="NoWrap" Text="xNew Password:"  FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                <Grid  Grid.Row="3" Width="300" VerticalAlignment="Center">

                    <PasswordBox Width="230" TabIndex="2" x:Name="TxtPassword" AutomationProperties.AutomationId="txtBoxPassword" Margin="0"    BorderBrush="#000"  Padding="5,2,5,5" BorderThickness="1" FontSize="14"  PasswordChanged="TxtPassword_PasswordChanged" Background="White"   >
                        <PasswordBox.Effect>
                            <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6" />
                        </PasswordBox.Effect>
                        <PasswordBox.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </PasswordBox.FocusVisualStyle>
                    </PasswordBox>

                </Grid>

                <TextBlock Grid.Row="4" Width="300" Name="lblConfirmPassword" Margin="0,15,0,0" TextWrapping="Wrap" Text="xConfirm Password:" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                <Grid Grid.Row="5" Width="300" VerticalAlignment="Center">
                    <PasswordBox Width="230" TabIndex="3" x:Name="TxtConfirmPassword" AutomationProperties.AutomationId="txtBoxConfirmPassword" Margin="0" BorderBrush="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="14" PasswordChanged="TxtConfirmPassword_PasswordChanged" Background="White">
                        <PasswordBox.Effect>
                            <DropShadowEffect ShadowDepth="3" Direction="330" Color="Gray" Opacity="0.5" BlurRadius="6"/>
                        </PasswordBox.Effect>
                        <PasswordBox.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </PasswordBox.FocusVisualStyle>
                    </PasswordBox>
                </Grid>

                <!-- Password Mismatch Error Message -->
                <TextBlock Grid.Row="5" x:Name="MessageDisplay"
                   Margin="0,38,0,17"  
                   FontSize="12" 
                   TextAlignment="Center"
                   Text="Passwords do not match!" 
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" Width="180" Grid.RowSpan="2"/>

                <!-- Set Password Button (moved to Row 7) -->
                <Button Grid.Row="6" x:Name="btnSetPassword" AutomationProperties.AutomationId="btnSetPassword" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" MinHeight="27" Width="180" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSetPassword_Click" Grid.RowSpan="2" Margin="0,17,0,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="btnSetPasswordTXT" Text="xSet Password" Style="{DynamicResource ButtonTextBlockStyle}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Disable Password Link (moved to Row 8) -->
                <TextBlock Grid.Row="7" x:Name="DisablePassword" AutomationProperties.AutomationId="txtDisablePassword" Margin="0,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center" TextDecorations="{x:Null}" FontSize="14" MinHeight="22" Cursor="Hand" Grid.RowSpan="2">
                    <Hyperlink x:Name="btnDisablePassword" Click="btnDisablePassword_Click" TextDecorations="Underline">
                        <Run x:Name="btnDisablePasswordTXT" Text="xDisable Password"/>
                    </Hyperlink>
                </TextBlock>


                <Grid Grid.Row="8" Margin="0,0,0,0" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="185"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"   Name="AskForPassword" Margin="0,0,0,0"  TextWrapping="Wrap"    Text="xAsk for password"   FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right"  />

                    </Grid>
                    <Grid Grid.Column="1" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"   Name="WhenRequire" Margin="20,0,0,0"  TextWrapping="Wrap"    Text="xWhen do you want to require a password?"   FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />
                        <StackPanel  Grid.Row="2"  Orientation="Vertical"   Margin="20,0,0,0" Grid.RowSpan="2" HorizontalAlignment="Left">
                            <CheckBox Margin="0,10,0,10" x:Name="CheckChangingSettings" AutomationProperties.AutomationId="chkChangingSettings" FontSize="14" Checked="CheckChangingSettings_Checked" Unchecked="CheckChangingSettings_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xChanging Settings</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckPostponingMorningRoutine" AutomationProperties.AutomationId="chkPostponingMorningRoutine" FontSize="14" Checked="CheckPostponingMorningRoutine_Checked"  Unchecked="CheckPostponingMorningRoutine_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/skipping morning routine</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckPostponingEveningRoutine" AutomationProperties.AutomationId="chkPostponingEveningRoutine" FontSize="14" Checked="CheckPostponingEveningRoutine_Checked"  Unchecked="CheckPostponingEveningRoutine_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/skipping evening routine</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckSkipEveningAfterCutOff" AutomationProperties.AutomationId="chkSkipEveningAfterCutOff" FontSize="14" Checked="CheckSkipEveningAfterCutOff_Checked" Unchecked="CheckSkipEveningAfterCutOff_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xPostponing/Skipping evening routine after cutoff time</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckUsingComputerLateNight" AutomationProperties.AutomationId="chkUsingComputerLateNight" FontSize="14" Checked="CheckUsingComputerLateNight_Checked"  Unchecked="CheckUsingComputerLateNight_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xUsing your computer late at night</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckQuittingApp" AutomationProperties.AutomationId="chkQuittingApp" FontSize="14" Checked="CheckQuittingApp_Checked" Unchecked="CheckQuittingApp_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xQuitting app</CheckBox>
                            <CheckBox  Margin="0,0,0,10" x:Name="CheckUseRelaxMode" AutomationProperties.AutomationId="chkUseRelaxMode" FontSize="14" Checked="CheckUseRelaxMode_Checked" Unchecked="CheckUseRelaxMode_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xAllow using relax focus mode</CheckBox>
                            <CheckBox Margin="0,0,0,10" x:Name="CheckStopSuperPomodoro" AutomationProperties.AutomationId="chkStopSuperPomodoro" FontSize="14" Checked="CheckStopSuperPomodoro_Checked" Unchecked="CheckStopSuperPomodoro_Unchecked" Cursor="Hand" Padding="6,-3,0,0">xStop Super Focus Session</CheckBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
