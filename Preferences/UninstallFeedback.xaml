<Window x:Class="Focus_Bear.Preferences.UninstallFeedback"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
        Title="UninstallFeedback" Height="350" Width="520" WindowStyle="None" ResizeMode="NoResize" AutomationProperties.AutomationId="UninstallFeedback">
    <Grid>
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0"   Text="xUninstalling..."  Foreground="{DynamicResource ForegroundColor}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="1"   Name="Description" Margin="20,0,20,0"  TextWrapping="Wrap" Text="xDamn sorry, it seems like we let you down. We're in the early stages of this product and really want to get feedback to make it better. Could you tell us why you're uninstalling?"  Foreground="{DynamicResource ForegroundColor}" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"  />
            <ComboBox Name="ComboBoxReason" AutomationProperties.AutomationId="cmbReason" Grid.Row="2" Focusable="True" TabIndex="1" Width="250" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"  SelectedIndex="0" FontSize="14" SelectionChanged="ComboBoxReason_SelectionChanged">
            </ComboBox>

            <TextBox  Grid.Row="3" Name="TxtFeedback" AutomationProperties.AutomationId="txtBoxFeedback" TabIndex="2" TextWrapping="Wrap" AcceptsReturn="True"  Height="70" Margin="20,0,20,0"   VerticalAlignment="Center"  FontSize="14" TextChanged="TxtFeedback_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <TextBlock  Grid.Row="4" Name="Minimum" Margin="20,0,20,0"   Text="x(Minimum 10 characters)..."  Foreground="{DynamicResource ForegroundColor}" FontSize="12" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"  />

            <Button  Grid.Row="5" x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel" TabIndex="3"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Left" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,10" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnCancelTXT" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  Grid.Row="5" x:Name="btnUninstall" AutomationProperties.AutomationId="btnUninstall" TabIndex="4" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,10" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnUninstall_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnUninstallTXT" Text="xUninstall" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            
        </Grid>
    </Grid>
</Window>
