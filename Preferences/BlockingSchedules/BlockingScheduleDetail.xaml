<UserControl x:Class="Focus_Bear.Preferences.BlockingScheduleDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Preferences" xmlns:localView="clr-namespace:Focus_Bear.Utils"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900" AutomationProperties.AutomationId="BlockingScheduleDetail">
    <UserControl.Resources>
        <local:DaysOfWeekIndexConverter x:Key="DaysOfWeekIndexConverter" />
        <local:EnumToIntConverter x:Key="EnumToIntConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Padding="20"
                Background="{DynamicResource SoftCreamColor}"
                CornerRadius="12"
                BorderBrush="#FFF2E1C1"
                BorderThickness="1">
                <StackPanel>

                    <!-- Block name -->
                    <TextBlock x:Name="BlockName" Text="xBlock name" Margin="0,0,0,10" />
                    <TextBox Grid.Row="0" TabIndex="0" x:Name="BlockingScheduleName"  AutomationProperties.AutomationId="txtBlockingScheduleName" TextWrapping="Wrap" MaxLength="45"  Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" MinHeight="25" Height="32"  VerticalContentAlignment="Center">
                        <Binding Path="name"/>
                    </TextBox>
                    <Rectangle Height="1" Fill="#CCC" HorizontalAlignment="Stretch" Margin="0,10,0,10"/>

                    <!-- Weekday selector -->
                    <TextBlock x:Name="Title" Text="xBlocking schedule"  Margin="0,10,0,6"/>
                    <UniformGrid Rows="1" Columns="7" HorizontalAlignment="Stretch">
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Mon" AutomationProperties.AutomationId="Mon" Content="xMon" IsChecked="{Binding Monday}" Margin="4"  FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Tue" AutomationProperties.AutomationId="Tue" Content="xTue" IsChecked="{Binding Tuesday}" Margin="4" FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Wed" AutomationProperties.AutomationId="Wed" Content="xWed" IsChecked="{Binding Wednesday}" Margin="4" FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Thu" AutomationProperties.AutomationId="Thu" Content="xThu" IsChecked="{Binding Thursday}" Margin="4" FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Fri" AutomationProperties.AutomationId="Fri" Content="xFri" IsChecked="{Binding Friday}" Margin="4" FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Sat" AutomationProperties.AutomationId="Sat" Content="xSat" IsChecked="{Binding Saturday}" Margin="4" FontSize="12"/>
                        <ToggleButton Style="{StaticResource DayToggleButtonStyle}" x:Name="Sun" AutomationProperties.AutomationId="Sun" Content="xSun" IsChecked="{Binding Sunday}" Margin="4" FontSize="12"/> 
                    </UniformGrid>

                    <!-- Time selectors -->
                    <Grid Margin="0,20,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- From -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Stretch" Orientation="Vertical" Background="{DynamicResource SoftCreamColor}">
                            <TextBlock x:Name="From" Text="xFrom"  Margin="0,0,0,4"/>
                            <Border 
                                Background="White"
                                CornerRadius="6"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                Margin="0,0,15,0"
                                Padding="10"  HorizontalAlignment="Stretch">

                                <localView:HourControl x:Name="StartTimePicker"
                                   AutomationProperties.AutomationId="tpStartTimePicker"
                                   Height="26"
                                   Cursor="Hand"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   />

                            </Border>
                        </StackPanel>
                        <!-- Till -->
                        <StackPanel  Grid.Column="1" HorizontalAlignment="Stretch" Orientation="Vertical"  Background="{DynamicResource SoftCreamColor}">
                            <TextBlock x:Name="Till" Text="xTill"   Margin="0,0,0,4"/>
                            <Border
                            Background="White"
                            CornerRadius="6"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Margin="0,0,0,0"
                            Padding="10">

                                <localView:HourControl x:Name="EndTimePicker"
                                   AutomationProperties.AutomationId="tpEndTimePicker"
                                   Height="26"
                                   Cursor="Hand"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   />

                            </Border>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="#CCC" HorizontalAlignment="Stretch" Margin="0,10,0,10"/>

                    <!-- Block list -->
                    <TextBlock x:Name="BlockList" Text="xBlock list"  Margin="0,10,0,4"/>
                    <Border Background="White"
                         CornerRadius="6"
                         BorderBrush="LightGray"
                         BorderThickness="1"
                         Margin="0,0,0,0"
                         Padding="10"  HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                            <ComboBox  Name="ComboBoxFocusModes" AutomationProperties.AutomationId="cmbFocusModes" DisplayMemberPath="name" SelectedValuePath="id" SelectedValue="{Binding SelectedFocusModeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="250" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"  SelectedIndex="0" FontSize="15"  >
                            </ComboBox>
                            <TextBlock x:Name="EditBlockList"  AutomationProperties.AutomationId="txtEditBlockList"  Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" TextDecorations="{x:Null}"    MinHeight="22" Cursor="Hand">
                                <Hyperlink x:Name="btnEditBlockList" AutomationProperties.AutomationId="btnEditBlockList" Click="btnEditBlockList_Click" Foreground="Black"   TextDecorations="Underline" ><Run x:Name="EditBlockListText" Foreground="Black" Text="xEdit block list"/></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="#CCC" HorizontalAlignment="Stretch" Margin="0,10,0,10"/>
                    
                    <!-- Strictness slider -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StrictnessLevel" Text="xStrictness level:" Margin="0,10,0,15"/>
                        <Image x:Name="StrictnessLevelInfo"  Source="../images/info-dark.png" Margin="5,0,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                    </StackPanel>
                    <Slider x:Name="SliderStrictnessLevel" AutomationProperties.AutomationId="SliderStrictnessLevel" Minimum="0" Maximum="100"  Value="{Binding BlockLevel, Converter={StaticResource EnumToIntConverter}, Mode=TwoWay}" IsSnapToTickEnabled="True"  TickPlacement="BottomRight" Ticks="0,50,100" TickFrequency="50" ValueChanged="SliderStrictnessLevel_ValueChanged" />

                    <!-- Legend -->
                    <Grid Margin="0,6,0,10" HorizontalAlignment="Stretch" Background="{DynamicResource SoftCreamColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="91*" />
                            <ColumnDefinition Width="91*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1st group -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="2"  >
                            <Ellipse Width="12" Height="12" Fill="Green" Margin="0,0,4,0"/>
                            <TextBlock Name="Chill" Text="xChill Mode"   FontSize="13"  VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2nd group -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                            <Ellipse Width="12" Height="12" Fill="Gold" Margin="0,0,4,0"/>
                            <TextBlock x:Name="WaitForIt" Text="xWait for it..."  FontSize="13"  VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 3rd group -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" >
                            <Ellipse Width="12" Height="12" Fill="Red" Margin="0,0,4,0"/>
                            <TextBlock x:Name="IronFocus" Text="xIron Focus"   FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#CCC" HorizontalAlignment="Stretch" Margin="0,10,0,10"/>
                    
                    <!-- Options -->
                    <StackPanel Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox  x:Name="SkipMicroBreaks"   AutomationProperties.AutomationId="chkSkipMicroBreaks" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0" IsChecked="{Binding bMicroBreaksEnabled, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">xxSkip microbreaks </CheckBox>
                        <Image x:Name="MicroBreaksInfo"  Source="{DynamicResource InfoImage}" Margin="5,10,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox  x:Name="UseAIToDecide"  AutomationProperties.AutomationId="chkUseAIToDecide" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0" IsChecked="{Binding bAIBlockingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">xxUse AI to decide if websites should be allowed</CheckBox>
                        <Image x:Name="UseAIToDecideInfo"  Source="{DynamicResource InfoImage}"  Margin="5,10,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Margin="0,20,0,0"  Background="{DynamicResource SoftCreamColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left-aligned button -->
                        <Button x:Name="btnCancel"  Grid.Column="0" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource  BtnStyleClearOrangeBordered}" IsEnabled="True" Height="35" Width="150" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Padding="0" Margin="0,15,0,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click">
                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock Name="btnCancelText" Margin="8" Text="xCancel" Foreground="Black"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Right-aligned buttons -->
                        <Button x:Name="btnDelete"  Grid.Column="1" AutomationProperties.AutomationId="btnDelete"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True" Height="35" Width="150"  HorizontalContentAlignment="Center"  HorizontalAlignment="Right" Padding="0" Margin="0,15,0,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnDelete_Click">
                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock Name="btnDeleteText" Margin="8" Text="xDelete" Foreground="Black"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button x:Name="btnSaveChanges"  Grid.Column="2" AutomationProperties.AutomationId="btnSaveChanges"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True" Height="35" Width="150"  HorizontalContentAlignment="Center"  HorizontalAlignment="Right" Padding="0" Margin="15,15,0,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnSaveChanges_Click">
                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock Name="btnSaveChangesText" Margin="8" Text="xSave Changes" Foreground="Black"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>


                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
