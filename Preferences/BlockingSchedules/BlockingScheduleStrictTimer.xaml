<Window x:Class="Focus_Bear.Preferences.BlockingScheduleStrictTimer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
        Title="Focus Bear" Height="316" Width="504" ResizeMode="NoResize" ShowInTaskbar="False" AutomationProperties.AutomationId="BlockingScheduleStrictTimer">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xPausing custom schedule - " Foreground="#e88800" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" x:Name="TxtTimer" Margin="0,15,0,0" TextWrapping="Wrap" Text="00:15" Padding="0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" MinHeight="30" VerticalAlignment="Center"  />
        <TextBlock  Grid.Row="2" Name="Description" Margin="20,0,20,0" TextWrapping="Wrap" Text="xxStrict mode activated..." FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"  />
         

        <StackPanel  Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button   x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Width="180" MinHeight="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCancelText" Margin="8" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button   x:Name="btnPauseCustomSchedule" AutomationProperties.AutomationId="btnPauseCustomSchedule"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  MinHeight="35" MinWidth="180"  HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontWeight="Semibold" Click="btnPauseCustomSchedule_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnPauseCustomScheduleText" Margin="8" Text="xPause Custom Schedule" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>

        </StackPanel>
        
        
    </Grid>
</Window>

