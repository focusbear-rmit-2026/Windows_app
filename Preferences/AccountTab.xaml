<UserControl x:Class="Focus_Bear.Preferences.AccountTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Preferences"
      mc:Ignorable="d" 
      d:DesignHeight="670" d:DesignWidth="670"
       Background="#fff">

    <Grid>
        <Grid Background="#fcf8f0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="1"/>
                
                <RowDefinition Height="50"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0"   Text="xYour Account Information"  Foreground="#e88800" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"  />
            <Grid Grid.Row="1" Background="LightGray" ></Grid>
            
            <Grid Grid.Row="2"   >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock   Name="LblName" Margin="20,0,10,0"   Text="xName:"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"  />
                    <TextBlock    Name="LblNameValue" Margin="0,0,20,0"   Text="xFocusBear"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3"   >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Name="LblEmail" Margin="20,0,10,0"   Text="xEmail:"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"  />
                    <TextBlock Name="LblEmailValue" Margin="0,0,20,0"   Text="xFocusBear Mail"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4"   >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock   Name="LblUserId" Margin="20,0,10,0"   Text="xEmail:"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Right"  />
                    <TextBox   Name="LblUserIdValue" IsReadOnly="True" Margin="0,0,0,0" Width="auto"  Text="xuser id"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />
                    <Button  x:Name="btnCopyUserId"  IsEnabled="True"   Margin="10,0,0,0" Width="22" Height="22" HorizontalContentAlignment="Center" Padding="0"  FontSize="15" Cursor="Hand"   VerticalAlignment="Center" BorderBrush="#eee" Background="#eee" Click="btnCopyUserId_Click" ToolTip="xCopy">
                        <Button.Content>
                            <Image Grid.Row="0" Height="20"  Width="20"  Margin="0,0,0,0" Source="../Images/copy.png" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
            <Button  Grid.Row="5" x:Name="btnLogout"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="27" Width="135" HorizontalAlignment="Center" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnLogout_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnLogoutTXT" Text="xLogout"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Grid Grid.Row="6" Background="LightGray" ></Grid>

            <TextBlock  Grid.Row="7"  Name="LblTrialInfo" Margin="20,0,20,0"   Text="xTrial Version:"  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"  />

            <TextBlock  Grid.Row="8" Width="500" Name="LblPurchase" Margin="20,0,20,0"  TextWrapping="Wrap" Text="xIf you've already purchased Focus Bear subscription, you can restore that purchase."  Foreground="#000" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"  />

            <Button  Grid.Row="9" x:Name="btnSyncPayment"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="27" Width="200" HorizontalAlignment="Center" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnSyncPayment_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnSyncPaymentTXT" Text="xSync Payment Status"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <ProgressBar Grid.Row="10" x:Name="ProgressSync"   Height="15" Width="200" IsIndeterminate = "True"  Foreground="DodgerBlue" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
