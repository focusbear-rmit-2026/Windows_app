<Window x:Class="Focus_Bear.Preferences.CommunityPreference"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
        Title="Focus Bear" Height="260" Width="340" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>

        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap"  Text="xWhat community system would you prefer to use?" FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"  />

        <ComboBox Name="ComboBoxOptions" AutomationProperties.AutomationId="cmbOptions" Grid.Row="1" Width="220" MinHeight="30" VerticalAlignment="Center" HorizontalAlignment="Center"   SelectedIndex="0" FontSize="15" SelectionChanged="ComboBoxOptions_SelectionChanged">
        </ComboBox>

        <TextBox  Grid.Row="2" Visibility="Collapsed" x:Name="OtherText" TextWrapping="Wrap"  BorderBrush="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" Height="25" Width="220"  TextChanged="OtherText_TextChanged">

        </TextBox>
        <Button  Grid.Row="3" x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="26" Width="113" HorizontalAlignment="Left" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnCancelTXT" Text="xCancel"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <Button  Grid.Row="3" x:Name="btnOK" AutomationProperties.AutomationId="btnOK"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="26" Width="113" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,15" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnOK_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnOKTXT" Text="xOK"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Window>
