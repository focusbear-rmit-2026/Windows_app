<Window x:Class="Focus_Bear.Preferences.AddFocusType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Preferences"
        mc:Ignorable="d"
        Title="AddFocusType" Height="180" Width="450" ResizeMode="NoResize" AutomationProperties.AutomationId="AddFocusType">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Name="TitleTxt" Margin="20,0,20,5" TextWrapping="Wrap"  Text="xTitle:"   FontSize="13" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"  />
        <TextBox Grid.Row="1" TabIndex="0" x:Name="TxtFocusName" AutomationProperties.AutomationId="textBoxFocusName" Margin="20,5,20,10" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="13" TextAlignment="Left" MaxLines="1" Height="25" TextChanged="TxtFocusName_TextChanged" >

        </TextBox>

        
        <Grid Grid.Row="3" Background="LightGray" ></Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel" Grid.Column="0" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Cursor="Hand" Height="23" Width="100" Margin="20,0,0,0" HorizontalAlignment="Left" FontWeight="Semibold" Click="btnCancel_Click">xCancel</Button>
            <Button x:Name="btnAdd" AutomationProperties.AutomationId="btnAdd" Grid.Column="1" Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" Cursor="Hand" Height="23" Width="100" Margin="0,0,20,0" HorizontalAlignment="Right"  FontWeight="Semibold" Click="btnAdd_Click">xAdd</Button>

        </Grid>
    </Grid>
</Window>
