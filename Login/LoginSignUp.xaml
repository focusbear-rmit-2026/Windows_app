<Page x:Class="Focus_Bear.Login.LoginSignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Login"
      xmlns:Models="clr-namespace:Focus_Bear.Models"
      mc:Ignorable="d" 
     d:DesignHeight="680" d:DesignWidth="945"
      Title="LoginSignUp"  Background="#fff">
    <Page.Resources>
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#808080" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,-1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="5,5,5,5"
                                Padding="9"
                                Width="150">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#007Aff" />
                                <Setter Property="BorderBrush" Value="#007Aff" />
                                <Setter Property="Foreground" Value="#fff" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007Aff" />
                                <Setter Property="Foreground" Value="#fff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Button x:Name="btnBack"  Grid.RowSpan="3" Grid.Column="0" Content="Button" Style="{DynamicResource BtnStyleBack}" SnapsToDevicePixels="True" HorizontalAlignment="Center" Height="34" VerticalAlignment="Center" Width="34" ToolTip="xBack" Cursor="Hand" Click="btnBack_Click"/>

        <TextBlock Width="300" Grid.Row="0" Grid.Column="1" Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xSign Up" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1" Grid.Column="1"  Name="Description" Margin="0,20,0,0" TextWrapping="Wrap" Text="xCreate an account to sync your habit + block settings across all your devices." Foreground="#272727" FontSize="17" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Width="420">
           
            <TextBlock Width="300"  Name="lblEmail" Margin="60,20,40,10" TextWrapping="Wrap" Text="xEmail Address" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
            <TextBox Width="300" TabIndex="1" x:Name="TxtEmailAddress" Margin="0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"   BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <RadioButton x:Name="GeneratePassword" Content="xGenerate Password" Style="{StaticResource SegmentRadioButtonStyle}"  Checked="GeneratePassword_Checked"/>
                <RadioButton x:Name="OwnPassword" Content="xUse own password" Style="{StaticResource SegmentRadioButtonStyle}" Checked="OwnPassword_Checked"/>
                 </StackPanel>
            <TextBlock Width="300"  Name="lblPassword" Margin="60,20,40,10" TextWrapping="Wrap" Text="xPassword" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
            <Grid>
                <PasswordBox Width="300" TabIndex="2" x:Name="TxtPassword" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15"  PasswordChanged="TxtPassword_PasswordChanged"   >
                    <PasswordBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </PasswordBox.Effect>
                    <PasswordBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.FocusVisualStyle>
                </PasswordBox>
                <TextBox Width="300" x:Name="TxtPasswordVisible" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" TextChanged="TxtPasswordVisible_TextChanged" Visibility="Collapsed">
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
                <Image x:Name="EyePassword" Source="../images/eye-gray.png" Width="20" Height="20" Margin="340,0,0,0" Cursor="Hand" MouseUp="EyePassword_MouseUp"></Image>
                <Image  Name="ImgPasswordValid" Source="../images/validIcon.png" Width="20" Height="20" Margin="390,0,0,0" Visibility="Collapsed"></Image>
            </Grid>

            <TextBlock Visibility="Collapsed" Width="300"  Name="lblConfirmPassword" Margin="60,20,40,10" TextWrapping="Wrap" Text="xConfirm Password" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
            <Grid Visibility="Collapsed">
                <PasswordBox Width="300" TabIndex="3" x:Name="TxtConfirmPassword" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"   BorderThickness="1" FontSize="15"  PasswordChanged="TxtConfirmPassword_PasswordChanged"  >
                    <PasswordBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </PasswordBox.Effect>
                    <PasswordBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.FocusVisualStyle>
                </PasswordBox>
                <TextBox Width="300" x:Name="TxtConfirmPasswordVisible" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" TextChanged="TxtConfirmPasswordVisible_TextChanged" Visibility="Collapsed" >
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                 </TextBox>
                <Image x:Name="EyeConfirmPassword" Source="../images/eye-gray.png" Width="20" Height="20" Margin="340,0,0,0" Cursor="Hand" MouseUp="EyeConfirmPassword_MouseUp"></Image>
                <Image Name="ImgConfirmPasswordValid" Source="../images/validIcon.png" Width="20" Height="20" Margin="390,0,0,0"  Visibility="Collapsed"></Image>
            </Grid>
            <Grid x:Name="GridGeneratePassRelated" Visibility="Visible">

                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="Copy"  Margin="61,5,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" TextDecorations="{x:Null}"   FontSize="15" Height="22" Cursor="Hand">
                     <Hyperlink x:Name="btnCopy"  Foreground="#000" Click="btnCopy_Click"   TextDecorations="Underline" ><Run x:Name="btnCopyTXT" Text="xCopy"/></Hyperlink>
                </TextBlock>
                <CheckBox  Grid.Row="1"  Margin="61,5,0,0" x:Name="SavedPassword" FontSize="15" Checked="SavedPassword_Checked" Unchecked="SavedPassword_Unchecked" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,-3,0,0">xI saved the password somewhere safe</CheckBox>
            </Grid>
            <Grid x:Name="GridPasswordRules" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Width="300"  Name="lblPasswordRules" Margin="60,0,0,0" TextWrapping="Wrap" Text="xPassword Rules:" Foreground="#000" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Width="300"  Name="lblPassword8Chars" Margin="60,0,0,0" TextWrapping="Wrap" Text="xAt least 8 characters in length " Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="1" Grid.Column="1" Name="ImgPassword8Chars" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="2" Grid.Column="0" Width="300"  Name="lblPassword3Types" Margin="60,2,0,0" TextWrapping="Wrap" Text="xContains at least 3 of the following 4 types of characters: " Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="2" Grid.Column="1" Name="ImgPassword3Types" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,2,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="3" Grid.Column="0" Width="300"  Name="lblPasswordLowerCase" Margin="60,2,0,0" TextWrapping="Wrap" Text="xlower case letters (a-z)" Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="3" Grid.Column="1" Name="ImgPasswordLowerCase" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="4" Grid.Column="0" Width="300"  Name="lblPasswordUpperCase" Margin="60,2,0,0" TextWrapping="Wrap" Text="xupper case letters (A-Z)" Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="4" Grid.Column="1" Name="ImgPasswordUpperCase" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="5" Grid.Column="0" Width="300"  Name="lblPasswordNumbers" Margin="60,2,0,0" TextWrapping="Wrap" Text="xnumbers (i.e. 0-9)" Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="5" Grid.Column="1" Name="ImgPasswordNumbers" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="6" Grid.Column="0" Width="300"  Name="lblPasswordSpecialChars" Margin="60,2,0,0" TextWrapping="Wrap" Text="xspecial characters (e.g. !@#$%^ *)" Foreground="#000" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="6" Grid.Column="1" Name="ImgPasswordSpecialChars" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

            </Grid>
            
            <Button Width="300" TabIndex="4" x:Name="btnCreatAccount"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="0,47,0,20" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnCreatAccount_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCreateAccountText" Text="xCreate an account"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <StackPanel Orientation="Horizontal" x:Name="StatusAct"  Margin="0,0,0,6" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed">
                <!--<TextBlock x:Name="PleaseWait" Foreground="#FF9E9DA2" Text="xPlease wait" TextWrapping="Wrap" Padding="0"  TextTrimming="CharacterEllipsis" />
                <Image x:Name="ImgUpdateAppProgress" Height="22" Width="22" Models:ImageBehavior.AnimatedSource="../Images/progress.gif" HorizontalAlignment="Left" Margin="7,-1,0,0" VerticalAlignment="Bottom" />-->
                <ProgressBar   x:Name="ProgressLogin"   Height="15" Width="200" IsIndeterminate = "True"  Foreground="DodgerBlue"  />

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

    