<Page x:Class="Focus_Bear.Login.LoginSignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Login"
      xmlns:Models="clr-namespace:Focus_Bear.Models"
      mc:Ignorable="d" 
     d:DesignHeight="680" d:DesignWidth="945"
      Title="LoginSignUp" >
    <Grid>
        <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="3.5*"/>
            <RowDefinition Height="6.5*"/>
        </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xSign Up" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Name="Description" Margin="0,20,0,0" TextWrapping="Wrap" Text="xCreate an account to sync your habit + block settings across all your devices."  FontSize="17" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Width="520">

            <TextBlock Width="400"  Name="lblEmail" Margin="60,20,40,10" TextWrapping="Wrap" Text="xEmail Address"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
            <TextBox Width="400" TabIndex="1" x:Name="TxtEmailAddress" AutomationProperties.AutomationId="txtBoxEmailAddress" Margin="0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Padding="5,2,5,5"   BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>

            <TextBlock Width="400"  Name="lblPassword" Margin="60,10,40,10" TextWrapping="Wrap" Text="xPassword"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>

            <Grid>
                <PasswordBox Width="400" TabIndex="2" x:Name="TxtPassword" AutomationProperties.AutomationId="passwordBox" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15"  PasswordChanged="TxtPassword_PasswordChanged"   >
                    <PasswordBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </PasswordBox.Effect>
                    <PasswordBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.FocusVisualStyle>
                </PasswordBox>
                <TextBox Width="400" x:Name="TxtPasswordVisible" AutomationProperties.AutomationId="txtPasswordVisible" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" TextChanged="TxtPasswordVisible_TextChanged" Visibility="Collapsed">
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
                <Image x:Name="EyePassword" Source="../images/eye-dark.png" Width="20" Height="20" Margin="440,0,0,0" Cursor="Hand" MouseUp="EyePassword_MouseUp"></Image>
                <Image  Name="ImgPasswordValid" Source="../images/validIcon.png" Width="20" Height="20" Margin="490,0,0,0" Visibility="Collapsed"></Image>
            </Grid>

            <TextBlock Visibility="Collapsed" Width="400"  Name="lblConfirmPassword" Margin="60,20,40,10" TextWrapping="Wrap" Text="xConfirm Password"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
            <Grid Visibility="Collapsed">
                <PasswordBox Width="300" TabIndex="3" x:Name="TxtConfirmPassword" AutomationProperties.AutomationId="passwordBoxConfirm" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"   BorderThickness="1" FontSize="15"  PasswordChanged="TxtConfirmPassword_PasswordChanged"  >
                    <PasswordBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </PasswordBox.Effect>
                    <PasswordBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.FocusVisualStyle>
                </PasswordBox>
                <TextBox Width="300" x:Name="TxtConfirmPasswordVisible" AutomationProperties.AutomationId="txtBoxConfirmPassword" Margin="0"   Background="#FFF" BorderBrush="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15" TextChanged="TxtConfirmPasswordVisible_TextChanged" Visibility="Collapsed" >
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
                <Image x:Name="EyeConfirmPassword" Source="../images/eye-gray.png" Width="20" Height="20" Margin="340,0,0,0" Cursor="Hand" MouseUp="EyeConfirmPassword_MouseUp"></Image>
                <Image Name="ImgConfirmPasswordValid" Source="../images/validIcon.png" Width="20" Height="20" Margin="390,0,0,0"  Visibility="Collapsed"></Image>
            </Grid>

            <Grid x:Name="GridPasswordRules" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Width="400"  Name="lblPasswordRules" Margin="60,0,0,0" TextWrapping="Wrap" Text="xPassword Rules:"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Width="400"  Name="lblPassword8Chars" Margin="60,0,0,0" TextWrapping="Wrap" Text="xAt least 8 characters in length " FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="1" Grid.Column="1" Name="ImgPassword8Chars" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="2" Grid.Column="0" Width="400"  Name="lblPassword3Types" Margin="60,2,0,0" TextWrapping="Wrap" Text="xContains at least 3 of the following 4 types of characters: " FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="2" Grid.Column="1" Name="ImgPassword3Types" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,2,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="3" Grid.Column="0" Width="400"  Name="lblPasswordLowerCase" Margin="60,2,0,0" TextWrapping="Wrap" Text="xlower case letters (a-z)" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="3" Grid.Column="1" Name="ImgPasswordLowerCase" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="4" Grid.Column="0" Width="400"  Name="lblPasswordUpperCase" Margin="60,2,0,0" TextWrapping="Wrap" Text="xupper case letters (A-Z)"  FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="4" Grid.Column="1" Name="ImgPasswordUpperCase" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="5" Grid.Column="0" Width="400"  Name="lblPasswordNumbers" Margin="60,2,0,0" TextWrapping="Wrap" Text="xnumbers (i.e. 0-9)" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="5" Grid.Column="1" Name="ImgPasswordNumbers" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

                <TextBlock Grid.Row="6" Grid.Column="0" Width="400"  Name="lblPasswordSpecialChars" Margin="60,2,0,0" TextWrapping="Wrap" Text="xspecial characters (e.g. !@#$%^ *)" FontSize="13" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
                <Image Grid.Row="6" Grid.Column="1" Name="ImgPasswordSpecialChars" Source="../images/validIcon.png" Width="17" Height="17" Margin="-50,0,0,0" VerticalAlignment="Top"  Visibility="Collapsed"></Image>

            </Grid>

            <Button Width="400" TabIndex="4" x:Name="btnCreateAccount" AutomationProperties.AutomationId="btnCreateAccount"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="0,47,0,20" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnCreateAccount_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCreateAccountText" Text="xCreate an account" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <StackPanel Orientation="Horizontal" x:Name="StatusAct"  Margin="0,0,0,6" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed">
                <!--<TextBlock x:Name="PleaseWait" Foreground="#FF9E9DA2" Text="xPlease wait" TextWrapping="Wrap" Padding="0"  TextTrimming="CharacterEllipsis" />
                <Image x:Name="ImgUpdateAppProgress" Height="22" Width="22" Models:ImageBehavior.AnimatedSource="../Images/progress.gif" HorizontalAlignment="Left" Margin="7,-1,0,0" VerticalAlignment="Bottom" />-->
                <ProgressBar   x:Name="ProgressLogin"   Height="15" Width="200" IsIndeterminate = "True"  Foreground="DodgerBlue"  />

            </StackPanel>
        </StackPanel>
    </Grid>

    </Grid>
</Page>

    