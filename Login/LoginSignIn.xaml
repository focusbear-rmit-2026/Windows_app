<Page x:Class="Focus_Bear.Login.LoginSignIn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Login"
            xmlns:Models="clr-namespace:Focus_Bear.Models"

      mc:Ignorable="d" 
     d:DesignHeight="680" d:DesignWidth="945"
      Title="LoginSignIn"  Background="#fff">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <Button x:Name="btnBack" Grid.Column="0" Content="Button" Style="{DynamicResource BtnStyleBack}" SnapsToDevicePixels="True" HorizontalAlignment="Center" Height="34" VerticalAlignment="Center" Width="34" ToolTip="xBack" Cursor="Hand" Click="btnBack_Click"/>

        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Width="300">
            <TextBlock  Name="Heading" Margin="0,100,0,0" TextWrapping="Wrap" Text="xSign In" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock   Name="Description" Margin="40,20,40,0" TextWrapping="Wrap" Text="xCreate an account" Foreground="#272727" FontSize="17" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock  Name="lblEmail" Margin="0,40,40,10" TextWrapping="Wrap" Text="xEmail Address" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left"/>
            <TextBox TabIndex="0" x:Name="TxtEmailAddress" Margin="0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>

            <TextBlock   Name="lblPassword" Margin="0,20,40,10" TextWrapping="Wrap" Text="xPassword" Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left"/>
            <PasswordBox TabIndex="1" x:Name="TxtPassword" Margin="0"   Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5" BorderThickness="1" FontSize="15"     >
                <PasswordBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </PasswordBox.Effect>
                <PasswordBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </PasswordBox.FocusVisualStyle>
            </PasswordBox>

            <Button TabIndex="2"  x:Name="btnSignIn"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="0,47,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnSignIn_Click" IsDefault="True" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnSignInText"  Text="xSign In"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            
            <TextBlock x:Name="ForgetPassword"  Margin="0,20,0,30" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}" FontSize="15" Height="22" Cursor="Hand">
                <Hyperlink x:Name="btnForgetPassword"  Foreground="#000" Click="btnForgetPassword_Click"   TextDecorations="Underline" ><Run x:Name="ForgetPasswordTXT" Text="xForgot Password"/></Hyperlink>
            </TextBlock>
            
            <Button TabIndex="3"  x:Name="btnCreatAccount"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnCreatAccount_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCreateAccountText" Text="xCreate an account"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <StackPanel Orientation="Horizontal" x:Name="StatusAct"  Margin="0,20,0,6" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed">
                <!--<TextBlock  Foreground="#FF9E9DA2" Name="PleaseWait" Text="xPlease wait" TextWrapping="Wrap" Padding="0"  TextTrimming="CharacterEllipsis" />
                <Image x:Name="ImgUpdateAppProgress" Height="22" Width="22" Models:ImageBehavior.AnimatedSource="../Images/progress.gif" HorizontalAlignment="Left" Margin="7,-1,0,0" VerticalAlignment="Bottom" />-->
                <ProgressBar   x:Name="ProgressLogin"   Height="15" Width="200" IsIndeterminate = "True"  Foreground="DodgerBlue" />

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

    