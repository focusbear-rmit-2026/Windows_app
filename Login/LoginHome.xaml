<Page x:Class="Focus_Bear.Login.LoginHome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Login"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="945"
      AutomationProperties.AutomationId="LoginHome"
      Title="LoginHome" >

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <!-- 25% -->
            <RowDefinition Height="40*" />
            <!-- 37.5% -->
            <RowDefinition Height="40*" />
            <!-- 25% -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
            <TextBlock  Name="Heading" Margin="0,0,0,10" TextWrapping="Wrap" Text="xCreate your account." FontSize="35" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubHeading" AutomationProperties.AutomationId="txtSubHeading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWe use Auth0, our secure login partner, to sign you in." FontSize="17" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="500"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image MaxHeight="260" MaxWidth="260" Source="../Images/new/bear_createAccount.png" Stretch="Uniform" HorizontalAlignment="Center"  />
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
                Text="xOne account, all your devices - let's get you set up!"
                Direction="Right"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-225" Y="0"/>
                </controls:SpeechBubble.RenderTransform>
            </controls:SpeechBubble>
        </Grid>
        
        <StackPanel  Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center">
           
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                <Button  x:Name="btnSignInGoogle" AutomationProperties.AutomationId="btnSignInGoogle" Style="{StaticResource  BtnStyleClearGrayBordered}" IsEnabled="True"   Width="250" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSignInWithGoogle_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <Image Source="/Images/logo_google.png" Margin="0,0,10,0" Height="24" Width="24" />
                            <TextBlock Name="btnSignInWithGoogleText" Margin="0,2,10,0" Text="xSign up with Google" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button  x:Name="btnSignInApple" AutomationProperties.AutomationId="btnSignInApple" Style="{StaticResource  BtnStyleClearGrayBordered}" IsEnabled="True"   Width="250" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="17,0,0,0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSignInWithApple_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <Image Source="/Images/apple_logo.png" Margin="0,0,10,0" Height="24" Width="24" />
                            <TextBlock Name="btnSignInAppleText"  Margin="0,2,10,0" Text="xSign up with Apple" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>

            <TextBlock Name="OR" Margin="0,15,0,0" TextWrapping="Wrap" Text="xOR" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />

            <Button x:Name="btnSignUp" AutomationProperties.AutomationId="btnSignUp" Style="{StaticResource  BtnStyleClearGrayBordered}" IsEnabled="True"   Width="517" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="0,15,0,0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSignIn_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Source="/Images/email.png" Margin="0,0,10,0" Height="24" Width="24" />
                        <TextBlock Name="btnSignUpText" Margin="0,2,10,0"  Text="xSign up with Email" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <TextBlock x:Name="CancelButton" Visibility="Collapsed" AutomationProperties.AutomationId="txtCancelGoogle" Margin="0,20,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}" FontSize="14" MinHeight="22" Cursor="Hand">
                    <Hyperlink x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel" Click="btnCancel_Click"   TextDecorations="Underline" ><Run x:Name="CancelTXT" Text="xCancel"/></Hyperlink>
            </TextBlock>
            
            <TextBlock  x:Name="HaveAccount" AutomationProperties.AutomationId="txtHaveAccount" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
                <Hyperlink x:Name="btnHaveAccount" AutomationProperties.AutomationId="btnHaveAccount"  Click="btnHaveAccount_Click" TextDecorations="Underline" ><Run x:Name="btnHaveAccountText" Text="xI already have a Focus Bear account"/></Hyperlink>
            </TextBlock>
            
        </StackPanel>
    </Grid>
</Page>
