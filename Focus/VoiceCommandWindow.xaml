<Window x:Class="Focus_Bear.Focus.VoiceCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Focus Bear" SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AutomationProperties.AutomationId="VoiceCommandWindow">

    <Border x:Name="RootBorder" CornerRadius="12" Background="White" Padding="0"
            BorderBrush="#e88800" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <Grid x:Name="MainGrid" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Prompt / state heading -->
            <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,16"
                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#333333" Text="Tell me your plans for the day…"/>

            <!-- Pulsing microphone -->
            <Grid Grid.Row="1" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Ellipse x:Name="PulseOuter" Width="120" Height="120" Fill="#33e88800"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseOuterScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="PulseInner" Width="92" Height="92" Fill="#66e88800"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseInnerScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="68" Height="68" Fill="#e88800"/>

                <!-- Spinner shown while processing -->
                <Ellipse x:Name="Spinner" Width="76" Height="76" Visibility="Collapsed"
                         Stroke="#e88800" StrokeThickness="4" StrokeDashArray="4 2"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Microphone glyph -->
                <Viewbox x:Name="MicGlyph" Width="34" Height="34">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White"
                              Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z M17,11 C17,14 14.76,16.1 12,16.1 C9.24,16.1 7,14 7,11 L5,11 C5,14.42 7.72,17.23 11,17.72 L11,21 L13,21 L13,17.72 C16.28,17.23 19,14.42 19,11 L17,11 Z"/>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Transcript -->
            <TextBlock x:Name="TranscriptText" Grid.Row="2" Margin="0,0,0,6"
                       FontSize="14" FontStyle="Italic" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#555555" Visibility="Collapsed"/>

            <!-- Result / error message -->
            <TextBlock x:Name="ResultText" Grid.Row="3" Margin="0,4,0,10"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#2a9d3a" Visibility="Collapsed"/>

            <!-- Buttons: the app's orange styles (App.xaml), so hover is the app's pale orange rather than the
                 default WPF chrome's light blue; the primary action sits on the right, as in the other popups. -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="btnSecondary" Content="Cancel" Click="btnSecondary_Click" AutomationProperties.AutomationId="btnVoiceSecondary"
                        Style="{StaticResource BtnStyleClearOrangeBordered}" Foreground="Black"
                        MinWidth="110" Height="36" Margin="6,0" Cursor="Hand" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="btnPrimary" Content="Done" Click="btnPrimary_Click" AutomationProperties.AutomationId="btnVoicePrimary"
                        Style="{StaticResource BtnStyleLightOrangeBordered}" Foreground="Black"
                        MinWidth="110" Height="36" Margin="6,0" Cursor="Hand" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <!-- Pulsing animation while listening -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard x:Name="PulseStoryboard">
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="PulseOuterScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.85" To="1.15" Duration="0:0:1.1" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="PulseOuterScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.85" To="1.15" Duration="0:0:1.1" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="PulseInnerScale" Storyboard.TargetProperty="ScaleX"
                                     From="1.1" To="0.9" Duration="0:0:1.1" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="PulseInnerScale" Storyboard.TargetProperty="ScaleY"
                                     From="1.1" To="0.9" Duration="0:0:1.1" AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
