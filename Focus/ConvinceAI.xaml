<Window x:Class="Focus_Bear.Focus.ConvinceAI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="ConvinceAI" Height="400" Width="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="None">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="70" />
            <RowDefinition Height="100" />
            <RowDefinition Height="40" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="Heading"  Margin="10,20,10,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="xConvince the AI why it's necessary"  FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1" x:Name="Description" Margin="20,20,20,10" TextWrapping="Wrap"  FontSize="13"> xGive more info to the AI to explain why you need to use this site</TextBlock>
        <TextBox  Grid.Row="2"  Name="TxtIntention" AutomationProperties.AutomationId="txtBoxIntention" Visibility="Visible"  TextWrapping="Wrap" AcceptsReturn="True"    Height="70" Margin="15" VerticalAlignment="Top"  FontSize="15" TextChanged="TxtIntention_TextChanged">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="3"
              Direction="330"
              Color="Gray"
              Opacity="0.5"
              BlurRadius="6"
               />
            </TextBox.Effect>
            <TextBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.FocusVisualStyle>
        </TextBox>
        <TextBlock Grid.Row="3" x:Name="TxtTimer" Margin="0,0,0,0" TextWrapping="NoWrap" Text="00:30" Padding="0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"  VerticalAlignment="Center" />

        <StackPanel Grid.Row="4" Name="ButtonsSection" Orientation="Vertical" Margin="20,20,20,20">
            <Button  x:Name="btnConvinceAI" AutomationProperties.AutomationId="btnConvinceAI"  Style="{StaticResource BtnStyleLightOrangeBordered }" IsEnabled="True"   Width="300" Height="30" HorizontalContentAlignment="Center" Padding="0" Margin="0,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnConvinceAI_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnConvinceAIText" Margin="1" Text="xConvince AI" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button   x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource BtnStyleClearOrangeBordered    }" IsEnabled="True"   Width="300" Height="30" HorizontalContentAlignment="Center" Padding="0" Margin="0,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCancelText" Margin="1" Text="xCancel" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Window>
