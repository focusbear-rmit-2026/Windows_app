<Window x:Class="Focus_Bear.Focus.TeacherPactInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="Focus Bear" Icon="../Images/focus-bear.ico" Height="Auto" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Topmost="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundColor}">
    <Grid Margin="24">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Screen A: the PACT invite -->
        <StackPanel x:Name="InvitePanel">
            <Image Source="../Images/welcome_bear.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="InviteTitle" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="EndsText" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.75" Margin="0,0,0,14"/>

                <TextBlock x:Name="YouCanUseHeader" TextWrapping="Wrap" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                <ItemsControl x:Name="AllowedSitesList" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF1E6" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#B65C00"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="InviteBody" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,18"/>

                <Button x:Name="btnActivate" AutomationProperties.AutomationId="btnActivatePact" Style="{StaticResource BtnStyleLightOrangeBordered}" Height="38" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnActivate_Click">
                    <Button.Content>
                        <TextBlock x:Name="btnActivateTxt" Padding="15,0,15,0" Foreground="Black"/>
                    </Button.Content>
                </Button>

                <TextBlock HorizontalAlignment="Center" FontSize="14" Opacity="0.65" Margin="0,14,0,0">
                    <Hyperlink x:Name="lnkDecline" Click="lnkDecline_Click" Foreground="{DynamicResource ForegroundColor}"><Run x:Name="lnkDeclineTxt"/></Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Screen B: friction before declining -->
            <StackPanel x:Name="DeclinePanel" Visibility="Collapsed">
                <TextBlock x:Name="BeforeDeclineTitle" TextWrapping="Wrap" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="BeforeDeclineBody" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>

                <Border Background="#FFF6E5" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <TextBlock x:Name="ReportNoteText" TextWrapping="Wrap" FontSize="13" Foreground="#4A3418"/>
                </Border>

                <TextBlock x:Name="WhyDecliningLabel" TextWrapping="Wrap" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                <TextBox x:Name="TextReason" AutomationProperties.AutomationId="TextDeclineReason" Height="70" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="TextReason_TextChanged" Margin="0,0,0,4"/>
                <TextBlock x:Name="ReasonHelper" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>

                <!-- CornerRadius on a Border only rounds its OWN fill - a child Grid.ClipToBounds clips to a
                     plain rectangle, so square corners were poking past the round edge. HoldButtonClip gets an
                     explicit rounded Clip geometry from code-behind to actually match. -->
                <Border x:Name="HoldButton" AutomationProperties.AutomationId="btnHoldToDecline" Height="42" CornerRadius="7" Background="#ffe4c6" BorderBrush="#e88800" BorderThickness="1" Cursor="Hand"
                        PreviewMouseLeftButtonDown="HoldButton_MouseDown" PreviewMouseLeftButtonUp="HoldButton_MouseUp" LostMouseCapture="HoldButton_LostMouseCapture">
                    <Grid x:Name="HoldButtonClip" Background="Transparent">
                        <Border x:Name="HoldProgress" HorizontalAlignment="Left" Width="0" Background="#e88800"/>
                        <TextBlock x:Name="HoldButtonTxt" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Semibold" FontSize="14" Foreground="Black"/>
                    </Grid>
                </Border>

                <!-- both revealed only while actively holding, below the button (not above it) -->
                <TextBlock x:Name="HoldCountdownText" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Opacity="0.75" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Border x:Name="MindfulNoteBox" Background="#FFF6E5" CornerRadius="6" Padding="12" Margin="0,10,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="MindfulNoteText" TextWrapping="Wrap" FontSize="12" Foreground="#4A3418"/>
                </Border>

                <TextBlock HorizontalAlignment="Center" FontSize="14" Opacity="0.65" Margin="0,14,0,0">
                    <Hyperlink x:Name="lnkBackToJoin" Click="lnkBackToJoin_Click" Foreground="{DynamicResource ForegroundColor}"><Run x:Name="lnkBackToJoinTxt"/></Hyperlink>
                </TextBlock>
            </StackPanel>
    </Grid>
</Window>
