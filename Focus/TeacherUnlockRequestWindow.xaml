<Window x:Class="Focus_Bear.Focus.TeacherUnlockRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="Focus Bear" Height="Auto" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" Topmost="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundColor}">
    <Border BorderBrush="LightGray" BorderThickness="1">
        <Grid Margin="20">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" TextWrapping="Wrap" FontWeight="Bold" FontSize="15" Text="xAsk your teacher to unlock an app or website" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" x:Name="AppOrUrlLabel" TextWrapping="Wrap" FontSize="13" Text="xApp name or website" Margin="0,0,0,5"/>
            <TextBox Grid.Row="2" x:Name="TextAppOrUrl" AutomationProperties.AutomationId="TextAppOrUrl" Height="26" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" x:Name="ReasonLabel" TextWrapping="Wrap" FontSize="13" Text="xReason (optional)" Margin="0,0,0,5"/>
            <TextBox Grid.Row="4" x:Name="TextReason" AutomationProperties.AutomationId="TextReason" Height="52" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel" Style="{StaticResource BtnStyleClearOrangeBordered}" Height="30" MinWidth="110" FontSize="14" Cursor="Hand" FontWeight="Semibold" Margin="0,0,10,0" Click="btnCancel_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="btnCancelTxt" Text="xCancel" Padding="15,0,15,0" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="btnSendRequest" AutomationProperties.AutomationId="btnSendRequest" Style="{StaticResource BtnStyleLightOrangeBordered}" Height="30" MinWidth="130" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSendRequest_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="btnSendRequestTxt" Text="xSend Request" Padding="15,0,15,0" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
