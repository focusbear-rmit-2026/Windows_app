<Window x:Class="Focus_Bear.Focus.StopFocusMode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="Focus Bear" Height="450" Width="720"  ResizeMode="NoResize" Background="{DynamicResource BackgroundColor}" >
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="20" />
            <RowDefinition Height="Auto" MinHeight="35" />
            <RowDefinition Height="Auto" MinHeight="40" />
            <RowDefinition Height="Auto" MinHeight="60" />
            <RowDefinition Height="Auto" MinHeight="10" />
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />

        </Grid.RowDefinitions>


        <TextBlock  Grid.Row="0"  Name="Heading" Margin="20,0,20,0" TextWrapping="Wrap" Text="xDeactivating Focus type - FOCUSTYPE" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
       
        <TextBlock Grid.Row="2"  Name="Timer" Margin="10,0,10,0" TextWrapping="Wrap" Text="xx00:05" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

     

        <TextBlock  Grid.Row="3" Name="WhyDeactivating" Margin="40,0,40,0" TextWrapping="Wrap" Text="xxCan you share why you are deactivating?" FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>

        <ComboBox Name="ComboBoxReason" AutomationProperties.AutomationId="cmbReason" Grid.Row="4" Width="360" MinHeight="30" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"  SelectedIndex="0" FontSize="15" SelectionChanged="ComboBoxReason_SelectionChanged" >
        </ComboBox>

        <StackPanel  Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button  x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="130" MinHeight="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,10,0,0" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCancelText" Margin="8" Text="xCancel" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  x:Name="btnStopFocus" AutomationProperties.AutomationId="btnStopFocus"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True"   MinHeight="43" HorizontalContentAlignment="Center" Padding="0" Margin="15,10,0,0" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnStopFocus_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnStopFocusText" Margin="15,0,15,0" Text="xDeactivate Focus Block" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
        </Button>
        </StackPanel>
        <Border x:Name="GridShade" Grid.RowSpan="7"   CornerRadius="0"  Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" />

    </Grid>
 
</Window>
