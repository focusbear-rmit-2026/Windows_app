<Window x:Class="Focus_Bear.Focus.BlurWindow.BlurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus.BlurWindow"
        mc:Ignorable="d"
        Title="Focus Bear" Height="450" Width="800" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AutomationProperties.AutomationId="wndBlockBackdrop">

    <!-- The wash over the blurred app (Mac blockBlurVc). Not a layered window: DWM composites it (the frame is
         extended into the client area), so it is cheap to draw and every pixel of it takes the clicks. -->
    <Grid x:Name="Scrim" Background="#D1FFFFFF" />
</Window>
