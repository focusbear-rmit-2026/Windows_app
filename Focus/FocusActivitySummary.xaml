<src:FullScreenParent x:Class="Focus_Bear.Focus.FocusActivitySummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:src="clr-namespace:Focus_Bear.Habits"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        xmlns:Models="clr-namespace:Focus_Bear.Models"
        mc:Ignorable="d" 
        d:DesignHeight="1080" d:DesignWidth="1920"
        Title="Focus Bear" WindowState="Maximized" WindowStyle="None" Closed="Window_Closed" Closing="FullScreenParent_Closing" IsVisibleChanged="FullScreenParent_IsVisibleChanged">
    <src:FullScreenParent.Resources>
        <Style TargetType="ListViewItem">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex"  Value="0">
                    <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex"  Value="1">
                    <Setter Property="Background" Value="{DynamicResource FocusActivitySummaryBackgroundColor}" />
                </Trigger>
            </Style.Triggers>
            <Setter Property="Focusable" Value="false"/>
        </Style>

    </src:FullScreenParent.Resources>

    <Grid Background="{DynamicResource TabControlBackgroundColor}" x:Name="MainGrid">

        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*"   />
            <RowDefinition Height="200"  />
            <RowDefinition Height="300"  />
            <RowDefinition Height="*"  />

        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Row="0"  Margin="0,0,0,0" Height="150" Width="150" Models:ImageBehavior.AnimatedSource="../Images/gifs/random/1.gif"   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xYou have completed 2 Focus blocks today" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <Grid  Grid.Row="2" Width="1008" Name="GridSummarySimpleMode" >
            <Border  Grid.Row="1"  BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}">
                <StackPanel Orientation="Vertical">
                    <TextBlock  Name="TotalDistractingSitesBlocked" Margin="20,20,0,0" TextWrapping="NoWrap" Text="xTotal distracting sites blocked:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                    <TextBlock  Name="TimeSpentBlockingDistractingSites" Margin="20,20,0,0" TextWrapping="NoWrap" Text="xTime spent on super distracting sites:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                    <TextBlock  Name="TimeSpentBlockingActivated" Margin="20,20,0,0" TextWrapping="NoWrap" Text="xTime spent with blocking activated:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                    <TextBlock  Name="TimeSpentBlockingDeactivated" Margin="20,20,0,0" TextWrapping="NoWrap" Text="xTime spent with blocking deactivated:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                    
                    
                    
                </StackPanel>
            </Border>
        </Grid>
        
        <Grid  Grid.Row="2" Width="1008" Name="GridFocusSummary" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="25"  />
                <RowDefinition Height="140"  />
            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0"  Name="FocusSummaryTxt" Margin="2,0,0,0" TextWrapping="NoWrap" Text="xFocus Summary" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock  Grid.Row="0"  Name="TotalTime" Margin="0,0,2,0" TextWrapping="NoWrap" Text="xTotal Time"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Right"/>

            <Border  Grid.Row="1"  BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                          Direction="0"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </Border.Effect>
                <Grid  HorizontalAlignment="Left" >

                    <Grid.RowDefinitions>
                        <RowDefinition Height="23"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Width="1008"  Height="30" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="7,2" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="LightGray" />
                                <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                            </Style>
                        </Grid.Resources>
                        <Border Grid.Column="0" >
                            <TextBlock x:Name="FocusType" >xFocus Type</TextBlock>
                        </Border>
                        <Border Grid.Column="1">
                            <TextBlock x:Name="StartTime">xStart Time</TextBlock>
                        </Border>
                        <Border Grid.Column="2">
                            <TextBlock x:Name="DurationTxt">xDuration</TextBlock>
                        </Border>
                        <Border Grid.Column="3">
                            <TextBlock x:Name="Work">xWork Achieved</TextBlock>
                        </Border>
                        <Border Grid.Column="4">
                            <TextBlock x:Name="Distractions" >xDistractions</TextBlock>
                        </Border>

                    </Grid>
   
                </Grid>
            </Border >
            <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </Border.Effect>
                <ListView x:Name="ListFocusSummary" AlternationCount="2" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="#fff" BorderThickness="1" Foreground="{x:Null}"  >
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ItemHeader"    Margin="0,0,0,0" IsHitTestVisible="True"   >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding name, StringFormat=\{0\}}"  FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Column="1" Text="{Binding start_time, StringFormat=\{0\}}"   FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                                <TextBlock Grid.Column="2" Text="{Binding duration, StringFormat=\{0\}}"     FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                                <TextBlock Grid.Column="3" Text="{Binding achievements, StringFormat=\{0\}}" FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                                <TextBlock Grid.Column="4" Text="{Binding distractions, StringFormat=\{0\}}" FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Grid  Grid.Row="3" Width="1010"  Margin="0,50">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="175"  />
            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0"  Name="ActivitySummaryTxt" Margin="2,0,0,0" TextWrapping="NoWrap" Text="Activity Summary" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left"/>

            <StackPanel  Grid.Row="1" Orientation="Horizontal" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"  />
                        <RowDefinition Height="140"  />
                    </Grid.RowDefinitions>

                    <Border  Grid.Row="0"  BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="333" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2"
                              Direction="0"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                        </Border.Effect>
                        <Grid HorizontalAlignment="Left" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Width="1008"  Height="30" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="7,2" />
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="LightGray" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                                    </Style>
                                </Grid.Resources>
                                <Border Grid.Column="0">
                                    <TextBlock x:Name="Activity1" >xActivity</TextBlock>
                                </Border>
                                <Border Grid.Column="1">
                                    <TextBlock x:Name="Quantity">xSTotal Quantity88</TextBlock>
                                </Border>

                            </Grid>

                        </Grid>
                    </Border>
                    <Border  Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="333" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                        </Border.Effect>
                        <ListView x:Name="ListQuantity" AlternationCount="2" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="#fff" BorderThickness="1" Foreground="{x:Null}"  >

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="ItemHeader"    Margin="0,0,0,0" IsHitTestVisible="True"   >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding name, StringFormat=\{0\}}"     FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{Binding duration, StringFormat=\{0\}}" FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"  />
                        <RowDefinition Height="140"  />
                    </Grid.RowDefinitions>

                    <Border  Grid.Row="0"  BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="330" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2"
                              Direction="0"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                        </Border.Effect>
                        <Grid HorizontalAlignment="Left" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Width="1008"  Height="30" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="7,2" />
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="LightGray" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                                    </Style>
                                </Grid.Resources>
                                <Border Grid.Column="0">
                                    <TextBlock x:Name="Activity2" >xActivity</TextBlock>
                                </Border>
                                <Border Grid.Column="1">
                                    <TextBlock x:Name="Average">xAverage</TextBlock>
                                </Border>

                            </Grid>

                        </Grid>
                    </Border>
                    <Border  Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="330" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                        </Border.Effect>
                        <ListView x:Name="ListAverage" AlternationCount="2" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="#fff" BorderThickness="1" Foreground="{x:Null}"  >

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="ItemHeader"    Margin="0,0,0,0" IsHitTestVisible="True"   >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding name, StringFormat=\{0\}}"       FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{Binding duration, StringFormat=\{0\}}"   FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"  />
                        <RowDefinition Height="140"  />
                    </Grid.RowDefinitions>

                    <Border  Grid.Row="0"  BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="325" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2"
                              Direction="0"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
                        </Border.Effect>
                        <Grid HorizontalAlignment="Left" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Width="1008"  Height="30" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="7,2" />
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="LightGray" />
                                        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
                                    </Style>
                                </Grid.Resources>
                                <Border Grid.Column="0">
                                    <TextBlock x:Name="Activity3" >xActivity</TextBlock>
                                </Border>
                                <Border Grid.Column="1">
                                    <TextBlock x:Name="TotalDuration">xDuration</TextBlock>
                                </Border>

                            </Grid>

                        </Grid>
                    </Border>
                    <Border  Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Background="{DynamicResource BackgroundColor}" Width="325" Margin="0,0,10,0" >
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                        </Border.Effect>
                        <ListView x:Name="ListDuration" AlternationCount="2" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="#fff" BorderThickness="1" Foreground="{x:Null}"  >

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="ItemHeader"    Margin="0,0,0,0" IsHitTestVisible="True"   >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                               <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding name, StringFormat=\{0\}}"     FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{Binding duration, StringFormat=\{0\}}" FontSize="13" FontWeight="Normal"  VerticalAlignment="Center" Margin="0,0,7,0" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        
            <StackPanel Grid.Row="4" Orientation="Horizontal"   HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button  IsDefault="True" x:Name="btnNeedOneMinute"    Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Height="40" MinWidth="350"  HorizontalAlignment="Center" Padding="0" Margin="0,0,30,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNeedOneMinute_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                        <TextBlock x:Name="btnNeedOneMinuteTXT" Text="xI need One More Minute" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  IsDefault="True" x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" MinWidth="200"  HorizontalAlignment="Center"   Padding="0" Margin="30,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                        <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            
        </StackPanel>

        <Border x:Name="GridShade" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" />
        
    </Grid>
</src:FullScreenParent>
