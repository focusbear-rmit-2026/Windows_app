<Window x:Class="Focus_Bear.Focus.BreakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="Focus Bear" Height="145" Width="323" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Name="TopIcon" Grid.Column="0"  Margin="0,0,0,10" Height="64" Width="64" Source="../Images/FBicon-64.png"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Grid Grid.Column="1" x:Name="UseTimerRelated" Visibility="visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <TextBlock  Grid.Row="0" Name="Description" Margin="10,0,10,0" TextWrapping="Wrap" Text="xYour break ends in:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" x:Name="TxtTimer" Margin="0,0,0,0" TextWrapping="NoWrap" Text="05:00"  Padding="0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"  VerticalAlignment="Top" />
                <StackPanel x:Name="SkipPostponeSection" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="Skip" AutomationProperties.AutomationId="txtRefreshRequestUpdate" Grid.Row="4" Margin="0,0,20,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
                        <Hyperlink x:Name="btnSkip" Click="btnSkip_Click"   TextDecorations="Underline" ><Run x:Name="btnSkipTXT" Text="xSkip"/></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="Postpone" AutomationProperties.AutomationId="txtRefreshRequestUpdate" Grid.Row="4" Margin="20,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
                        <Hyperlink x:Name="btnPostpone" Click="btnPostpone_Click"   TextDecorations="Underline" ><Run x:Name="btnPostponeTXT" Text="xPostpone"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" x:Name="DoNotUseTimerRelated" Visibility="collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock  Grid.Row="0" Name="DescriptionNoTimer" Margin="10,0,10,0" TextWrapping="Wrap" Text="xDo xx Activity: " FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />

                <Button Grid.Row="1"  x:Name="btnIAmDone" AutomationProperties.AutomationId="btnIAmDone"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"    Height="25"  Width="180" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,20,5" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnIAmDone_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock x:Name="btnIAmDoneTXT" Text="xI'm Done!" Style="{DynamicResource ButtonTextBlockStyle}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
