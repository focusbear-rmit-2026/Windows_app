<UserControl x:Class="Focus_Bear.Focus.TabAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Focus_Bear.Focus"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800" AutomationProperties.AutomationId="TabAuditView"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid Background="{DynamicResource BackgroundColor}">
        <Grid.Resources>
            <!-- Icon button: soft rounded square on hover (matches the Back / cog buttons). -->
            <Style x:Key="IconHoverButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="hoverBg" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hoverBg" Property="Background" Value="#33808080"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,32" MaxWidth="640" HorizontalAlignment="Left" Background="Transparent">

                <TextBlock x:Name="Title" Text="Tab Audit" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundColor}"/>
                <TextBlock x:Name="Subtitle" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="15"
                           Foreground="{DynamicResource ForegroundGrey}"
                           Text="Focus Bear can extract all the open browser tabs you have and put them in a CSV so you can decide if you need them."/>

                <TextBlock x:Name="TabCountTitle" Margin="0,26,0,6" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundColor}" Text="Number of open tabs:"/>
                <TextBlock x:Name="TabCountPerBrowser" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Foreground="{DynamicResource ForegroundColor}" Text="…"/>

                <Button x:Name="BtnExtract" Style="{StaticResource BtnStyleLightOrangeBordered}" HorizontalAlignment="Left"
                        Margin="0,26,0,0" Cursor="Hand" Click="BtnExtract_Click">
                    <TextBlock x:Name="BtnExtractText" Text="Extract open tabs to CSV" Margin="18,8,18,8" FontSize="15" FontWeight="SemiBold" Foreground="Black"/>
                </Button>

                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource ForegroundGrey}" Visibility="Collapsed"/>

                <!-- Last-audit info (shown only when a saved report exists) -->
                <StackPanel x:Name="LastAuditPanel" Visibility="Collapsed" Margin="0,22,0,0" Background="Transparent">
                    <TextBlock x:Name="LastAuditDate" TextWrapping="Wrap" FontSize="14"
                               Foreground="{DynamicResource ForegroundGrey}"/>
                    <TextBlock x:Name="CsvPathLabel" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ForegroundGrey}"/>
                    <Button x:Name="BtnOpenSaved" Style="{StaticResource BtnStyleClearOrangeBordered}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Cursor="Hand" Click="BtnOpenSaved_Click">
                        <TextBlock x:Name="BtnOpenSavedText" Text="Open saved Tab Audit report" Margin="18,8,18,8" FontSize="15" FontWeight="SemiBold" Foreground="Black"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Post-extract popup (macOS parity): confirm + offer to set a max tab limit. -->
        <Border x:Name="PostAuditOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Background="{DynamicResource SoftCreamColor}" BorderBrush="{DynamicResource ForegroundGrey}" BorderThickness="1"
                    CornerRadius="10" Padding="26" MaxWidth="450" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Background="Transparent">
                    <TextBlock x:Name="PostTitle" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"
                               Text="Your tabs have been saved to the CSV file. You can safely close them now, since you have a reference stored."/>
                    <TextBlock x:Name="PostSetLimit" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource ForegroundGrey}"
                               Text="Set a tab limit so you don't get overwhelmed with tabs again"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PostMaxLabel" Text="Max tab limit:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource ForegroundColor}"/>
                        <Button x:Name="BtnLimitDown" Content="−" Style="{StaticResource IconHoverButton}" FontSize="17" Foreground="{DynamicResource ForegroundColor}" Click="BtnLimitDown_Click"/>
                        <TextBox x:Name="PostLimitInput" Width="56" Height="30" Margin="4,0,4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 Background="#FFFFFF" Foreground="#000000" FontSize="14" MaxLength="3" PreviewTextInput="PostLimitInput_PreviewTextInput"/>
                        <Button x:Name="BtnLimitUp" Content="+" Style="{StaticResource IconHoverButton}" FontSize="17" Foreground="{DynamicResource ForegroundColor}" Click="BtnLimitUp_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="BtnPostCancel" Style="{StaticResource BtnStyleClearOrangeBordered}" Cursor="Hand" Click="BtnPostCancel_Click">
                            <TextBlock x:Name="BtnPostCancelText" Text="Cancel" Margin="18,6,18,6" FontSize="14" FontWeight="SemiBold" Foreground="Black"/>
                        </Button>
                        <Button x:Name="BtnPostSave" Style="{StaticResource BtnStyleLightOrangeBordered}" Cursor="Hand" Margin="10,0,0,0" Click="BtnPostSave_Click">
                            <TextBlock x:Name="BtnPostSaveText" Text="Save" Margin="22,6,22,6" FontSize="14" FontWeight="SemiBold" Foreground="Black"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
