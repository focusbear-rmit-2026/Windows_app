<Window x:Class="Focus_Bear.Focus.FocusProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="FocusProgress" Height="80" Width="330" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None" Opacity="0.5" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseDown="Window_MouseDown" Closing="Window_Closing">
    <Border CornerRadius="15" BorderBrush="Black" BorderThickness="2" Padding="6" Background="#e88800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="30"></RowDefinition>
                <RowDefinition MinHeight="50"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Name="Focus"  Margin="10,0,0,0"   VerticalAlignment="Top"  Foreground="White" FontSize="14" FontWeight="Semibold" >xFocus</Label>
            <Button  Grid.Row="0" x:Name="btnClose" Content="Button" Style="{DynamicResource BtnStyleCloseRed}" SnapsToDevicePixels="True" HorizontalAlignment="Right" Height="22" VerticalAlignment="Top" Width="22" ToolTip="Close" Click="btnClose_Click"  Cursor="Hand"/>

            <TextBlock Grid.Row="1" Name="OnUntill" TextWrapping="Wrap" Visibility="Visible" Margin="15,0,0,0"   VerticalAlignment="Top" TextAlignment="Left" Foreground="White" FontSize="14"  >Time remaining: 19m 21s (On Until 10:26 PM)  </TextBlock>

        </Grid>
    </Border>
</Window>
