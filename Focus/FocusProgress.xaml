<Window x:Class="Focus_Bear.Focus.FocusProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d" d:DesignHeight="128" d:DesignWidth="330"
        Title="FocusProgress" Height="115" Width="330" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None" Opacity="0.5" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseDown="Window_MouseDown" Closing="Window_Closing" AutomationProperties.AutomationId="FocusProgress">
    <Border  x:Name="WindowBorder" CornerRadius="15" BorderBrush="Black" BorderThickness="2" Padding="6" Background="#e88800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="60"></RowDefinition>
                <RowDefinition MinHeight="25"></RowDefinition>
                <RowDefinition MinHeight="30"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" >
                <Image Name="TopIcon" ToolTip=""  Margin="10,0,10,0" Height="27" Width="27" Source="../Images/FBicon-64.png"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <!--<Label Grid.Row="0" Name="Focus"  Margin="5,0,0,0"   VerticalAlignment="Top"  Foreground="White" FontSize="14" FontWeight="Semibold" >xFocus</Label>-->
                <Viewbox Stretch="Uniform">
                    <Canvas Width="200" Height="200">
                        <!-- Gray background circle -->
                        <Ellipse Width="200" Height="200"
                         Stroke="LightGray" StrokeThickness="13" />

                        <!-- Blue progress arc -->
                        <Path x:Name="ProgressArc"
                      Stroke="DodgerBlue"
                      StrokeThickness="15"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>

                        <!-- Text in center — full-width TextBlock so centering works for any time string -->
                        <TextBlock x:Name="OnUntill"
                           FontSize="36" FontWeight="Bold" Foreground="White"
                           Width="200"
                           Canvas.Left="0" Canvas.Top="82"
                           Text="25m"
                           TextAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"/>
                    </Canvas>
                </Viewbox>

                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,20,0">
                    <Button x:Name="btnPauseResume"
                     AutomationProperties.AutomationId="btnPauseResumeSession"
                     Content="xPause"
                     Click="btnPauseResume_Click"
                     Style="{StaticResource BtnStyleLightOrange}" 
                     HorizontalAlignment="Right"
                     Cursor="Hand"
                     Margin="85,0,0,0" Grid.Row="1" Width="81" Height="30"/>

                    <TextBlock Name="txtEndSession" HorizontalAlignment="Center" Margin="85,4,0,0" ToolTip="Click to end the focus session early" AutomationProperties.AutomationId="txtEndSession">
                        <Hyperlink Name="lnkEndSession" AutomationProperties.AutomationId="lnkEndSession" Click="btnEndFocus_Click">
                            xEnd session
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                
            </StackPanel>

            <Button  Grid.Row="0" x:Name="btnClose" AutomationProperties.AutomationId="btnClose" Content="Button" AutomationProperties.Name="Close" Style="{DynamicResource BtnStyleCloseRed}" SnapsToDevicePixels="True" HorizontalAlignment="Right" Height="22" VerticalAlignment="Top" Width="22" ToolTip="Close" Click="btnClose_Click"  Cursor="Hand"/>

            <TextBlock Grid.Row="1" Name="Intention" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Visible" Margin="13,0,0,0" VerticalAlignment="Center" TextAlignment="Left" Foreground="White" FontSize="14">Intention:  </TextBlock>
            <TextBlock Grid.Row="2" Name="AlignmentScore"  Margin="13,0,0,0"   VerticalAlignment="Top"  Foreground="White" FontSize="14"  >xFocus score</TextBlock>
           
        </Grid>
    </Border>
</Window>
