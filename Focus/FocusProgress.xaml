<Window x:Class="Focus_Bear.Focus.FocusProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="FocusProgress" Height="80" Width="330" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None" Opacity="0.5" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseDown="Window_MouseDown" Closing="Window_Closing">
    <Border  x:Name="WindowBorder" CornerRadius="15" BorderBrush="Black" BorderThickness="2" Padding="6" Background="#e88800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="30"></RowDefinition>
                <RowDefinition MinHeight="30"></RowDefinition>
                 <RowDefinition MinHeight="30"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                <Image Name="TopIcon" ToolTip=""  Margin="10,0,0,0" Height="27" Width="27" Source="../Images/FBicon-64.png"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Label Grid.Row="0" Name="Focus"  Margin="5,0,0,0"   VerticalAlignment="Top"  Foreground="White" FontSize="14" FontWeight="Semibold" >xFocus</Label>
               
            </StackPanel>
            
            <Button  Grid.Row="0" x:Name="btnClose" Content="Button" Style="{DynamicResource BtnStyleCloseRed}" SnapsToDevicePixels="True" HorizontalAlignment="Right" Height="22" VerticalAlignment="Top" Width="22" ToolTip="Close" Click="btnClose_Click"  Cursor="Hand"/>

            <TextBlock Grid.Row="1" Name="OnUntill" TextWrapping="Wrap" Visibility="Visible" Margin="15,0,0,0"   VerticalAlignment="Top" TextAlignment="Left" Foreground="White" FontSize="14"  >Time remaining:  </TextBlock>
            <Label Grid.Row="2" Name="AlignmentScore"  Margin="13,0,0,0"   VerticalAlignment="Top"  Foreground="White" FontSize="14"  >xFocus score</Label>
            <Button Grid.Row="2"
        x:Name="btnEndFocus"
        Content="End Session"
        Click="btnEndFocus_Click"
        Width="90"
        Height="32"
        Margin="0,-1,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Cursor="Hand"
        FontSize="13"
        FontWeight="SemiBold"
        Background="#FFCC4C4C"
        Foreground="White"
        BorderThickness="0"
        Padding="8,4"
        ToolTip="Click to end the focus session early">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFB03030"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#FFA02020"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Border>
</Window>
