<Window x:Class="Focus_Bear.Focus.FocusProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="FocusProgress" Height="70" Width="330" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStyle="None" Opacity="0.5" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseDown="Window_MouseDown" Closing="Window_Closing">
    <Border CornerRadius="15" BorderBrush="Black" BorderThickness="2" Padding="6" Background="#e88800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Name="Focus"  Margin="10,0,0,0"  Height="25"  VerticalAlignment="Center"  Foreground="White" FontSize="14" FontFamily="Segoe UI Semibold" >xFocus</Label>
            <Button  Grid.Row="0" x:Name="btnClose" Content="Button" Style="{DynamicResource BtnStyleCloseRed}" SnapsToDevicePixels="True" HorizontalAlignment="Right" Height="22" VerticalAlignment="Top" Width="22" ToolTip="Close" Click="btnClose_Click"  Cursor="Hand"/>

            <Label Grid.Row="1" Name="OnUntill" Visibility="Visible"  Margin="10,0,0,0"  Height="30"  VerticalAlignment="Center"  Foreground="White" FontSize="14" FontFamily="Segoe UI" >Time remaining: 19m 21s (On Until 10:26 PM)</Label>

        </Grid>
    </Border>
</Window>
