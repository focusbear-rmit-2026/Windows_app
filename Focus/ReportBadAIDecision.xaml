<Window x:Class="Focus_Bear.Focus.ReportBadAIDecision"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Focus"
        mc:Ignorable="d"
        Title="Focus Bear" Height="303" Width="330" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Column="0"  Margin="0,10,0,10" Height="50" Width="50" Source="../Images/FBicon-64.png"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1" Name="Heading"  Margin="10,0,10,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="xReport bad AI blocking decision"  FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="2" x:Name="TxtWrong" Margin="20,5,0,0" TextWrapping="NoWrap" Text="What was wrong?" Padding="0" FontSize="13" FontWeight="Normal" HorizontalAlignment="Left"  VerticalAlignment="Center" />
        <TextBox  Grid.Row="3" Name="TxtWhatWasWrong" Margin="20,5,20,0" AutomationProperties.AutomationId="txtBoxWhatWasWrong" TextWrapping="Wrap" AcceptsReturn="True" Height="40"  VerticalAlignment="Center"  FontSize="13">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="3"
                              Direction="330"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="6"
                               />
            </TextBox.Effect>
            <TextBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.FocusVisualStyle>
        </TextBox>
        <CheckBox   Grid.Row="4" x:Name="ShareUrl" AutomationProperties.AutomationId="chkShareUrl"  Margin="20,5,20,0"   Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,-3,0,0" Checked="ShareUrl_Checked" Unchecked="ShareUrl_Unchecked">
            <TextBlock TextWrapping="Wrap" x:Name="ShareUrlText" FontSize="13"> xShare URL and focus intention with Focus Bear team</TextBlock>
        </CheckBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="20,5,20,0">
            <TextBlock TextWrapping="Wrap" x:Name="UrlText" FontSize="13" Margin="0,0,5,0" > xURL:</TextBlock>
            <TextBlock TextWrapping="Wrap" x:Name="UrlTextDesc" FontSize="12" Opacity="0.8"> https://</TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="20,5,20,0">
            <Button  x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Width="100" Height="30" HorizontalContentAlignment="Center" Padding="0" Margin="0,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnCancel_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCancelText" Margin="1" Text="xCancel" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button   x:Name="btnReportIssue" AutomationProperties.AutomationId="btnReportIssue" Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="160" Height="30" HorizontalContentAlignment="Center" Padding="0" Margin="10,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnReportIssue_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnReportIssueText" Margin="1" Text="xReport issue"  Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Window>
