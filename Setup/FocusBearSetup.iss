; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Focus Bear"
#define MyAppVersion "1.0.153"
#define MyAppPublisher "Focus Bear Pty Ltd"
#define MyAppURL "https://www.focusbear.io"
#define MyAppExeName "Focus Bear.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{545770B9-0A3B-4964-A696-CAA46E0F0048}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultGroupName={#MyAppName}
DefaultDirName={pf}\{#MyAppName}
DisableDirPage=yes
DisableProgramGroupPage=yes
AlwaysUsePersonalGroup=yes
OutputBaseFilename=FocusBearSetup{#MyAppVersion}
Compression=lzma/ultra64
InternalCompressLevel=ultra64
SolidCompression=yes
WizardImageFile=Left.bmp
WizardSmallImageFile=top.bmp
DisableWelcomePage=no
DisableFinishedPage=yes
DisableReadyPage=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName}
SignedUninstaller=true
SetupIconFile="focus-bear.ico"

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"; LicenseFile: "license-en.rtf"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"; LicenseFile: "license-es.rtf"
 
[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

