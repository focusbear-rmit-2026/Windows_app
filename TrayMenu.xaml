<Window x:Class="Focus_Bear.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="TrayMenu" Height="auto"  MinWidth="330"  Width="330" MaxWidth="330" WindowStyle="None" Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource rowContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border  x:Name="IconBorder" Background="{x:Null}" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Black" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Black" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="Auto" MinHeight="35" />
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto" MinHeight="30" />

        </Grid.RowDefinitions>

        <Rectangle  Grid.Row="0" Height="70" Margin="14,8,14,7"  Fill="#ffe4c6"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
        <Image Grid.Row="0" HorizontalAlignment="Center" Height="40"  Width="250" Margin="0,0,0,0" Source="Images/fb.png" Stretch="None" VerticalAlignment="Center" Grid.ColumnSpan="2"  />

        <StackPanel  Grid.Row="1" Orientation="Vertical" Grid.ColumnSpan="2">


            <Button   x:Name="btnReactivate"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnReactivate_Click" Visibility="Collapsed">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Margin="8" Name="Reactivate">xReactivate</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button   x:Name="btnResumeHabits"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnResumeHabits_Click" Visibility="Collapsed">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Margin="8" Name="btnResumeHabitsTxt">xResume Habits</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
            
            <Button   x:Name="btnSettings"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnSettings_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="24"  Height="24" Source="images/preferences.png"  RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="Preferences">xPreferences</TextBlock>
                    </StackPanel>
                </Button.Content>

            </Button>
            <StackPanel   Height="50" Orientation="Horizontal">
                <Label   x:Name="lblOfficeMode"  Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" >xWFH Mode Enabledsdsdsd</Label>
                <ToggleButton x:Name="btnOfficeMode"  Style="{DynamicResource MacStyleToggleSwitch}"    Height="20" Width="52" Margin="15,0,0,0" HorizontalAlignment="Right"  Click="OfficeModeButton_Click"  Cursor="Hand" Focusable="False"/>

            </StackPanel>
        </StackPanel>

        <Rectangle  Grid.Row="2" Height="auto"   Margin="14,7"  Fill="#ffe4c6"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
        <Border  Grid.Row="2" x:Name="OrangeHeader" BorderThickness="1"   VerticalAlignment="Top"  Margin="14,0" Height="25" CornerRadius="7,7,0,0" BorderBrush="#e88800" Background="#e88800" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Row="2" Orientation="Vertical" Grid.ColumnSpan="2">
            <Label   Grid.Row="2" Name="Focus"  Margin="20,-3,0,0"  Height="25"  VerticalAlignment="Top"  Foreground="White" FontSize="14" FontFamily="Segoe UI Semibold" >xFocus</Label>
            <Label   Grid.Row="2" Name="OnUntill" Visibility="Collapsed"  Margin="20,-2,0,0"  Height="25"  VerticalAlignment="Top"  Foreground="White" FontSize="11" FontFamily="Segoe UI" >On Untill</Label>

            <ListView  MaxHeight="240"    Margin="13,5,16,10" x:Name="ListFocusModes"   VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ListViewItemStyle}" Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" SelectionChanged="ListFocusModes_SelectionChanged" >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ItemHeader"  Height="40"  Background="Transparent"  Margin="10,0,10,0" IsHitTestVisible="True" Cursor="Hand" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{Binding color, StringFormat=\{0\}}" Width="25" Height="25" RadiusX="4" RadiusY="4"></Rectangle>
                            <Image x:Name="imgPlayStop" Height="13" Width="13" HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="0,0,0,0" >
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOn}" Value="True">
                                                <Setter Property="Source" Value="images/stop_icon.png"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isOn}" Value="False">
                                                <Setter Property="Source" Value="images/play_icon.png"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <TextBlock Grid.Column="1" Text="{Binding name, StringFormat=\{0\}}" Foreground="#000"  FontSize="13" FontFamily="Segoe UI Semibold" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        </Grid>
                    </DataTemplate>

                    <!--<DataTemplate>
                    <Grid x:Name="ItemHeader" Height="35"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        -->
                    <!--<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkNavItemSelect" Cursor="Hand" IsChecked="{Binding Status}" Width="30" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle}" Click="ChkNavItemSelect_Click" />
                                    </StackPanel>-->
                    <!--
                        <Image Height="28" Width="28" Grid.Column="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="15,0,0,0" Source="images/fbicon-64.png"/>
                        <TextBlock Grid.Column="1" Text="{Binding name, StringFormat=\{0\}}" Foreground="#000"  FontSize="13" Cursor="Hand" FontFamily="Segoe UI Semibold" VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding NavItemsFound, StringFormat=\{0\} items}" FontSize="12" Foreground="#FFA6A6A6" VerticalAlignment="Center" Margin="0,0,15,0" HorizontalAlignment="Right" >
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                         </Grid>
                </DataTemplate>-->
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
            <Button   x:Name="btnBrainDump"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnBrainDump_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                       
                        <TextBlock Margin="8" Name="btnBrainDumpTXT">xBrain Dump</TextBlock>
                    </StackPanel>
                </Button.Content>

            </Button>
            
            <Button   x:Name="btnStartPomodoroMode"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnStartPomodoroMode_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="24"  Height="24" Source="images/start-pomodoro.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="PomodoroMode">xStart Pomodoro Mode</TextBlock>
                    </StackPanel>
                </Button.Content>

            </Button>

            <Button   x:Name="btnQuit" Click="btnQuit_Click"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800" Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Margin="10" Name="Quit">xQuit</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button   x:Name="btnUpgradeNow"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Foreground="#e88800"  Height="55" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnUpgradeNow_Click">
                <Button.Content>
                    <StackPanel  Orientation="Vertical">
                        <TextBlock Margin="8,8,2,8" Name="UpgradeNow">xUpgrade Now</TextBlock>
                        <TextBlock Margin="8,-5,0,6" Name="TrialInfo"  FontSize="12" Cursor="Hand" FontFamily="Segoe UI">xTrial Version - 27 of 31 days remaining</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>

</Window>
