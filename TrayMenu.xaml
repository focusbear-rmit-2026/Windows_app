<Window x:Class="Focus_Bear.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="Focus Bear" AutomationProperties.AutomationId="TrayMenu" Height="auto"  MinWidth="330"  Width="330" MaxWidth="330" WindowStyle="None" Deactivated="Window_Deactivated" >
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource rowContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border  x:Name="IconBorder" Background="{x:Null}" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"  Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Black" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="IconBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Black" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="{Binding isShowAbleInTrayMenuList, Converter={StaticResource BoolToVis}}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="Auto" MinHeight="35" />
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="Auto" MinHeight="30" />

        </Grid.RowDefinitions>
        
        <Rectangle  Grid.Row="0" Height="70" Margin="14,8,14,7"  Fill="#ffe4c6"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
        <Image Grid.Row="0" HorizontalAlignment="Center" Height="40"  Width="250" Margin="0,0,0,0" Source="Images/fb.png" Stretch="None" VerticalAlignment="Center" Grid.ColumnSpan="2"  />

        <StackPanel  Grid.Row="1" Orientation="Vertical" Grid.ColumnSpan="2">
            <TextBlock   Name="AlignmentScoreText"  Margin="15,10,0,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Visibility="Collapsed" Foreground="#e88800">xFocus alignment score =</TextBlock>
            <StackPanel    Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0,10,0,10" >
                <RadioButton x:Name="GeekMode" AutomationProperties.AutomationId="rbGeekMode" Content="xGeek Mode" Style="{StaticResource SegmentRadioButtonStyle}"     Cursor="Hand"  />
                <RadioButton x:Name="SimpleMode" AutomationProperties.AutomationId="rbSimpleMode" Content="xSimple Mode" Style="{StaticResource SegmentRadioButtonStyle}"   Cursor="Hand"  />
            </StackPanel>

            <Button   x:Name="btnReactivate" AutomationProperties.AutomationId="btnReactivate" Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True"   Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnReactivate_Click" Visibility="Collapsed">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Margin="8" Name="Reactivate">xReactivate</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button   x:Name="btnResumeHabits" AutomationProperties.AutomationId="btnResumeHabits" Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True"   Height="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnResumeHabits_Click" Visibility="Collapsed">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="23"  Height="23" Source="images/play_circle.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="btnResumeHabitsTxt">xResume Habits</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button   x:Name="btnSettings" AutomationProperties.AutomationId="btnSettings"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True"  MinHeight="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnSettings_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="24"  Height="24" Source="images/preferences.png"  RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="Preferences">xPreferences</TextBlock>
                    </StackPanel>
                </Button.Content>

            </Button>
            <!--<StackPanel   Height="50" Orientation="Horizontal">
                <Label   x:Name="lblOfficeMode"  Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" >xWFH Mode Enabledsdsdsd</Label>
                <ToggleButton x:Name="btnOfficeMode"  Style="{DynamicResource MacStyleToggleSwitch}"    Height="20" Width="52" Margin="15,0,0,0" HorizontalAlignment="Right"  Click="OfficeModeButton_Click"  Cursor="Hand" Focusable="False"/>

            </StackPanel>-->
            <StackPanel Orientation="Horizontal" Name="LimitedBlockingSection" Visibility="Collapsed">
                <TextBlock   Name="LimitedBlocking"  Margin="20,10,0,5" FontSize="14" Cursor="Hand" Foreground="{DynamicResource ForegroundColor}" FontWeight="Semibold" Visibility="Visible">xLimited Blocking</TextBlock>
                <Image Name="LimitedBlockingInfo" Source="{DynamicResource InfoImage}" Width="20"  Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Cursor="Hand"></Image>

                <Button x:Name="btnLimitedBlockingEdit" AutomationProperties.AutomationId="btnLimitedBlockingEdit" Margin="10,6,0,0" Style="{StaticResource BtnStyleInfo}" Click="btnLimitedBlockingEdit_Click" MinWidth="18" Height="18" Cursor="Hand" >
                    <StackPanel Orientation="Vertical">
                        <Image Name="LimitedBlockingEdit" Source="images/edit.png" Margin="0,0,0,0" Height="18" Width="18" />
                    </StackPanel>
                </Button>
                
            </StackPanel>
            <StackPanel Name="OfficeModeSection"  Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0,10,0,10" >
                <RadioButton x:Name="OfficeMode" AutomationProperties.AutomationId="rbOfficeMode" Content="xOffice Mode" Style="{StaticResource SegmentRadioButtonStyle}"   Checked="OfficeMode_Checked" Cursor="Hand"  />
                <RadioButton x:Name="WFHMode" AutomationProperties.AutomationId="rbWFHMode" Content="xWFH Mode" Style="{StaticResource SegmentRadioButtonStyle}"  Checked="WFHMode_Checked" Cursor="Hand"  />
            </StackPanel>
        </StackPanel>

        <Grid Name="FocusSection"  Grid.Row="2"   Grid.ColumnSpan="2" Visibility="Collapsed">
        <Rectangle  Grid.Row="2" Height="auto"   Margin="14,7"  Fill="#ffe4c6"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
        <Border  Grid.Row="2" x:Name="OrangeHeader" BorderThickness="1"   VerticalAlignment="Top"  Margin="14,0" Height="25" CornerRadius="7,7,0,0" BorderBrush="#e88800" Background="#e88800" Grid.ColumnSpan="2"/>
        <StackPanel  Grid.Row="2" Orientation="Vertical" Grid.ColumnSpan="2">
            <Label   Grid.Row="2" Name="Focus"  Margin="20,-3,0,0"  MinHeight="25"  VerticalAlignment="Top"  Foreground="White" FontSize="14" FontWeight="Semibold" >xFocus</Label>
            <Label   Grid.Row="2" Name="OnUntill" Visibility="Collapsed"  Margin="20,-2,0,0"  MinHeight="25"  VerticalAlignment="Top"  Foreground="White" FontSize="11"  >On Untill</Label>

            <ListView  MaxHeight="240"    Margin="13,5,16,10" x:Name="ListFocusModes" AutomationProperties.AutomationId="lvFocusModes"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ListViewItemStyle}" Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" SelectionChanged="ListFocusModes_SelectionChanged" >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        
                        <Grid x:Name="ItemHeader"  Height="40"    Margin="10,0,10,0" IsHitTestVisible="True" Cursor="Hand" >
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isOn}" Value="True">
                                            <Setter Property="Background" Value="Cornsilk" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding isOn}" Value="False">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{Binding color, StringFormat=\{0\}}" Width="25" Height="25" RadiusX="4" RadiusY="4"></Rectangle>
                            <Image x:Name="imgPlayStop" Height="13" Width="13" HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="0,0,0,0" >
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOn}" Value="True">
                                                <Setter Property="Source" Value="images/stop_icon.png"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isOn}" Value="False">
                                                <Setter Property="Source" Value="images/play_icon.png"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <TextBlock Grid.Column="1" Text="{Binding name, StringFormat=\{0\}}"  FontSize="13" FontWeight="Semibold" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding isOn}" Value="True">
                                                <Setter Property="Foreground" Value="#e88800"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isOn}" Value="False">
                                                <Setter Property="Foreground" Value="#000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                   
                </ListView.ItemTemplate>
            </ListView>
            
        </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">

            <Border  x:Name="BlockingScheduleSection" Visibility="Collapsed" BorderThickness="1"   VerticalAlignment="Top"  Margin="14,10,14,14" CornerRadius="5,5,5,5" BorderBrush="Gray"  Grid.ColumnSpan="2">
                <StackPanel  Orientation="Vertical" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BlockingScheduleText"
                             Grid.Column="0"
                             Margin="15,10,10,5"
                             FontSize="14"
                             Cursor="Hand"
                             FontWeight="Semibold"
                             Foreground="{DynamicResource ForegroundColor}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis">xBlocking Schedule</TextBlock>

                        <ToggleButton x:Name="btnPauseBlockingSchedule"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="tglbtnPauseBlockingSchedule"
                            Style="{DynamicResource MacStyleToggleSwitch}"
                            Margin="0,3,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Focusable="True"
                            Checked="btnPauseBlockingSchedule_Checked"
                            Unchecked="btnPauseBlockingSchedule_Unchecked"/>

                        <TextBlock x:Name="BlockingScheduleState"
                             Grid.Column="2"
                             Margin="8,10,15,5"
                             FontSize="14"
                             Cursor="Hand"
                             FontWeight="Semibold"
                             Foreground="{DynamicResource ForegroundColor}">xActive</TextBlock>
                    </Grid>
                    
                    <TextBlock   Name="BlockingScheduleName"  Margin="15,5,0,5" FontSize="14"  FontWeight="Semibold" Foreground="{DynamicResource ForegroundColor}" >xBlocking Schedule Name</TextBlock>
                    <TextBlock   Name="BlockingScheduleTime"  Margin="15,5,0,5" FontSize="12"  FontWeight="Normal" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ForegroundColor}" >xBlocking Schedule Time </TextBlock>
                </StackPanel>
            </Border>
   

            <Button   x:Name="btnStartPomodoroMode" AutomationProperties.AutomationId="btnStartPomodoroMode"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True"   MinHeight="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnStartPomodoroMode_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="24"  Height="24" Source="images/start-pomodoro.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="PomodoroMode">xStart Focus Session</TextBlock>
                    </StackPanel>
                </Button.Content>

            </Button>
            <Button   x:Name="btnStopPomodoroMode" AutomationProperties.AutomationId="btnStopPomodoroMode" Visibility="Collapsed"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True"   MinHeight="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click='btnStopPomodoroMode_Click'>
                <Button.ContextMenu>
                    <ContextMenu x:Name="FocusSessionContextMenu">
                        <MenuItem x:Name="PauseResumeFocusMenuItem">
                            <MenuItem.Icon>
                                <Image Width="16" Height="16" Source="pack://application:,,,/Focus Bear;component/images/pause_icon.png" />
                            </MenuItem.Icon>
                            <MenuItem.Header>xPause Focus Session</MenuItem.Header>
                        </MenuItem>

                        <MenuItem x:Name="StopFocusSessionMenuItem">
                            <MenuItem.Icon>
                                <Image Width="16" Height="16" Source="pack://application:,,,/Focus Bear;component/images/stop_icon.png" />
                            </MenuItem.Icon>
                            <MenuItem.Header>xStop Focus Session</MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>

                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image x:Name="StopPomodoroModeMainIcon" Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="24"  Height="24" Source="images/start-pomodoro.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="8" Name="btnStopPomodoroModetxt">xStop Focus Session</TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Grid Name="ToolsSection"  Grid.Row="2"   Grid.ColumnSpan="2" Visibility="Visible">
                <Rectangle  Grid.Row="2" Height="auto"   Margin="14,7"  Fill="#ffe4c6"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
                <Border  Grid.Row="2" BorderThickness="1"   VerticalAlignment="Top"  Margin="14,0" Height="25" CornerRadius="7,7,0,0" BorderBrush="#e88800" Background="#e88800" Grid.ColumnSpan="2">
                    <TextBlock Name="Tools" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">xTools ></TextBlock>
                </Border>
                <StackPanel  Grid.Row="2" Orientation="Horizontal" Height="70" Margin="15,0,0,0" Grid.ColumnSpan="2">
                   
                    <Button x:Name="btnPlayPauseMusic" AutomationProperties.AutomationId="btnPlayPauseMusic" Margin="9,17,0,0"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Width="25"  Height="25" HorizontalContentAlignment="Left" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnPlayPauseMusic_Click" Visibility="Collapsed">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Margin="3,6,3,3" Name="PlayPauseButtonImage" Height="20"  Width="20" Source="Images/pause_icon.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button   x:Name="btnBrainDump" AutomationProperties.AutomationId="btnBrainDump" Margin="6,17,0,0"  Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Width="25"  Height="25" HorizontalContentAlignment="Left" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnBrainDump_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Margin="3" Width="23"  Height="23" Source="images/brainDump.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>

                    </Button>
                    <Button   x:Name="btnToDoPlayer" AutomationProperties.AutomationId="btnToDoPlayer" Margin="13,17,0,0" Visibility="Visible"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Width="25"  Height="25" HorizontalContentAlignment="Left" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnToDoPlayer_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Margin="3" Width="23"  Height="23" Source="images/validIcon.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button   x:Name="btnFocusMusic" AutomationProperties.AutomationId="btnFocusMusic" Margin="13,17,0,0" Visibility="Visible"   Style="{StaticResource BtnStyleLightOrange}" IsEnabled="True" Width="25"  Height="25" HorizontalContentAlignment="Left" Padding="0" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnFocusMusic_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Margin="3" Width="23"  Height="23" Source="images/music_albums_fill.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    
                </StackPanel>
            </Grid>

            <Button   x:Name="btnQuit" AutomationProperties.AutomationId="btnQuit" Click="btnQuit_Click"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   MinHeight="35" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,2,0,0" Width="23"  Height="23" Source="images/pausecircle.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Margin="10" Name="Quit">xQuit</TextBlock>
                    </StackPanel>
                    
                </Button.Content>
            </Button>
            <Button   x:Name="btnUpgradeNow" AutomationProperties.AutomationId="btnUpgradeNow"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   MinHeight="55" HorizontalContentAlignment="Left" Padding="0" Margin="14,7" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnUpgradeNow_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Grid.ColumnSpan="2"  Margin="10,7,0,0" Width="23"  Height="23" Source="images/upgrade.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <StackPanel  Orientation="Vertical">
                            <TextBlock Margin="8,8,2,8" Name="UpgradeNow">xUpgrade Now</TextBlock>
                            <TextBlock Margin="8,-5,0,6" Width="240" Name="TrialInfo"  FontSize="12" Cursor="Hand" TextWrapping="Wrap">xTrial Version - 27 of 31 days remaining</TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>

</Window>
