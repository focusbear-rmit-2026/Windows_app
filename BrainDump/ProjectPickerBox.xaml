<UserControl x:Class="Focus_Bear.BrainDump.ProjectPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34">
    <UserControl.Resources>
        <!-- ListBoxItem twin of the app's RoundedComboBoxItemStyle. -->
        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffe4c6"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e88800"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Transparent Grids: the app's implicit Grid style paints the page colour, a square patch inside the rounded frame. -->
    <Grid Background="Transparent">
        <Border x:Name="Frame" Background="{DynamicResource TextBoxBackgroundColor}" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="👥" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <Button x:Name="btnClear" DockPanel.Dock="Right" Content="✕" Width="20" Height="20" FontSize="9" Margin="0,0,7,0" Focusable="False" Cursor="Hand" Visibility="Collapsed" Click="btnClear_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Circle" Background="{DynamicResource TrayCircleBtnBg}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource TrayCircleBtnHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Grid Background="Transparent">
                    <TextBox x:Name="txtQuery" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ForegroundColor}" CaretBrush="{DynamicResource ForegroundColor}"
                             VerticalContentAlignment="Center" FontSize="13" TextChanged="txtQuery_TextChanged" GotKeyboardFocus="txtQuery_GotKeyboardFocus"
                             LostKeyboardFocus="txtQuery_LostKeyboardFocus" PreviewKeyDown="txtQuery_PreviewKeyDown"/>
                    <TextBlock x:Name="lblPlaceholder" Foreground="{DynamicResource TraySubtitleColor}" FontSize="13" VerticalAlignment="Center" Margin="3,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
        <Popup x:Name="Suggestions" PlacementTarget="{Binding ElementName=Frame}" Placement="Bottom" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource TextBoxBackgroundColor}" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8"
                    MinWidth="{Binding ActualWidth, ElementName=Frame}" MaxHeight="280" Margin="0,4,0,0">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                <ListBox x:Name="lbSuggestions" BorderThickness="0" Background="Transparent" Margin="4" Focusable="False" ItemContainerStyle="{StaticResource PickerItemStyle}"
                         Foreground="{DynamicResource ForegroundColor}" PreviewMouseLeftButtonUp="lbSuggestions_PreviewMouseLeftButtonUp"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
