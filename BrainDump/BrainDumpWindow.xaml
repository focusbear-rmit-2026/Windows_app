<Window x:Class="Focus_Bear.BrainDump.BrainDumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.BrainDump"
        mc:Ignorable="d"
        Title="Focus Bear" Height="457" Width="315" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="20,20,20,5" >
            <TextBlock   Name="DumpDown" Margin="0,0,0,5"   TextWrapping="Wrap" Text="xxDump down ideas you have so you don't forget - anything you write here will remain forever unless you delete it." Foreground="#272727" FontSize="14" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Left"/>
        </StackPanel>
        <TextBox Grid.Row="1" Margin="20,0,20,10"   Name="TxtDumpDown" TextWrapping="Wrap" AcceptsReturn="True"   FontSize="14" VerticalAlignment="Stretch"  VerticalScrollBarVisibility="Auto" >
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
            </TextBox.Effect>
            <TextBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.FocusVisualStyle>
        </TextBox>

        <Button  Grid.Row="2" x:Name="btnSave"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="24" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,10" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnSave_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnSaveTXT" Text="xSave"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Window>
