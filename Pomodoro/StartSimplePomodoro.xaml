<UserControl x:Class="Focus_Bear.Pomodoro.StartSimplePomodoro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Pomodoro"
        mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xPomodoro Time" Foreground="#e88800" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="2"  Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock  Name="HowMuchTime" Text="xFocus duration" Margin="10,0,10,0" TextWrapping="Wrap"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" />
                    <TextBox      x:Name="Minutes" AutomationProperties.AutomationId="txtBoxMinutes"  MinHeight="25"  Width="35" Margin="0"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="Minutes_PreviewTextInput" PreviewKeyDown="Minutes_PreviewKeyDown" PreviewKeyUp="Minutes_PreviewKeyUp" TextChanged="Minutes_TextChanged">
                        <TextBox.Effect>
                            <DropShadowEffect ShadowDepth="3"
                                  Direction="330"
                                  Color="Gray"
                                  Opacity="0.5"
                                  BlurRadius="6"
                                   />
                        </TextBox.Effect>
                        <TextBox.FocusVisualStyle>
                            <Style>
                                <Setter Property="Control.Template">
                                    <Setter.Value>
                                        <ControlTemplate/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.FocusVisualStyle>
                    </TextBox>
                    <TextBlock  Name="MinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Image x:Name="FocusDurationInfo" Source="../images/info-dark.png" Width="20"  Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Cursor="Hand"/>
                </StackPanel>

                <Expander Grid.Row="3" x:Name="MoreOptionsExpander" Padding="0" Width="600" Margin="0,20,0,0" HorizontalAlignment="Stretch" Cursor="Hand" Style="{StaticResource PomodoroOptionsExpanderStyle}">
                    <Expander.Header>
                        <TextBlock FontSize="14" Padding="20,0,0,0" Width="600" FontWeight="Normal" TextAlignment="Left"/>
                    </Expander.Header>

                    <StackPanel x:Name="MoreOptionsContent" Margin="0,8,0,0">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock  Name="BreakDuration" Margin="0,0,0,0" TextWrapping="Wrap" Width="120" Text="xBreak duration:"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

                            <TextBox x:Name="MinutesBreak" AutomationProperties.AutomationId="txtBoxMinutesBrak" MinHeight="25"  Width="35" Margin="0"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Center" HorizontalAlignment="Center" MaxLines="1" PreviewTextInput="Minutes_PreviewTextInput" PreviewKeyDown="Minutes_PreviewKeyDown" PreviewKeyUp="Minutes_PreviewKeyUp" TextChanged="Minutes_TextChanged">
                                <TextBox.Effect>
                                    <DropShadowEffect ShadowDepth="3"
                                  Direction="330"
                                  Color="Gray"
                                  Opacity="0.5"
                                  BlurRadius="6"
                                   />
                                </TextBox.Effect>
                                <TextBox.FocusVisualStyle>
                                    <Style>
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.FocusVisualStyle>
                            </TextBox>
                            <TextBlock  Name="MinutesBreakTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <Image x:Name="BreakDurationInfo" Source="../images/info-dark.png" Width="20"  Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Width="420" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock  x:Name="BlockingStyle" Visibility="Visible" Width="105"  Margin="0,0,0,0" TextWrapping="Wrap" Text="xBlocking Style:"  FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Vertical"  HorizontalAlignment="Left" VerticalAlignment="Top"  >
                                <RadioButton  Name="RadioAI" AutomationProperties.AutomationId="rbAI" Margin="10,5,0,0" GroupName="BlockingStyle"  FontSize="15"  FontWeight="Normal" Padding="5,-5,0,0" Cursor="Hand" Checked="RadioAI_Checked"  >
                                    xAI powered blocking (recommended)
                                </RadioButton>
                                <RadioButton Name="RadioSuperDistracting" AutomationProperties.AutomationId="rbSuperDistracting" Margin="10,12,0,0" GroupName="BlockingStyle"  FontSize="15" FontWeight="Normal" Padding="5,-5,0,0" Cursor="Hand"  Checked="RadioSuperDistracting_Checked" >
                                    xJust block super distracting sites
                                </RadioButton>
                            </StackPanel>
                            <Image x:Name="AIPoweredBlockingInfo" Source="../images/info-dark.png" Width="20"  Margin="10,2,0,0" VerticalAlignment="Top" Cursor="Hand"/>

                        </StackPanel>

                        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,20,0,0">
                            <Grid>
                                <TextBlock  Name="WhatPlan" Visibility="Visible"  Margin="0,0,0,0" TextWrapping="Wrap" Text="xxWhat do you plan to achieve during this focus block?" FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                                <Image x:Name="IntentionInfo" Source="../images/info-dark.png" Width="20"  Margin="0,0,90,0" VerticalAlignment="Top" HorizontalAlignment="Right" RenderTransformOrigin="0.55,0.512" Cursor="Hand"/>
                            </Grid>
                            <TextBox   Name="TxtIntention" AutomationProperties.AutomationId="txtBoxIntention" Visibility="Visible"  TextWrapping="Wrap" AcceptsReturn="True"  Width="550" Height="80" Margin="15" VerticalAlignment="Top"  FontSize="15" TextChanged="TxtIntention_TextChanged">
                                <TextBox.Effect>
                                    <DropShadowEffect ShadowDepth="3"
                                      Direction="330"
                                      Color="Gray"
                                      Opacity="0.5"
                                      BlurRadius="6"
                                    />
                                </TextBox.Effect>
                                <TextBox.FocusVisualStyle>
                                    <Style>
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.FocusVisualStyle>
                            </TextBox>


                        </StackPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Visibility="Collapsed" Grid.Row="5" Name="TimeUnfocusedText" FontSize="15" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Text="xxTime spent unfocused: [TIME]" />

                <!-- Outer columns are equal "*" so the button (Auto column) always centers exactly where it did before - the banner lives in the right column and never shifts the button when shown or hidden -->
                <Grid Grid.Row="6" Margin="0,10,0,50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button  Grid.Column="1" x:Name="btnStartSession" AutomationProperties.AutomationId="btnStartSession"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True"  Width="300" Height="45" HorizontalContentAlignment="Center" Padding="0" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnStartSession_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Name="btnStartSessionText" Margin="8" Text="xStart Session" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Border x:Name="BlockingScheduleBanner" Grid.Column="2" AutomationProperties.AutomationId="bannerBlockingScheduleWarning" Background="LightGoldenrodYellow" BorderBrush="Orange" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Padding="12,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;" FontSize="16" Foreground="#856404" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock x:Name="BlockingScheduleBannerText" TextWrapping="Wrap" FontWeight="Bold" FontSize="13" Foreground="#856404" MaxWidth="200"/>
                        </StackPanel>
                    </Border>
                </Grid>
        
                <Border x:Name="GridShade" Grid.RowSpan="13"   CornerRadius="0"  Margin="0,0,0,0" Background="#060606" Opacity="0.65"   Visibility="Collapsed" />

                <!-- Define the Popup -->
                <Popup x:Name="MyPopup"
                       AutomationProperties.AutomationId="popupStartPomodoroMode"
                       Placement="Left" 
                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                       HorizontalOffset="100" 
                       VerticalOffset="-120"
                       StaysOpen="True" 
                       AllowsTransparency="True" Panel.ZIndex="-6">
                    <Grid Width="287" Height="auto"  Background="{x:Null}">
               
                        <!-- Popup Content -->
                        <Border Background="LightGoldenrodYellow" Width="250" BorderBrush="Orange" BorderThickness="1" Margin="0,0,0,0" CornerRadius="7">
                            <Grid x:Name="GridPopup" Width="250" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="70" />
                                    <RowDefinition Height="Auto" MinHeight="30" />
                                    <RowDefinition Height="Auto" MinHeight="35" />
                                    <RowDefinition Height="Auto" MinHeight="25" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.RowSpan="6" Height="auto" Fill="LightGoldenrodYellow" HorizontalAlignment="Right"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
                                <Image Name="Logo" Grid.Row="0"   Width="40"  Margin="20,20,0,0"  Source="../Images/fbicon-64.png"   VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock Name="HeadingPopup" Grid.Row="0"   Margin="70,30,0,0"    VerticalAlignment="Top"   FontSize="14" FontWeight="Semibold" >xStart Pomodoro Mode</TextBlock>
                                <TextBlock Name="Title" Grid.Row="1"   Margin="20,20,0,0"     VerticalAlignment="Top"   FontSize="14" FontWeight="Semibold" >Pomodoro Time</TextBlock>
                                <TextBlock Name="Description" Grid.Row="2" TextWrapping="Wrap"  Margin="20,20,20,0"   VerticalAlignment="Top"   FontSize="14" FontFamily="Segoe UI" >xThe Pomodoro technique works well for many ADHDers. You do 25 minutes of work (could be shorter or longer) and then have a 5 minute break. Click on the (i) to learn more about how it works."</TextBlock>
                                <Grid Grid.Row="4" Background="LightGray" ></Grid>
                                <Grid Grid.Row="5" >
                                    <TextBlock Name="Steps" TextWrapping="Wrap"  Margin="20,0,20,0"  VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI" >x1 of 3</TextBlock>
                                    <Button  x:Name="btnNextPopup" AutomationProperties.AutomationId="btnNextPopup" Width="auto" HorizontalAlignment="Right"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="26"  VerticalAlignment="Center"  Margin="0,0,20,0" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnNextPopup_Click" >
                                        <Button.Content>
                                            <StackPanel  Orientation="Horizontal">
                                                <TextBlock x:Name="btnNextPopupTXT" Padding="10,0" Text="xNext" Foreground="Black"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>

                                </Grid>
                            </Grid >
                        </Border>

                        <!-- Arrow -->
                        <Path x:Name="Arrow" StrokeThickness="1" Stroke="Orange" Fill="LightGoldenrodYellow" VerticalAlignment="Top" 
                          HorizontalAlignment="Right" 
                          Margin="0,120,-1,0">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="20,0">
                                        <PolyLineSegment Points="40,20 20,40"/>
                                        <LineSegment Point="20,0" IsStroked="False"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                    </Grid>
                </Popup>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
