<UserControl x:Class="Focus_Bear.Pomodoro.StartPomodoro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Pomodoro"
        mc:Ignorable="d"
        Background="{DynamicResource BackgroundColor}" AutomationProperties.AutomationId="StartPomodoro">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
            <RowDefinition Height="30" />
            <RowDefinition Height="45" />
            <RowDefinition Height="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="80" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0">
            <CheckBox x:Name="ChkShowAdvanced" AutomationProperties.AutomationId="chkShowAdvanced" Style="{StaticResource MacStyleToggleSwitch}" VerticalAlignment="Center" Margin="0,2,8,0"/>
            <TextBlock x:Name="ShowAdvancedLabel" VerticalAlignment="Center" FontSize="15"/>
        </StackPanel>
        <TextBlock Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xIt's time to focus" Foreground="#e88800" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
        <CheckBox Grid.Row="2" x:Name="UseSuperPomodoroMode" AutomationProperties.AutomationId="chkUseSuperPomodoroMode" FontSize="15" Checked="UseSuperPomodoroMode_Checked" Unchecked="UseSuperPomodoroMode_Unchecked" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0">xUse super pomodoro mode (lock in the focus mode for multiple pomodoros)</CheckBox>
        <TextBlock Grid.Row="3" Name="WhichFocusMode" Margin="30,0,30,0" TextWrapping="Wrap" Text="xWhich focus mode do you want to use?"  FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
        <!-- Outer columns are equal "*" so the combo (Auto column) always centers exactly where it did before - the banner lives in the right column and never shifts the combo when shown or hidden -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                <ComboBox Name="ComboBoxFocusModes" AutomationProperties.AutomationId="cmbFocusModes"  Width="250" Height="30" SelectedIndex="0" FontSize="15" SelectionChanged="ComboBoxFocusModes_SelectionChanged">
                </ComboBox>
                <TextBlock x:Name="EditFocusModes" AutomationProperties.AutomationId="txtEditFocusModes" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
                    <Hyperlink x:Name="btnEditFocusModes" AutomationProperties.AutomationId="btnEditFocusModes"   Click="btnEditFocusModes_Click"   TextDecorations="Underline" ><Run x:Name="EditFocusModesTXT" Text="xEdit focus modes"/></Hyperlink>
                </TextBlock>
            </StackPanel>
            <Border x:Name="BlockingScheduleBanner" Grid.Column="2" AutomationProperties.AutomationId="bannerBlockingScheduleWarning" Background="LightGoldenrodYellow" BorderBrush="Orange" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,0,0,0" Padding="12,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;" FontSize="16" Foreground="#856404" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock x:Name="BlockingScheduleBannerText" TextWrapping="Wrap" FontWeight="Bold" FontSize="13" Foreground="#856404" MaxWidth="200"/>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Name="PomodoroCountPanel" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Visibility="Collapsed" Margin="0,0,0,0" Name="PomodoroCountText" TextWrapping="Wrap" Text="xHow many pomodoros you want to focus for:"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

            <ComboBox Visibility="Collapsed" Name="ComboBoxNumberOfPomodoros" AutomationProperties.AutomationId="cmbNumberOfPomodoros" Width="50" MinHeight="24" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"  SelectedIndex="0">
                <ComboBoxItem Content="2"></ComboBoxItem>
                <ComboBoxItem Content="3"></ComboBoxItem>
                <ComboBoxItem Content="4"></ComboBoxItem>
                <ComboBoxItem Content="5"></ComboBoxItem>
                <ComboBoxItem Content="6"></ComboBoxItem>
                <ComboBoxItem Content="7"></ComboBoxItem>
                <ComboBoxItem Content="8"></ComboBoxItem>
                <ComboBoxItem Content="9"></ComboBoxItem>
                <ComboBoxItem Content="10"></ComboBoxItem>
                <ComboBoxItem Content="11"></ComboBoxItem>
                <ComboBoxItem Content="12"></ComboBoxItem>
                <ComboBoxItem Content="13"></ComboBoxItem>
                <ComboBoxItem Content="14"></ComboBoxItem>
                <ComboBoxItem Content="15"></ComboBoxItem>
                <ComboBoxItem Content="16"></ComboBoxItem>
                <ComboBoxItem Content="17"></ComboBoxItem>
                <ComboBoxItem Content="18"></ComboBoxItem>
                <ComboBoxItem Content="19"></ComboBoxItem>
                <ComboBoxItem Content="20"></ComboBoxItem>
            </ComboBox>


        </StackPanel>
        <StackPanel Grid.Row="7"  Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock  Name="HowMuchTime" Margin="10,0,10,0" TextWrapping="Wrap"   FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" Text="xPomodoro Mode duration:" />
            <TextBox      x:Name="Minutes" AutomationProperties.AutomationId="txtBoxMinutes" MinHeight="25"  Width="35" Margin="0"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="Minutes_PreviewTextInput" PreviewKeyDown="Minutes_PreviewKeyDown" PreviewKeyUp="Minutes_PreviewKeyUp" TextChanged="Minutes_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <TextBlock  Name="MinutesTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <TextBlock  Name="BreakDuration" Margin="10,0,10,0" TextWrapping="Wrap"  Text="xBreak duration:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Right" HorizontalAlignment="Center"/>

            <TextBox    x:Name="MinutesBreak" AutomationProperties.AutomationId="txtBoxMinutesBreak" MinHeight="25"  Width="35" Margin="0"  TextWrapping="NoWrap"  Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="Minutes_PreviewTextInput" PreviewKeyDown="Minutes_PreviewKeyDown" PreviewKeyUp="Minutes_PreviewKeyUp" TextChanged="Minutes_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <TextBlock  Name="MinutesBreakTitle" Margin="10,0,10,0" TextWrapping="Wrap" Text="xxminutes"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            
        </StackPanel>
        <StackPanel Margin="0,0,0,0" Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="TxtSkipMicroBreaks" AutomationProperties.AutomationId="chkSkipMicroBreaks" Padding="0,15,0,0" HorizontalAlignment="Center">
                <Hyperlink x:Name="SkipMicroBreaks" AutomationProperties.AutomationId="SkipMicroBreaks" Click="SkipMicroBreaks_Click" FontSize="15" Cursor="Hand">
                    <Run Text="xMicro-breaks on" />
                </Hyperlink>
            </TextBlock>
            <Image x:Name="MicroBreaksInfo"  Source="../images/info-dark.png" Margin="5,17,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand"/>
        </StackPanel>
        <StackPanel Grid.Row="10" Name="ShowAccordingFocusAlignmentScorePanel" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Name="ShowAccordingFocusAlignmentScoreText" FontSize="15" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Center" Text="xxShow distracting site popup only when focus alignment score is less than"/>
            <ComboBox x:Name="FocusAlignmentThresholdCombo"
                      AutomationProperties.AutomationId="cmbFocusAlignmentThreshold"
                      Width="50"
                      Margin="5,0,5,0"
                      VerticalAlignment="Center"
                      IsEditable="False"
                      SelectedIndex="3" SelectionChanged="FocusAlignmentThresholdCombo_SelectionChanged">
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="60"/>
                <ComboBoxItem Content="70"/>
                <ComboBoxItem Content="80"/>
                <ComboBoxItem Content="90"/>
                <ComboBoxItem Content="100"/>
            </ComboBox>
            <TextBlock Name="PorcentageFocusAlignment" FontSize="15" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Center" Text="%"/>
        </StackPanel>
        
        <StackPanel Grid.Row="11" Orientation="Vertical" VerticalAlignment="Top" Margin="0,10,0,0">


            <TextBlock  Name="WhatPlan" Visibility="Visible"  Margin="40,0,40,0" TextWrapping="Wrap" Text="xxWhat do you plan to achieve during this focus block?"  FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox   Name="TxtIntention" AutomationProperties.AutomationId="txtBoxIntention" Visibility="Visible"  TextWrapping="Wrap" AcceptsReturn="True"  Width="550" Height="30" Margin="15" VerticalAlignment="Top"  FontSize="15">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="12" Orientation="Vertical" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock   Name="SelectedTasksTitle" Visibility="Collapsed" Width="300" Margin="5,25,0,5" TextWrapping="Wrap" Text="xxSelected Tasks:"  FontSize="14" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Center"/>

            <ListView    x:Name="ListTasks" AutomationProperties.AutomationId="lvTasks" Visibility="Collapsed" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="Gray" BorderThickness="1" Foreground="{x:Null}"   Height="118" Width="300" VerticalAlignment="Top">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="false"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True"  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Grid.Column="0" Text="{Binding ., StringFormat=\{0\}}" FontSize="15"   VerticalAlignment="Center" Margin="5,0,0,0" Padding="0,-2,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
        <CheckBox  Grid.Row="13" Visibility="Collapsed" x:Name="ShowFocusModeEnd" AutomationProperties.AutomationId="chkShowFocusModeEnd" FontSize="15" Checked="ShowFocusModeEnd_Checked" Unchecked="ShowFocusModeEnd_Unchecked" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0" >xxShow Focus Status after?</CheckBox>
        <TextBlock Visibility="Collapsed" Grid.Row="14" Name="TimeUnfocusedText" FontSize="15" Padding="0,10,0,0" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Text="xxTime spent unfocused: [TIME]" />
        <!-- Teacher Mode (issue #1343): shown only for teachers; lets them run a personal session instead of a class one. -->
        <StackPanel Grid.Row="14" x:Name="TeacherOptionsPanel" Visibility="Collapsed" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <StackPanel x:Name="TeacherClassPickerRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="Class:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbTeacherClass" AutomationProperties.AutomationId="cmbTeacherClass" MinWidth="180" FontSize="14" DisplayMemberPath="Name" Foreground="#000000" Background="#FFFFFF" SelectionChanged="CmbTeacherClass_SelectionChanged"/>
            </StackPanel>
            <CheckBox x:Name="ChkTeacherPersonalSession" AutomationProperties.AutomationId="chkTeacherPersonalSession" FontSize="14" Cursor="Hand" HorizontalAlignment="Center" Padding="6,-2,0,0">Start a personal session instead (not a class session)</CheckBox>
        </StackPanel>
        <Button  Grid.Row="15" x:Name="btnStartSession" AutomationProperties.AutomationId="btnStartSession"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True"  Width="300" Height="45" HorizontalContentAlignment="Center" Padding="0" Margin="0,20,0,0" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnStartSession_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnStartSessionText" Margin="8" Text="xStart Session" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <TextBlock Grid.Row="16" Name="PomodoroCompleted" Visibility="Collapsed" Margin="0,0,0,0" TextWrapping="Wrap" Text="xYou have completed.." Foreground="{DynamicResource ForegroundGrey}" FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"/>
        
            </Grid>
        </ScrollViewer>
        <Border x:Name="GridShade"  CornerRadius="0"  Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" />

        <!-- Teacher Mode (#1343): themed notice shown when a class focus session can't be started. -->
        <Border x:Name="ClassSessionNoticeOverlay" Grid.Row="0" Grid.RowSpan="17" Visibility="Collapsed">
            <Border Background="{DynamicResource BackgroundColor}" BorderBrush="{DynamicResource ForegroundGrey}" BorderThickness="1"
                    CornerRadius="10" Padding="24" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Class focus session" Foreground="{DynamicResource ForegroundColor}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ClassSessionNoticeText" Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20"/>
                    <Button x:Name="BtnClassSessionNoticeOk" AutomationProperties.AutomationId="btnClassSessionNoticeOk" Style="{StaticResource BtnStyleLightOrangeBordered}"
                            HorizontalAlignment="Right" Cursor="Hand" Click="BtnClassSessionNoticeOk_Click">
                        <TextBlock Text="OK" Margin="22,6,22,6" FontSize="15" FontWeight="SemiBold" Foreground="Black"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
