<Window x:Class="Focus_Bear.Quit.QuitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Models="clr-namespace:Focus_Bear.Models"
        xmlns:local="clr-namespace:Focus_Bear.Quit"
        mc:Ignorable="d"
        Title="Focus Bear" AutomationProperties.AutomationId="quitWindow" Height="650" Width="1165" ResizeMode="NoResize" IsVisibleChanged="Window_IsVisibleChanged"
        Background="{DynamicResource BackgroundColor}">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="155" />
            <RowDefinition Height="*"  />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Image Name="TopIcon"  Margin="0,0,0,0" Height="150" Width="150" Models:ImageBehavior.AnimatedSource="../Images/gifs/Crying_small.gif"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Name="Heading" Margin="30,0,0,0" TextWrapping="Wrap" Text="xQuitting..." Foreground="#e88800" FontSize="35" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
         
        <Grid Grid.Row="1" x:Name="GridWhyQuitting" Visibility="Visible" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="70"  />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" MinHeight="110" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <TextBlock   Grid.Row="0"  Name="ShareWhyQuit" Margin="50,0,50,0" TextWrapping="Wrap" Text="xCan you share why you're quitting?" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox  Grid.Row="1" Name="ComboBoxReason" Width="350" MinHeight="30" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0"  SelectedIndex="0" FontSize="15" SelectionChanged="ComboBoxReason_SelectionChanged" AutomationProperties.AutomationId="ComboBoxReason">
            </ComboBox>
            <TextBlock   Grid.Row="2"  Name="ReasonTitle" Margin="0,0,0,0" TextWrapping="Wrap" Text="xCan you tell us why you want to stop getting habit + break notifications?﹡"  FontSize="19" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            
            <TextBlock   Grid.Row="3"  Name="TxtFinalTimer" Margin="0,0,0,0" TextWrapping="Wrap" Text="x00:05"  FontSize="23" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            <TextBox  Grid.Row="3" Name="TxtExplanation" AutomationProperties.AutomationId="txtBoxExplanation" TextWrapping="Wrap" AcceptsReturn="True"  Width="755" Height="90"  VerticalAlignment="Center"  FontSize="15" Visibility="Collapsed">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Visibility="Collapsed" x:Name="btnTurnOfCompletely" AutomationProperties.AutomationId="btnTurnOffCompletely"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold"    >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                            <TextBlock x:Name="btnTurnOfCompletelyTXT" Text="xTurn it off completely - I'll turn it back on when I'm ready" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                
                <Button Grid.Row="4" IsDefault="True" x:Name="btnLetMeDoMyHabits" AutomationProperties.AutomationId="btnLetMeDoMyHabits"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnLetMeDoMyHabits_Click"  >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                            <TextBlock x:Name="btnLetMeDoMyHabitsTXT" Text="xI didn't mean it. Let me do my habits!" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button  IsDefault="True" x:Name="btnQuit" AutomationProperties.AutomationId="btnQuit"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold"  Click="btnQuit_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                            <TextBlock x:Name="btnQuitTXT" Text="xQuit" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            
        </Grid>

        <Border x:Name="GridShade" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" />

    </Grid>
</Window>
