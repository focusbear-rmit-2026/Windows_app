                                                        </TextBlock.Style>
                                                    </TextBlock>


                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                </Grid>
            </DockPanel>
        </Border>
        <!-- Vertical line -->
        <GridSplitter Grid.Column="1" Width="1" Background="Gray" HorizontalAlignment="Stretch" ShowsPreview="False" />
        <!-- RIGHT CONTENT -->
        <ContentControl Grid.Column="2" x:Name="RightContent"/>

        <Border x:Name="GridShade" CornerRadius="0" Grid.ColumnSpan="3" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" >
            <Grid>
                <!-- This WILL animate immediately -->
                <Ellipse Width="40" Height="40"
             StrokeThickness="3"
             RenderTransformOrigin="0.5,0.5"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

                    <Ellipse.Stroke>
                        <LinearGradientBrush>
                            <GradientStop Color="#0078D4" Offset="0"/>
                            <GradientStop Color="#0078D4" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>

                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Ellipse.RenderTransform>

                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <!-- This triggers IMMEDIATELY when control is in visual tree -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Border>

    </Grid>

</habits:FullScreenParent>