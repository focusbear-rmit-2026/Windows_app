<habits:FullScreenParent  xmlns:habits="clr-namespace:Focus_Bear.Habits" x:Class="Focus_Bear.FocusBearMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="Focus Bear" MinHeight="630" MinWidth="900"
        AutomationProperties.AutomationId="FocusBearMainWindow" IsVisibleChanged="Window_IsVisibleChanged" Closing="Window_Closing" Topmost="True">
    <Window.Resources>
        <local:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" MaxWidth="235" MinWidth="45"/>
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAV -->
        <Border Grid.Column="0" >
            <DockPanel LastChildFill="True" >

                <StackPanel  DockPanel.Dock="Top" Orientation="Vertical" >
                    <Image x:Name="FocusBearLogo" HorizontalAlignment="Left" Height="40"  Width="150" Margin="15,0,0,0" Source="{DynamicResource FocusBearLogoMain}"  RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Uniform" VerticalAlignment="Center"   />
                    <!-- Sidebar TOGGLE BUTTON -->
                    <Button   x:Name="btnSideBar" HorizontalAlignment="Right" AutomationProperties.AutomationId="btnSideBar" Margin="0,0,4,3"  Style="{StaticResource ImageButtonStyle}" IsEnabled="True" Width="25"  Height="25" HorizontalContentAlignment="Left" Padding="0"   Cursor="Hand"   Click="btnSideBar_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Width="23"  Height="23" Source="{DynamicResource SidebarButton}" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button.Content>

                    </Button>

                </StackPanel>

                <!-- Horizontal border between them -->
                <Separator DockPanel.Dock="Top" 
               Height="1" 
               Background="Gray"
               Margin="0"/>

                <!-- TREE NAV -->
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TreeView with Categories and Values -->
                    <TreeView x:Name="LeftTree" Grid.Row="0" Margin="7,0,1,0" SelectedItemChanged="LeftTree_SelectedItemChanged_1" BorderThickness="0" BorderBrush="#CCCCCC" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.PanningMode="VerticalOnly">

                        <!-- Custom TreeViewItem style with working expander -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Bind TreeViewItem.IsEnabled to NavLeaf.IsEnabled -->
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                
                                <!-- Custom template with working right-side expander -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Main content area (left side) -->
                                                <Border x:Name="Bd"
                                                        Grid.Row="0"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        HorizontalAlignment="Stretch"
                                                        CornerRadius="4" 
                                                        Cursor="Hand" Width="230">
                                                    <!-- Grid to layout header content and toggle button side by side -->
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Header content (left side) -->
                                                        <ContentPresenter x:Name="PART_Header" 
                                                                          Grid.Column="0"
                                                                          ContentSource="Header" 
                                                                          HorizontalAlignment="Stretch"/>
                                                        <!-- Custom expander button on the right -->
                                                        <ToggleButton x:Name="RightExpander"
                                                                      Grid.Column="1" 
                                                                      Grid.Row="0"
                                                                      Width="24"
                                                                      Height="24"
                                                                      Margin="5,0"
                                                                      IsChecked="{Binding IsExpanded, 
                                                                          RelativeSource={RelativeSource TemplatedParent}, 
                                                                          Mode=TwoWay}"
                                                                      Background="Transparent"
                                                                      BorderBrush="Transparent"
                                                                      BorderThickness="0"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                            <ToggleButton.Content>
                                                                <Grid Width="16" Height="16">
                                                                    <!-- Right chevron (collapsed) -->
                                                                    <Path x:Name="CollapsedArrow"
                                                                          Data="M6,4 L10,8 6,12"
                                                                          Stroke="#666666"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round"
                                                                          Fill="Transparent"/>

                                                                    <!-- Down chevron (expanded) -->
                                                                    <Path x:Name="ExpandedArrow"
                                                                          Data="M4,6 L8,10 12,6"
                                                                          Stroke="#666666"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round"
                                                                          Fill="Transparent"
                                                                          Visibility="Collapsed"/>
                                                                </Grid>
                                                            </ToggleButton.Content>

                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="3">
                                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                                        VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </Grid>
                                                </Border>

                                                <!-- Items presenter for children -->
                                                <ItemsPresenter x:Name="ItemsHost" 
                                                    Grid.Row="1" HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <!-- Expand/collapse trigger -->
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                    <!-- Show collapsed arrow, hide expanded arrow -->
                                                    <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Collapsed"/>
                                                  
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <!-- Hide collapsed arrow, show expanded arrow -->
                                                    <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- Only show visual selection for leaf items (no children) -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="HasItems" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <!-- Hide selection visuals for categories -->
                                                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <!-- Keep text color normal -->
                                                </MultiTrigger>
                                                <!-- Show visual selection only for leaf items (no children) -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="HasItems" Value="False"/>
                                                        <!-- Leaf items only -->
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#ffe4c6"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDC8C11"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="#222222"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="HasItems" Value="False"/>
                                                        <!-- Leaf items only -->
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF3E0"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDC8C11"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </MultiTrigger>
                                                <!-- Make last item in last category stick to bottom -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.IsLastItemInLastCategory, 
                                                                                    RelativeSource={RelativeSource Self}}" 
                                                                                    Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                                    <!-- Bottom margin -->
                                                </MultiDataTrigger>

                                                <!-- Trigger for empty items (no children) -->
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="RightExpander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:NavCategory}" ItemsSource="{Binding Items}">

                                
                                <!-- Category Header -->
                                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" Height="40">
                                        <!-- Category Name -->
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundColor}"   VerticalAlignment="Center" Visibility="{Binding ActualWidth, 
                                                                                                               RelativeSource={RelativeSource AncestorType={x:Type TreeView}},
                                                                                                               Converter={StaticResource WidthToVisibilityConverter},
                                                                                                               ConverterParameter=50}"/>
                                </StackPanel>

                                <!-- Template for child items (Values) -->
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NavLeaf}">
                                        <StackPanel Margin="0,2,0,2">
                                            <!-- Value Item with hover effect -->
                                            <Border Padding="8,0" 
                                                CornerRadius="4"
                                                Height="32"
                                                Background="Transparent" 
                                                BorderThickness="1"
                                                HorizontalAlignment="Stretch"
                                                MouseLeftButtonDown="NavLeaf_Click" >
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Icon from Images folder -->
                                                    <Image Width="18" Height="18" Source="{Binding IconSource}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <!-- Disabled state -->
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Value Text -->

