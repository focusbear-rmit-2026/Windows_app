<habits:FullScreenParent  xmlns:habits="clr-namespace:Focus_Bear.Habits" x:Class="Focus_Bear.FocusBearMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="Focus Bear" MinHeight="480" MinWidth="900"
        AutomationProperties.AutomationId="FocusBearMainWindow" IsVisibleChanged="Window_IsVisibleChanged" Closing="Window_Closing" Topmost="True">
    <Window.Resources>
        <local:WidthToVisibilityConverter x:Key="WidthToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" MaxWidth="250" MinWidth="45" Width="250"/>
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAV -->
        <Border Grid.Column="0" >
            <DockPanel LastChildFill="True" >

                <!-- Logo and the sidebar toggle share one row (the toggle used to sit on its own row below the logo).
                     Expanded: logo left, « right. Collapsed: the logo is hidden and » sits centred. -->
                <Grid DockPanel.Dock="Top" Height="56">
                    <Image x:Name="FocusBearLogo" AutomationProperties.Name="Focus Bear" HorizontalAlignment="Left" Height="40"  Width="150" Margin="15,0,0,0" Source="{DynamicResource FocusBearLogoMain}"  RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Uniform" VerticalAlignment="Center"   />
                    <!-- Sidebar TOGGLE BUTTON -->
                    <Button   x:Name="btnSideBar" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="btnSideBar" AutomationProperties.Name="Collapse sidebar" ToolTip="Collapse sidebar" Margin="0,0,8,0"  Style="{StaticResource ImageButtonStyle}" IsEnabled="True" Width="28"  Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"   Cursor="Hand"   Click="btnSideBar_Click">
                        <TextBlock x:Name="SidebarChevron" Text="&#xE76B;&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TraySubtitleColor}"/>
                    </Button>
                </Grid>

                <!-- Horizontal border between them -->
                <Separator DockPanel.Dock="Top" 
               Height="1" 
               Background="Gray"
               Margin="0"/>

                <!-- TREE NAV -->
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TreeView with Categories and Values -->
                    <TreeView x:Name="LeftTree" Grid.Row="0" Margin="7,0,1,0" SelectedItemChanged="LeftTree_SelectedItemChanged_1" PreviewKeyDown="LeftTree_PreviewKeyDown" BorderThickness="0" BorderBrush="#CCCCCC" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.PanningMode="VerticalOnly">

                        <!-- Custom TreeViewItem style with working expander -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <!-- Screen readers read the row's title, not the item's type name ("Focus_Bear.NavLeaf"). -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <!-- Bind TreeViewItem.IsEnabled to NavLeaf.IsEnabled -->
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                                <!-- Id on the container: a Border gets no AutomationPeer, so an id there never reaches UIA. -->
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding ButtonType, StringFormat=navItem_{0}}"/>
                                
                                <!-- Custom template with working right-side expander -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Keyboard focus ring (AccessibilityDefaults shows it when focus came from the keyboard;
                                                     the selected row's own orange border looked the same focused or not). -->
                                                <Border x:Name="PART_KeyboardFocusRing" Grid.Row="0" Panel.ZIndex="1" IsHitTestVisible="False"
                                                        BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="2" CornerRadius="5"
                                                        Margin="-1" Visibility="Collapsed"/>
                                                <!-- Main content area (left side) -->
                                                <Border x:Name="Bd"
                                                        Grid.Row="0"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        HorizontalAlignment="Stretch"
                                                        CornerRadius="4" 
                                                        Cursor="Hand">
                                                    <!-- Grid to layout header content and toggle button side by side -->
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Header content (left side) -->
                                                        <ContentPresenter x:Name="PART_Header" 
                                                                          Grid.Column="0"
                                                                          ContentSource="Header" 
                                                                          HorizontalAlignment="Stretch"/>
                                                        <!-- Custom expander button on the right -->
                                                        <ToggleButton x:Name="RightExpander"
                                                                      AutomationProperties.Name="{Binding Title, StringFormat=Show or hide {0}}"
                                                                      Grid.Column="1" 
                                                                      Grid.Row="0"
                                                                      Width="24"
                                                                      Height="24"
                                                                      Margin="5,0"
                                                                      IsChecked="{Binding IsExpanded, 
                                                                          RelativeSource={RelativeSource TemplatedParent}, 
                                                                          Mode=TwoWay}"
                                                                      Background="Transparent"
                                                                      BorderBrush="Transparent"
                                                                      BorderThickness="0"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                            <ToggleButton.Content>
                                                                <Grid Width="16" Height="16">
                                                                    <!-- Right chevron (collapsed) -->
                                                                    <Path x:Name="CollapsedArrow"
                                                                          Data="M6,4 L10,8 6,12"
                                                                          Stroke="#666666"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round"
                                                                          Fill="Transparent"/>

                                                                    <!-- Down chevron (expanded) -->
                                                                    <Path x:Name="ExpandedArrow"
                                                                          Data="M4,6 L8,10 12,6"
                                                                          Stroke="#666666"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round"
                                                                          Fill="Transparent"
                                                                          Visibility="Collapsed"/>
                                                                </Grid>
                                                            </ToggleButton.Content>

                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="3">
                                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                                        VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </Grid>
                                                </Border>

                                                <!-- Items presenter for children -->
                                                <ItemsPresenter x:Name="ItemsHost" 
                                                    Grid.Row="1" HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <!-- Expand/collapse trigger -->
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                    <!-- Show collapsed arrow, hide expanded arrow -->
                                                    <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Collapsed"/>
                                                  
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <!-- Hide collapsed arrow, show expanded arrow -->
                                                    <Setter TargetName="CollapsedArrow" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ExpandedArrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- Only show visual selection for leaf items (no children) -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="HasItems" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <!-- Hide selection visuals for categories -->
                                                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <!-- Keep text color normal -->
                                                </MultiTrigger>
                                                <!-- Show visual selection only for leaf items (no children) -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="HasItems" Value="False"/>
                                                        <!-- Leaf items only -->
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#ffe4c6"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDC8C11"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="#222222"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="HasItems" Value="False"/>
                                                        <!-- Leaf items only -->
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF3E0"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDC8C11"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </MultiTrigger>
                                                <!-- Make last item in last category stick to bottom -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.IsLastItemInLastCategory, 
                                                                                    RelativeSource={RelativeSource Self}}" 
                                                                                    Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"/>
                                                    <!-- Bottom margin -->
                                                </MultiDataTrigger>

                                                <!-- Trigger for empty items (no children) -->
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="RightExpander" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- A TOOLS row the user hid with its X (restored from the TOOLS cog). -->
                                    <DataTrigger Binding="{Binding IsHiddenByUser}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:NavCategory}" ItemsSource="{Binding Items}">

                                
                                <!-- Category Header -->
                                <Grid Margin="15,0,0,0" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                        <!-- Category Name -->
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ForegroundColor}"   VerticalAlignment="Center" Visibility="{Binding ActualWidth, 
                                                                                                               RelativeSource={RelativeSource AncestorType={x:Type TreeView}},
                                                                                                               Converter={StaticResource WidthToVisibilityConverter},
                                                                                                               ConverterParameter=50}"/>
                                    <!-- TOOLS cog: lists the rows the user hid, with Restore (Mac RestoreHiddenToolsView). -->
                                    <Button Grid.Column="1" x:Name="btnHiddenToolsCog" AutomationProperties.AutomationId="btnHiddenToolsCog"
                                            Click="HiddenToolsCog_Click" Width="24" Height="24" Margin="0,0,2,0" Padding="0" Cursor="Hand"
                                            VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                            ToolTip="{x:Static local:FocusBearMainWindow.HiddenToolsCogTooltip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cogBd" Background="Transparent" CornerRadius="4">
                                                    <TextBlock x:Name="cogGlyph" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TraySubtitleColor}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cogBd" Property="Background" Value="#FFF3E0"/>
                                                        <Setter TargetName="cogGlyph" Property="Foreground" Value="#DE7400"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowsHiddenToolsCog}" Value="True"/>
                                                            <Condition Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource WidthToVisibilityConverter}}" Value="Visible"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Template for child items (Values) -->
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NavLeaf}">
                                        <StackPanel Margin="0,2,0,2">
                                            <!-- Value Item with hover effect -->
                                            <Border Padding="8,0"
                                                CornerRadius="4"
                                                Height="34"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="{Binding Title}"
                                                ToolTipService.InitialShowDelay="100"
                                                MouseLeftButtonDown="NavLeaf_Click" >
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <!-- Only show the tooltip while the side menu is collapsed; when it's
                                                                 expanded the label text is already visible, so suppress it. -->
                                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource WidthToVisibilityConverter}}" Value="Visible">
                                                                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Icon from Images folder -->
                                                    <Image Width="18" Height="18" Source="{Binding IconSource}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <!-- Disabled state -->
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <!-- Value Text -->

                                                    <TextBlock x:Name="ItemTitle" Text="{Binding Title}" Width="160" LineStackingStrategy="BlockLineHeight" LineHeight="15" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"  
                                                                 VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                                                        <Setter Property="Foreground" Value="#222222"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                                                                        <Setter Property="Foreground" Value="#222222"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                                    </DataTrigger>
                                                                    
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>


                                                </StackPanel>
                                                <!-- Hover X on a TOOLS row hides it (Mac mainWindowListBox.showsHideButton). -->
                                                <Button x:Name="btnHideTool" AutomationProperties.AutomationId="{Binding ButtonType, StringFormat=btnHideTool_{0}}"
                                                        Click="HideTool_Click" Width="20" Height="20" Padding="0" Cursor="Hand" Focusable="False"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                        ToolTip="{x:Static local:FocusBearMainWindow.HideToolTooltip}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="xBd" Background="{DynamicResource TrayCardBg}" BorderBrush="{DynamicResource TrayCardBorder}" BorderThickness="1" CornerRadius="10">
                                                                <TextBlock x:Name="xGlyph" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="{DynamicResource TraySubtitleColor}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="xBd" Property="BorderBrush" Value="#DE7400"/>
                                                                    <Setter TargetName="xGlyph" Property="Foreground" Value="#DE7400"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsHideable}" Value="True"/>
                                                                        <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True"/>
                                                                        <Condition Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource WidthToVisibilityConverter}}" Value="Visible"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                </Grid>
            </DockPanel>
        </Border>
        <!-- Vertical line (static divider — the left menu is a fixed width, not user-resizable) -->
        <Border Grid.Column="1" Width="1" Background="Gray" HorizontalAlignment="Stretch" />
        <!-- RIGHT CONTENT, under a slim top bar whose minimise is on every screen (Mac boxMinimize):
             while a routine owns the window it is the routine's Exit Fullscreen, otherwise it minimises. -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="TopBar" Grid.Row="0" Height="30" Background="Transparent">
                <Button x:Name="btnTopMinimise" AutomationProperties.AutomationId="btnTopMinimise" Click="btnTopMinimise_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="26" Margin="0,2,8,0" Padding="0"
                        Cursor="Hand" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="minBd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                <TextBlock x:Name="minGlyph" Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource ForegroundColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="minBd" Property="Background" Value="#FFF3E0"/>
                                    <Setter TargetName="minBd" Property="BorderBrush" Value="#DE7400"/>
                                    <Setter TargetName="minGlyph" Property="Foreground" Value="#DE7400"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="minGlyph" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
            <!-- Hosts the current screen; not a Tab stop itself (a ContentControl is one by default, and with no
                 automation peer a screen reader announced it as the whole window). -->
            <ContentControl Grid.Row="1" x:Name="RightContent" IsTabStop="False"/>
        </Grid>

        <!-- TOOLS cog popover: the rows the user hid, each with Restore. -->
        <Popup x:Name="HiddenToolsPopup" Placement="Right" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="6" PopupAnimation="Fade">
            <Border Background="{DynamicResource TrayCardBg}" BorderBrush="{DynamicResource TrayCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" MinWidth="220" MaxWidth="300" Margin="0,0,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="HiddenToolsTitle" Text="Hidden tools" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ForegroundColor}"/>
                    <TextBlock x:Name="HiddenToolsEmpty" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TraySubtitleColor}"/>
                    <StackPanel x:Name="HiddenToolsRows"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="GridShade" CornerRadius="0" Grid.ColumnSpan="3" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" >
            <Grid>
                <!-- This WILL animate immediately -->
                <Ellipse Width="40" Height="40"
             StrokeThickness="3"
             RenderTransformOrigin="0.5,0.5"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

                    <Ellipse.Stroke>
                        <LinearGradientBrush>
                            <GradientStop Color="#0078D4" Offset="0"/>
                            <GradientStop Color="#0078D4" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>

                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Ellipse.RenderTransform>

                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <!-- This triggers IMMEDIATELY when control is in visual tree -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="GridShadeSpin">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <!-- Stop when hidden: a forever spin left running kept WPF rendering at 60 fps for the rest of the session. -->
                                        <StopStoryboard BeginStoryboardName="GridShadeSpin"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Border>

    </Grid>

</habits:FullScreenParent>