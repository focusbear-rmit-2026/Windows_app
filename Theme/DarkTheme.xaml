<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundColor" Color="#282828"/>
    <SolidColorBrush x:Key="SoftCreamColor" Color="#3d3d3d"/>
    <!-- Text on the orange selection / expanded-card fill: near-black in both themes (white was 2.4:1). -->
    <SolidColorBrush x:Key="OnOrangeText" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="OnOrangeSubtitle" Color="#3D2A12"/>
    <!-- Orange for headings and links on the dark page / card: #B35C00 was 2.3:1 on #3D3D3D; #F09A3E is 4.8:1. -->
    <SolidColorBrush x:Key="OrangeTextColor" Color="#F09A3E"/>
    <SolidColorBrush x:Key="CardSubtitleColor" Color="#B8B8BF"/>
    <!-- Text-input background: dark grey in dark mode (readable, matches native dark text boxes). -->
    <SolidColorBrush x:Key="TextBoxBackgroundColor" Color="#333333"/>
    <SolidColorBrush x:Key="FocusActivitySummaryBackgroundColor" Color="#282828"/>
    <!-- Near-white body text and a lighter secondary: the old LightGray / #9A9AA0 read as grey on grey (~3.7:1 on the #3d3d3d panels). -->
    <SolidColorBrush x:Key="ForegroundColor" Color="#F2F2F3"/>
    <SolidColorBrush x:Key="ForegroundGrey" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="TabChosenColor" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="UpdateNowPageColor" Color="#282828"/>

    <!-- Tray menu (macOS-style cards) — dark theme -->
    <SolidColorBrush x:Key="TrayCardBg" Color="#2E2E30"/>
    <SolidColorBrush x:Key="TrayCardBorder" Color="#3C3C3E"/>
    <SolidColorBrush x:Key="TrayCardHoverBg" Color="#38322B"/>
    <SolidColorBrush x:Key="TrayCardHoverBorder" Color="#5A4A36"/>
    <SolidColorBrush x:Key="TraySubtitleColor" Color="#B8B8BF"/>
    <SolidColorBrush x:Key="TrayChevronColor" Color="#6E6E72"/>
    <SolidColorBrush x:Key="TrayIconSquareBg" Color="#4A3B28"/>
    <SolidColorBrush x:Key="TrayCircleBtnBg" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="TrayCircleBtnHoverBg" Color="#4A4A4C"/>
    <SolidColorBrush x:Key="TrayCircleIconColor" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="TrayToolRowBg" Color="#3C332A"/>
    <SolidColorBrush x:Key="TrayToolRowHoverBg" Color="#473D30"/>
    <SolidColorBrush x:Key="TrayToolRowText" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="PrefenenceTitleBackgroundColor" Color="#383838"/>
    <SolidColorBrush x:Key="PrefenenceButton" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceButtonColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonPressedColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceFocusListItemForegroundColor" Color="White"/>

    <BitmapImage x:Key="PlusImage" UriSource="../Images/plus_dark.png" />
    <BitmapImage x:Key="MinusImage" UriSource="../Images/minus_dark.png" />
    <BitmapImage x:Key="BackgroundImage" UriSource="../Images/background_dark.png" />
    <BitmapImage x:Key="PauseImage" UriSource="../Images/pause_icon_dark.png" />
    <BitmapImage x:Key="PlayIcon" UriSource="../Images/play_icon_dark.png" />
    <BitmapImage x:Key="FocusBearLogo" UriSource="../Images/fb_big_dark.png" />
    <BitmapImage x:Key="CheckMark" UriSource="../Images/checkmark_dark.png" />

    <BitmapImage x:Key="InfoImage" UriSource="../Images/info-dark.png" />
    <BitmapImage x:Key="FocusImage" UriSource="../Images/eye-dark.png" />
    <BitmapImage x:Key="BlockImage" UriSource="../Images/blocked_list-dark.png" />
    <BitmapImage x:Key="SettingImage" UriSource="../Images/gear_alt-dark.png" />
    <BitmapImage x:Key="HabitImage" UriSource="../Images/checkmark_rectangle-dark.png" />
    <BitmapImage x:Key="StatsImage" UriSource="../Images/person-dark.png" />

    <BitmapImage x:Key="GlobeImage" UriSource="../Images/Globe.png" />

    <!-- Settings Icons -->
    <BitmapImage x:Key="UITab" UriSource="../Images/Settings/uiwindow_white.png" />
    <BitmapImage x:Key="FocusSessions" UriSource="../Images/Settings/focus_sessions_white.png" />
    <BitmapImage x:Key="Breaks" UriSource="../Images/Settings/breaks_white.png" />
    <BitmapImage x:Key="Advanced" UriSource="../Images/Settings/advanced_white.png" />
    <BitmapImage x:Key="Account" UriSource="../Images/Settings/account_white.png" />
    <BitmapImage x:Key="Uninstall" UriSource="../Images/Settings/uninstall_white.png" />
    <BitmapImage x:Key="AI" UriSource="../Images/Settings/ai_white.png" />
    <BitmapImage x:Key="Strictness" UriSource="../Images/Settings/strictness_white.png" />
    <!-- Keyboard Shortcuts tab icon (vector so no PNG asset needed); white for the dark theme. -->
    <DrawingImage x:Key="KeyboardShortcuts">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="2,5,20,14" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="5,8,1.8,1.8"/><RectangleGeometry Rect="8,8,1.8,1.8"/><RectangleGeometry Rect="11,8,1.8,1.8"/><RectangleGeometry Rect="14,8,1.8,1.8"/><RectangleGeometry Rect="17.2,8,1.8,1.8"/>
                            <RectangleGeometry Rect="5,11,1.8,1.8"/><RectangleGeometry Rect="8,11,1.8,1.8"/><RectangleGeometry Rect="11,11,1.8,1.8"/><RectangleGeometry Rect="14,11,1.8,1.8"/><RectangleGeometry Rect="17.2,11,1.8,1.8"/>
                            <RectangleGeometry Rect="7,14.4,10,1.8" RadiusX="0.6" RadiusY="0.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <BitmapImage x:Key="Password" UriSource="../Images/Settings/password_black.png" />  <!-- //intentionally black -->
    <BitmapImage x:Key="FocusModeDark" UriSource="../Images/eye.png" />     <!-- //intentionally black -->
    <BitmapImage x:Key="AlwaysAllowedAppsImage" UriSource="../Images/checkmark_rectangle-dark.png" />
    <BitmapImage x:Key="FocusButton" UriSource="../Images/Settings/button_white.png" />

    <!-- Main Window Icon -->
    <BitmapImage x:Key="SidebarButton" UriSource="../Images/MainAppWindow/sidebar_white.png" />
    <BitmapImage x:Key="FocusBearLogoMain" UriSource="../Images/fb_white.png" />

    <!-- Tooltip Base colors -->
    <Color x:Key="TooltipBackgroundColor">#2B2B2B</Color>
    <Color x:Key="TooltipForegroundColor">#F1F1F1</Color>
    <Color x:Key="TooltipBorderColor">#444444</Color>
    
    <Style x:Key="BtnStylePreferencesDynamic" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="BtnGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0">
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="rectangle" Fill="#383838" Stroke="#383838" StrokeThickness="0" RadiusX="7" RadiusY="7"/>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Width="Auto" Margin="0,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True"/>
                        <Trigger Property="IsDefaulted" Value="True"/>
                        <Trigger Property="IsMouseOver" Value="True"/>
                        <Trigger Property="IsPressed" Value="True"/>
                        <Trigger Property="IsEnabled" Value="False"/>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
