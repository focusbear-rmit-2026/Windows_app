<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundColor" Color="#282828"/>
    <SolidColorBrush x:Key="SoftCreamColor" Color="#3d3d3d"/>
    <SolidColorBrush x:Key="FocusActivitySummaryBackgroundColor" Color="#282828"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="LightGray"/>
    <SolidColorBrush x:Key="ForegroundGrey" Color="#808080"/>
    <SolidColorBrush x:Key="TabChosenColor" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="UpdateNowPageColor" Color="#282828"/>

    <SolidColorBrush x:Key="PrefenenceTitleBackgroundColor" Color="#383838"/>
    <SolidColorBrush x:Key="PrefenenceButton" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceButtonColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonPressedColor" Color="#383838"/>
    <SolidColorBrush x:Key="PreferenceFocusListItemForegroundColor" Color="White"/>

    <BitmapImage x:Key="PlusImage" UriSource="../Images/plus_dark.png" />
    <BitmapImage x:Key="MinusImage" UriSource="../Images/minus_dark.png" />
    <BitmapImage x:Key="BackgroundImage" UriSource="../Images/background_dark.png" />
    <BitmapImage x:Key="PauseImage" UriSource="../Images/pause_icon_dark.png" />
    <BitmapImage x:Key="PlayIcon" UriSource="../Images/play_icon_dark.png" />
    <BitmapImage x:Key="FocusBearLogo" UriSource="../Images/fb_big_dark.png" />
    <BitmapImage x:Key="CheckMark" UriSource="../Images/checkmark_dark.png" />

    <BitmapImage x:Key="InfoImage" UriSource="../Images/info-dark.png" />
    <BitmapImage x:Key="FocusImage" UriSource="../Images/eye-dark.png" />
    <BitmapImage x:Key="BlockImage" UriSource="../Images/blocked_list-dark.png" />
    <BitmapImage x:Key="SettingImage" UriSource="../Images/gear_alt-dark.png" />
    <BitmapImage x:Key="HabitImage" UriSource="../Images/checkmark_rectangle-dark.png" />
    <BitmapImage x:Key="StatsImage" UriSource="../Images/person-dark.png" />


    <Style x:Key="BtnStylePreferencesDynamic" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="BtnGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0">
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#454545"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="rectangle" Fill="#383838" Stroke="#383838" StrokeThickness="0" RadiusX="7" RadiusY="7"/>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Width="Auto" Margin="0,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True"/>
                        <Trigger Property="IsDefaulted" Value="True"/>
                        <Trigger Property="IsMouseOver" Value="True"/>
                        <Trigger Property="IsPressed" Value="True"/>
                        <Trigger Property="IsEnabled" Value="False"/>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>