<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundColor" Color="White"/>
    <SolidColorBrush x:Key="SoftCreamColor" Color="#FFF7EB"/>
    <!-- Text-input background: plain white in light mode (the default Windows text-box look). -->
    <SolidColorBrush x:Key="TextBoxBackgroundColor" Color="White"/>
    <SolidColorBrush x:Key="FocusActivitySummaryBackgroundColor" Color="#eeeeee"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="Black"/>
    <SolidColorBrush x:Key="ForegroundGrey" Color="#272727"/>
    <SolidColorBrush x:Key="TabChosenColor" Color="#DADADA"/>
    <SolidColorBrush x:Key="UpdateNowPageColor" Color="#eee"/>

    <!-- Tray menu (macOS-style cards) — light theme -->
    <SolidColorBrush x:Key="TrayCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TrayCardBorder" Color="#ECECEC"/>
    <SolidColorBrush x:Key="TrayCardHoverBg" Color="#FFF4E8"/>
    <SolidColorBrush x:Key="TrayCardHoverBorder" Color="#F3D9BC"/>
    <SolidColorBrush x:Key="TraySubtitleColor" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TrayChevronColor" Color="#C7C7C7"/>
    <SolidColorBrush x:Key="TrayIconSquareBg" Color="#FBE7CB"/>
    <SolidColorBrush x:Key="TrayCircleBtnBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TrayCircleBtnHoverBg" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="TrayCircleIconColor" Color="#555555"/>
    <SolidColorBrush x:Key="TrayToolRowBg" Color="#FCEBD8"/>
    <SolidColorBrush x:Key="TrayToolRowHoverBg" Color="#F6DCC2"/>
    <SolidColorBrush x:Key="TrayToolRowText" Color="#333333"/>

    <SolidColorBrush x:Key="PrefenenceTitleBackgroundColor" Color="#faf9f6"/>
    <SolidColorBrush x:Key="PrefenenceButton" Color="#fcf8f0"/>
    <SolidColorBrush x:Key="PreferenceButtonColor" Color="#fcf8f0"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonColor" Color="#faf9f6"/>
    <SolidColorBrush x:Key="PreferenceTitleButtonPressedColor" Color="#edece9"/>
    <SolidColorBrush x:Key="PreferenceFocusListItemForegroundColor" Color="Black"/>


    <BitmapImage x:Key="PlusImage" UriSource="../Images/plus.png" />
    <BitmapImage x:Key="MinusImage" UriSource="../Images/minus.png" />
    <BitmapImage x:Key="BackgroundImage" UriSource="../Images/background.png" />
    <BitmapImage x:Key="PauseImage" UriSource="../Images/pause_icon.png" />
    <BitmapImage x:Key="PlayIcon" UriSource="../Images/play_icon.png" />
    <BitmapImage x:Key="FocusBearLogo" UriSource="../Images/fb_big.png" />
    <BitmapImage x:Key="CheckMark" UriSource="../Images/checkmark.png" />

    <BitmapImage x:Key="InfoImage" UriSource="../Images/info.png" />
    <BitmapImage x:Key="FocusImage" UriSource="../Images/eye.png" />
    <BitmapImage x:Key="BlockImage" UriSource="../Images/blocked_list.png" />
    <BitmapImage x:Key="SettingImage" UriSource="../Images/gear_alt.png" />
    <BitmapImage x:Key="HabitImage" UriSource="../Images/checkmark_rectangle.png" />
    <BitmapImage x:Key="StatsImage" UriSource="../Images/person.png" />

    <BitmapImage x:Key="GlobeImage" UriSource="../Images/Globe.png" />

    <!-- Settings Icons -->
    <BitmapImage x:Key="UITab" UriSource="../Images/Settings/uiwindow_black.png" />
    <BitmapImage x:Key="FocusSessions" UriSource="../Images/Settings/focus_sessions_black.png" />
    <BitmapImage x:Key="Breaks" UriSource="../Images/Settings/breaks_black.png" />
    <BitmapImage x:Key="Advanced" UriSource="../Images/Settings/advanced_black.png" />
    <BitmapImage x:Key="Account" UriSource="../Images/Settings/account_black.png" />
    <BitmapImage x:Key="Uninstall" UriSource="../Images/Settings/uninstall_black.png" />
    <BitmapImage x:Key="AI" UriSource="../Images/Settings/ai_black.png" />
    <BitmapImage x:Key="Strictness" UriSource="../Images/Settings/strictness_black.png" />
    <!-- Keyboard Shortcuts tab icon (vector so no PNG asset needed); black for the light theme. -->
    <DrawingImage x:Key="KeyboardShortcuts">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="Black" Thickness="1.6"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="2,5,20,14" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Black">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="5,8,1.8,1.8"/><RectangleGeometry Rect="8,8,1.8,1.8"/><RectangleGeometry Rect="11,8,1.8,1.8"/><RectangleGeometry Rect="14,8,1.8,1.8"/><RectangleGeometry Rect="17.2,8,1.8,1.8"/>
                            <RectangleGeometry Rect="5,11,1.8,1.8"/><RectangleGeometry Rect="8,11,1.8,1.8"/><RectangleGeometry Rect="11,11,1.8,1.8"/><RectangleGeometry Rect="14,11,1.8,1.8"/><RectangleGeometry Rect="17.2,11,1.8,1.8"/>
                            <RectangleGeometry Rect="7,14.4,10,1.8" RadiusX="0.6" RadiusY="0.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <BitmapImage x:Key="Password" UriSource="../Images/Settings/password_black.png" />
    <BitmapImage x:Key="FocusModeDark" UriSource="../Images/eye.png" />
    <BitmapImage x:Key="AlwaysAllowedAppsImage" UriSource="../Images/checkmark_rectangle.png" />
    <BitmapImage x:Key="FocusButton" UriSource="../Images/Settings/button_black.png" />
    
    <SolidColorBrush x:Key="ExpanderBackground" Color="White"/>

    <!-- Main Window Icon -->
    <BitmapImage x:Key="SidebarButton" UriSource="../Images/MainAppWindow/sidebar_black.png" />
    <BitmapImage x:Key="FocusBearLogoMain" UriSource="../Images/fb.png" />
    
    <!-- Tooltip Base colors -->
    <Color x:Key="TooltipBackgroundColor">#F5F5F5</Color>
    <Color x:Key="TooltipForegroundColor">#1E1E1E</Color>
    <Color x:Key="TooltipBorderColor">#CCCCCC</Color>
    
    
    <Style x:Key="BtnStylePreferencesDynamic" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="BtnGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0">
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#edece9"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#edece9"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#edece9"/>
                                            <EasingColorKeyFrame KeyTime="0:0:0.2" Value="#edece9"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="rectangle">
                                            <EasingColorKeyFrame KeyTime="0" Value="#edece9"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="rectangle" Fill="#faf9f6" Stroke="#faf9f6" StrokeThickness="0" RadiusX="7" RadiusY="7"/>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" Width="Auto" Margin="0,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True"/>
                        <Trigger Property="IsDefaulted" Value="True"/>
                        <Trigger Property="IsMouseOver" Value="True"/>
                        <Trigger Property="IsPressed" Value="True"/>
                        <Trigger Property="IsEnabled" Value="False"/>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
