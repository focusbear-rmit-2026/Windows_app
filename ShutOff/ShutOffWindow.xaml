<src:FullScreenParent x:Class="Focus_Bear.ShutOff.ShutOffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.ShutOff"
        xmlns:Models="clr-namespace:Focus_Bear.Models"
        xmlns:src="clr-namespace:Focus_Bear.Habits"
        xmlns:local1="clr-namespace:Focus_Bear.Utils"
        mc:Ignorable="d"
        Title="ShutOffWindow" d:DesignHeight="1080" d:DesignWidth="1920" WindowState="Maximized" WindowStyle="None" Closed="Window_Closed" >

    <local1:DpiDecorator>
        <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="80" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="Auto" MinHeight="180" />
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Image  Name="Icon"  Height="120"  Width="120" Models:ImageBehavior.AnimatedSource="../Images/gifs/Yawn_small.gif" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <TextBlock    Name="Heading" Margin="50,0,0,0" TextWrapping="Wrap" Text="xtime to wind down" Foreground="#e88800" FontSize="33" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock  Grid.Row="2" Name="Description" Width="800" Margin="80,50,80,50" TextWrapping="Wrap" Text="xYou told me you wanted to stay off your computer from SHUTOFFTIME to STARTTIME. Enjoy your evening and sleep well. Look forward to helping you with your morning routine tomorrow." Foreground="#272727" FontSize="23" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
      
        <TextBlock  Grid.Row="3" Name="Txtunlocking" Width="900" Margin="0,0,0,0" TextWrapping="Wrap" Text="xunlocking in." Foreground="#272727" FontSize="23" FontWeight="Normal" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock  Grid.Row="3" Name="TxtTimer" Width="900"  Margin="0,35,0,0" TextWrapping="Wrap" Text="x00:30" Foreground="#272727" FontSize="23" FontWeight="Bold"  TextAlignment="Center" HorizontalAlignment="Center" />
        
        <TextBlock  Grid.Row="4" Name="TxtExplain" Width="900"  TextWrapping="Wrap" Text="xFeel free to write an explanation here:" Foreground="#272727" FontSize="17" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBox  Grid.Row="5" Name="TxtExplaination" TextWrapping="Wrap" AcceptsReturn="True"  Width="650" Height="120" Margin="15" VerticalAlignment="Top"  FontSize="15">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
            </TextBox.Effect>
            <TextBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.FocusVisualStyle>
        </TextBox>
        
        <Button Grid.Row="6"  Name="btnAction"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAction_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnActionText" Text="xGet Access Now"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <Border x:Name="GridShade" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" />

    </Grid>
        </local1:DpiDecorator>
</src:FullScreenParent>
