<Window x:Class="Focus_Bear.Tour.FocusBearMenuTour"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Tour"
        mc:Ignorable="d"
         d:DesignHeight="1080" d:DesignWidth="1920"
        Title="FocusBearMenuTour" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" AllowsTransparency="True">
    <Window.Background>
        <SolidColorBrush Opacity="0.5" Color="Black"/>
    </Window.Background>
     
    <Grid >
        <Image Name="FBMenu" Grid.Row="0" Margin="0,0,20,35"   Source="../Images/fb-tray.png" Width="318"  VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

        <Grid x:Name="GridPopup" Width="250"  Margin="0,0,370,50" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="70" />
                <RowDefinition Height="Auto" MinHeight="30" />
                <RowDefinition Height="Auto" MinHeight="35" />
                <RowDefinition Height="Auto" MinHeight="25" />
                <RowDefinition Height="2" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Grid.RowSpan="6" Height="auto" Width="250"   Fill="#fff" HorizontalAlignment="Right"  RadiusX="7" RadiusY="7" Grid.ColumnSpan="2" />
            <Image Name="Logo" Grid.Row="0"   Width="40"  Margin="20,20,0,0"  Source="../Images/fbicon-64.png"   VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <TextBlock Name="Heading" Grid.Row="0"   Margin="70,30,0,0"    VerticalAlignment="Top"  Foreground="Black" FontSize="14" FontWeight="Semibold" >xFocus Bear Menu</TextBlock>
            <TextBlock Name="Title" Grid.Row="1"   Margin="20,20,0,0"     VerticalAlignment="Top"  Foreground="Black" FontSize="14" FontWeight="Semibold" >Focus Bear </TextBlock>
            <TextBlock Name="Description" Grid.Row="2" TextWrapping="Wrap"  Margin="20,20,20,0"  VerticalAlignment="Top"  Foreground="Black" FontSize="14" FontFamily="Segoe UI" >xLet's get you familiar with the Focus Bear Menu and we will have you up and running in no time!</TextBlock>
            <Grid Grid.Row="4" Background="LightGray" ></Grid>
            <Grid Grid.Row="5" >
                <TextBlock Visibility="Collapsed" Name="Steps" TextWrapping="Wrap"  Margin="20,0,20,0"  VerticalAlignment="Center"  Foreground="Gray" FontSize="12" FontFamily="Segoe UI" >x1 of 3</TextBlock>
                <Button  x:Name="btnNext" AutomationProperties.AutomationId="btnNext" Width="auto" HorizontalAlignment="Right"  Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="26"  VerticalAlignment="Center"  Margin="0,0,20,0" FontSize="13" Cursor="Hand" FontWeight="Semibold" Click="btnNext_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock x:Name="btnNextTXT" Padding="10,0" Text="xGet Started"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </Grid>
        </Grid >
        <Path x:Name="Arrow" StrokeThickness="1" Stroke="White" Fill="White" VerticalAlignment="Bottom" 
              HorizontalAlignment="Right" 
              Margin="0,0,350,90">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="20,0">
                        <PolyLineSegment Points="40,20 20,40"/>
                        <LineSegment Point="20,0" IsStroked="False"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
    </Grid>
</Window>
