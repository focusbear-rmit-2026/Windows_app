<Page x:Class="Focus_Bear.Habits.HabitActivityOnGoing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Habits"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:Models="clr-namespace:Focus_Bear.Models"
      mc:Ignorable="d" 
          d:DesignHeight="1080" d:DesignWidth="1920"
      Title="HabitActivityOnGoing" Background="#fff">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"   />
            <RowDefinition Height="*"  />
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="130"  />

        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Row="0"  Margin="0,50,0,0" Height="180" Width="180" Models:ImageBehavior.AnimatedSource="../Images/gifs/random/4.gif"   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,30,0,0" TextWrapping="Wrap" Text="xActivity Title" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Viewbox Grid.Row="2"  Stretch="Uniform">
            <DockPanel  Margin="50,25,50,25" Width="853" Height="505">
                <wv2:WebView2 Name="webView" />
            </DockPanel>
        </Viewbox>

        <StackPanel x:Name="SectionNonTimer" Grid.Row="3" Orientation="Vertical" Height="85" Visibility="Collapsed">
            <TextBlock  Grid.Row="1"  Name="CompleteAfter" Margin="0,0,0,10" TextWrapping="Wrap" Text="xComplete after: " Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <Button   IsDefault="True" x:Name="btnIAmDone"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnIAmDone_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                        <TextBlock x:Name="btnIAmDoneTXT" Text="xI am Done!"/>
                    </StackPanel>
                </Button.Content>
            </Button>

        </StackPanel>
        <Border x:Name="SectionTimer"  Grid.Row="3" BorderThickness="0" BorderBrush="#edeeee" CornerRadius="17" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="190" Height="85">
            <Grid>
                <Grid.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="320"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="8"
                           />
                </Grid.Effect>
                <!-- Rounded mask (stretches to fill Grid) -->
                <Border Name="mask" Background="#edeeee" CornerRadius="17"/>
                <!-- Main content container -->
                <StackPanel >
                    <!-- Use a VisualBrush of 'mask' as the opacity mask -->
                    <StackPanel.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=mask}"/>
                    </StackPanel.OpacityMask>

                    <!-- Any content -->

                    <TextBlock x:Name="TxtTimer" Margin="0,22,0,0" TextWrapping="Wrap" Text="00:30" Foreground="#000" Padding="0" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Height="30" VerticalAlignment="Center" />

                </StackPanel>

            </Grid>

        </Border>
        <StackPanel Grid.Row="4" Orientation="Vertical"  >
        <Button   x:Name="btnPausePlay"   Style="{StaticResource BtnStylePlay}" IsEnabled="True" Foreground="#e88800"  Height="40" Width="40" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnPausePlay_Click" >
            <Button.Effect>
                <DropShadowEffect ShadowDepth="3"
                          Direction="320"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="8"
                           />
            </Button.Effect>
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <Image Name="pause" Height="24"  Width="24" Source="../Images/pause_icon.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <Image Name="play" Height="24"  Width="24" Source="../Images/play_icon.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <TextBlock x:Name="SkipThisHabitText" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="22" Cursor="Hand" Visibility="Collapsed">
             <Hyperlink x:Name="btnSkipThisHabit"  Foreground="#000" Click="btnSkipThisHabit_Click"   TextDecorations="Underline" ><Run x:Name="btnSkipThisHabitTXT" Text="xSkip this habit for today"/></Hyperlink>
        </TextBlock>
        </StackPanel>
    </Grid>
</Page>
