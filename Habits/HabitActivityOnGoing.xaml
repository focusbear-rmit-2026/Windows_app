<Page x:Class="Focus_Bear.Habits.HabitActivityOnGoing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Habits"
      xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:Models="clr-namespace:Focus_Bear.Models"
      mc:Ignorable="d" 
          d:DesignHeight="1080" d:DesignWidth="1920"
      Title="HabitActivityOnGoing" Background="{DynamicResource BackgroundColor}" AutomationProperties.AutomationId="HabitActivityOnGoing">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"   />
            <RowDefinition Height="*"  />
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="130"  />

        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Row="0"  Margin="0,50,0,0" Height="180" Width="180" Models:ImageBehavior.AnimatedSource="../Images/gifs/random/4.gif"   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <emoji:TextBlock  Grid.Row="1"  Name="Heading" Margin="0,30,0,0" TextWrapping="Wrap" Text="xActivity Title" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Video / Checklist tab switcher (#343): shown ONLY when the activity has BOTH a video and a
                 checklist, so the user can switch between them (macOS parity). Borders (not Buttons) so the
                 active/inactive colours are fully controlled and theme-independent. -->
            <StackPanel x:Name="ChecklistVideoTabs" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
                <Border x:Name="btnTabVideo" MouseLeftButtonUp="btnTabVideo_Click" Cursor="Hand"
                        CornerRadius="17" Height="34" MinWidth="120" Margin="5,0"
                        Background="#e88800" BorderBrush="#e88800" BorderThickness="1">
                    <TextBlock x:Name="btnTabVideoTXT" Text="Video" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                </Border>
                <Border x:Name="btnTabChecklist" MouseLeftButtonUp="btnTabChecklist_Click" Cursor="Hand"
                        CornerRadius="17" Height="34" MinWidth="120" Margin="5,0"
                        Background="Transparent" BorderBrush="#e88800" BorderThickness="1">
                    <TextBlock x:Name="btnTabChecklistTXT" Text="Checklist" FontSize="15" FontWeight="SemiBold"
                               Foreground="#e88800" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Viewbox Stretch="Uniform">
                    <DockPanel  Margin="50,25,50,25" Width="853" Height="505">
                        <wv2:WebView2 Name="webView" />
                    </DockPanel>
                </Viewbox>

                <!-- Checklist steps (#343). Local visual aid only — ticks are held on the ChecklistItem
                     objects (so they survive a pause/resume re-render) and are never saved to the backend;
                     completion is via "I'm done". -->
                <ScrollViewer x:Name="SectionChecklist" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,20,0,10" MaxWidth="700" HorizontalAlignment="Center">
                    <ItemsControl x:Name="ChecklistItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="24,10,24,10"
                                          VerticalContentAlignment="Center" Cursor="Hand">
                                    <emoji:TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="18"
                                                     Foreground="{DynamicResource ForegroundColor}" Margin="10,0,0,0"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel x:Name="SectionNonTimer" Grid.Row="3" Orientation="Vertical" MinHeight="85" Visibility="Collapsed">
            <TextBlock  Grid.Row="1"  Name="CompleteAfter" Margin="0,0,0,10" TextWrapping="Wrap" Text="xComplete after: " FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <Button   IsDefault="True" x:Name="btnIAmDone" AutomationProperties.AutomationId="btnIAmDone"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnIAmDone_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                        <TextBlock x:Name="btnIAmDoneTXT" Text="xI am Done!" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>

        </StackPanel>
        <Border x:Name="SectionTimer"  Grid.Row="3" BorderThickness="0" BorderBrush="#edeeee" CornerRadius="17" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="190" Height="85">
            <Grid>
                <!-- Rounded mask (stretches to fill Grid) -->
                <Border Name="mask" Background="#edeeee" CornerRadius="17"/>
                <!-- Main content container -->
                <StackPanel >
                    <!-- Use a VisualBrush of 'mask' as the opacity mask -->
                    <StackPanel.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=mask}"/>
                    </StackPanel.OpacityMask>

                    <!-- Any content -->

                    <TextBlock x:Name="TxtTimer" Margin="0,22,0,0" TextWrapping="Wrap" Text="00:30" Padding="0" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" MinHeight="30" VerticalAlignment="Center" Foreground="Black" />

                </StackPanel>

            </Grid>

        </Border>
        <StackPanel Grid.Row="4" Orientation="Vertical" VerticalAlignment="Top">
            <Button   x:Name="btnPausePlay" AutomationProperties.AutomationId="btnPausePlay"  Style="{StaticResource BtnStylePlay}" IsEnabled="True" Foreground="#e88800"  Height="40" Width="40" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnPausePlay_Click" >
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="3"
                              Direction="320"
                              Color="Gray"
                              Opacity="0.5"
                              BlurRadius="8"
                               />
                </Button.Effect>
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <Image Name="pause" Height="24"  Width="24" Source="../Images/pause_icon.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        <Image Name="play" Height="24"  Width="24" Source="../Images/play_icon.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <TextBlock x:Name="SkipThisHabitText" AutomationProperties.AutomationId="txtSkipThisHabit" Margin="0,2,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand" Visibility="Collapsed">
                <Hyperlink x:Name="btnSkipThisHabit" AutomationProperties.AutomationId="btnSkipThisHabit"  Click="btnSkipThisHabit_Click"   TextDecorations="Underline" ><Run x:Name="btnSkipThisHabitTXT" Text="xSkip this habit for today"/></Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Floating "Back to Day Plan" button (top-left) — shown only while the habit is paused
             (and not on the last habit). Returns to the Day Plan, keeping this habit paused. -->
        <Button x:Name="btnBackToDayPlan" AutomationProperties.AutomationId="btnBackToDayPlan"
                Grid.Row="0" Grid.RowSpan="5" Style="{StaticResource BtnStyleLightOrangeBordered}"
                Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="17,17,0,0" Padding="0" Cursor="Hand" Visibility="Collapsed"
                Click="btnBackToDayPlan_Click">
            <TextBlock Text="&#x2039;" VerticalAlignment="Center" Margin="0,0,0,7" FontSize="35" Foreground="#EB912E"/>
        </Button>
    </Grid>
</Page>
