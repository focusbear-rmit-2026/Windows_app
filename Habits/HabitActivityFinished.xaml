<Page x:Class="Focus_Bear.Habits.HabitActivityFinished"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Habits"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="HabitActivityFinished" Background="{DynamicResource BackgroundColor}" >
    <Grid x:Name="Grid1">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"   />
            <RowDefinition Height="*"  />
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="Auto"  />

        </Grid.RowDefinitions>
        <Image Grid.Row="0" Name="TopIcon" Height="160"  Width="160" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed"/>
         <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,30,0,0" TextWrapping="Wrap" Text="xactivity finished" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Viewbox Grid.Row="2"  Stretch="Uniform">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="ButtonLeft" AutomationProperties.AutomationId="btnLeft" Height="30" Width="30" Cursor="Hand" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ButtonLeft_Click">
                    <Button.Content>
                        <Image Source="../Images/Back.png"/>
                    </Button.Content>
                </Button>
                <DockPanel Margin="50,25,20,25" Width="853" Height="495">
                    <wv2:WebView2 Name="webView" Visibility="Collapsed" />
                </DockPanel>
                <DockPanel Name="BreakGraph2" Margin="20,25,50,25" Width="853" Height="495"  Visibility="Collapsed">
                    <wv2:WebView2 Name="webView1"  />
                </DockPanel>
                <Button x:Name="ButtonRight" AutomationProperties.AutomationId="btnRight" Height="30" Width="30" Cursor="Hand" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ButtonRight_Click">
                    <Button.Content>
                        <Image Source="../Images/forward.png"/>
                    </Button.Content>
                </Button>
            </StackPanel >
        </Viewbox>
        <TextBlock  Grid.Row="2" Name="sTextTimerWrapUp"  TextWrapping="Wrap" Text="xx30:00" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

        <StackPanel x:Name="LowerButtons" Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Visible">
            <Button   IsDefault="True" x:Name="btnStartNextActivity" AutomationProperties.AutomationId="btnStartNextActivity"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="400"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnStartNextActivity_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal" Margin="20,0,20,0" >
                        <TextBlock x:Name="btnStartNextActivityTXT" Text="xstart next activity" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="SkipThisHabitText" AutomationProperties.AutomationId="txtSkipThisHabit" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
             <Hyperlink x:Name="btnSkipThisHabit" Click="btnSkipThisHabit_Click"   TextDecorations="Underline" ><Run x:Name="btnSkipThisHabitTXT" Text="xSkip this habit for today"/></Hyperlink>
            </TextBlock>
                <TextBlock Margin="10,0,10,0" Name="Seperator">|</TextBlock>
                <TextBlock x:Name="ChooseAnotherHabit" AutomationProperties.AutomationId="txtChooseAnotherHabit" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
             <Hyperlink x:Name="btnChooseAnotherHabit" Click="btnChooseAnotherHabit_Click"   TextDecorations="Underline" ><Run x:Name="ChooseAnotherHabitTXT" Text="xChoose another habit"/></Hyperlink>
            </TextBlock>
            </StackPanel>
        </StackPanel>
        <TextBlock  Grid.Row="4" Name="sTextCompletedDuration" Margin="40,20,40,60" TextWrapping="Wrap" Text="xxLooking forward!" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Page>
