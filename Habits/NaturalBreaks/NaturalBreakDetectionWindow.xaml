<Window x:Class="Focus_Bear.Habits.NaturalBreaks.NaturalBreakDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Habits.NaturalBreaks"
        mc:Ignorable="d"
        Title="Focus Bear" Height="320" Width="350" WindowStyle="None" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" BorderBrush="Black" BorderThickness="1">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
            <Image Width="60" Height="60"  Margin="0" Source="../../Images/FBicon-64.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" VerticalAlignment="Bottom"   HorizontalAlignment="Center"/>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Text="xx"  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,20,20,0"   TextAlignment="Center" />

            <Button  x:Name="btnOK"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,20,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnOK_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnOKTxt" Text="xOK" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button    x:Name="btnCancel"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,0,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Visibility="Visible" Click="btnCancel_Click"  >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnCancelTxt" Text="xCancel"  Padding="15,0,15,0" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <CheckBox x:Name="chkDontShowAgain" AutomationProperties.AutomationId="chkDontShowAgain" HorizontalAlignment="Center" Margin="20,0,20,15" Checked="chkDontShowAgain_Checked">
                <TextBlock x:Name="chkDontShowAgainTxt" Text="xDon't show this again" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
    </Grid>
</Window>
