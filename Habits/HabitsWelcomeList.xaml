<Page x:Class="Focus_Bear.Habits.HabitsWelcomeList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Habits"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
     d:DesignHeight="1080" d:DesignWidth="1920"
      Title="HabitsWelcomeList" AutomationProperties.AutomationId="HabitsWelcomeListWindow" Background="{DynamicResource BackgroundColor}" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid x:Name="Normal">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="81" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" MinHeight="140" />

        </Grid.RowDefinitions>
 
        <Image Grid.Row="0" Name="TopIcon" Height="160"  Width="160" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xGood Morning! Here are the habits to kick off an awesome day." Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DoNoHaveTime" AutomationProperties.AutomationId="txtDoNoHaveTime" Grid.Row="2" Margin="20,0,20,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" MinHeight="22" Cursor="Hand">
             <Hyperlink x:Name="btnDoNoHaveTime" Click="btnDoNoHaveTime_Click"   TextDecorations="Underline" ><Run x:Name="DoNoHaveTimeTXT" Text="xI don't have time for all these habits"/></Hyperlink>
            </TextBlock>

            <ListView Grid.Row="3" MaxHeight="360" AutomationProperties.AutomationId="lvActivities" MaxWidth="400" Margin="13,5,16,10" x:Name="ListActivities" VerticalAlignment="Center"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}" >
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" >
                    <Setter Property="Focusable" Value="true"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate >

                <DataTemplate>
                    <Grid x:Name="NavBarItemHeader" Height="40"  Background="Transparent"  Margin="0,2,0,5" IsHitTestVisible="True" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding SNumber, StringFormat=\{0\}}"   FontSize="23" FontWeight="Semibold" VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActivityName, StringFormat=\{0\}}" FontSize="23" VerticalAlignment="Center" Margin="0,0,15,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}">
                             
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
 
        </ListView>
            <Button Grid.Row="4" IsDefault="True"  x:Name="btnBegin" AutomationProperties.AutomationId="btnBegin"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Height="40" Width="300" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnBegin_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnBeginTXT" Text="xBegin" Style="{DynamicResource ButtonTextBlockStyle}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Row="5" x:Name="btnCustomizeHabits" AutomationProperties.AutomationId="btnCustomizeHabits"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"    Height="40" Width="300" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnCustomizeHabits_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnCustomizeHabitsTXT" Text="xCustomize my habits first" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
            </Button>
        
        </Grid>
        <Grid x:Name="WebGrid" Visibility="Collapsed" Margin="0,70,0,50">
            <Viewbox   Stretch="Uniform">
                <DockPanel  Margin="0" Width="853" Height="505">
                    <wv2:WebView2 Name="webView" />
                </DockPanel>
            </Viewbox>
        </Grid>

        <Popup Name="MyPopup" AutomationProperties.AutomationId="popupRemove" PlacementTarget="{Binding ElementName=ListActivities}" Placement="Right" StaysOpen="True"  AllowsTransparency="True" >
            <Grid Width="209" Height="auto"  Background="{x:Null}">
                <Border Name="PopupBorder" Background="LightGoldenrodYellow" BorderBrush="Orange" BorderThickness="1" Margin="0,0,0,0" CornerRadius="7">
                    <StackPanel>
                        <TextBlock Name="PopupTitle" TextWrapping="Wrap" Margin="10,10" Text="xSome habits which are past the cutoff time you set have been removed from the list." FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
        
    </Grid>
 
</Page>
