<Window x:Class="Focus_Bear.Habits.DayPlan.DayPlanAddTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Habits.DayPlan"
        mc:Ignorable="d"
        Title="Focus Bear" AutomationProperties.AutomationId="DayPlanAddTasksWindow"
        SizeToContent="Height" Width="520" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource ForegroundColor}">
    <!--
        "From to-do list" picker for the Day Plan tasks panel (M7). Lists the user's recent to-dos
        (GET to-do/recent, cached in appSettings.sAllTasks), excluding completed ones and any already
        on the day. Checked items become DayPlanTasks on the selected day. Deliberately mirrors the
        app's dialog chrome (borderless orange frame, Cancel on the left / primary Add on the right).
    -->
    <Border BorderBrush="#e88800" BorderThickness="1">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="Heading" Text="From to-do list"
                       FontSize="16" FontWeight="Normal" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ForegroundColor}"/>

            <!-- Search -->
            <TextBox Grid.Row="1" x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" Height="30" Margin="20,10,20,6"
                     VerticalContentAlignment="Center" Padding="6,0,6,0"
                     FontSize="13" TextChanged="SearchBox_TextChanged"/>

            <Border Grid.Row="2" BorderBrush="#7F7F7F" BorderThickness="1" CornerRadius="6" Margin="20,4,20,12">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Loading…" Margin="16"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundGrey}"/>
                    <ScrollViewer x:Name="ListScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="TasksList" Orientation="Vertical" Margin="10,10,10,10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Cancel on the left, primary Add on the right. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button x:Name="btnCancel" AutomationProperties.AutomationId="btnCancel"
                        Style="{StaticResource BtnStyleClearOrangeBordered}" Width="160" MinHeight="35"
                        HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16"
                        Cursor="Hand" FontWeight="Semibold" IsCancel="True" Click="btnCancel_Click">
                    <TextBlock x:Name="btnCancelText" Margin="8" Text="Cancel" Foreground="Black"/>
                </Button>
                <Button x:Name="btnAdd" AutomationProperties.AutomationId="btnAdd" IsDefault="True"
                        Style="{StaticResource BtnStyleLightOrangeBordered}" Width="160" MinHeight="35"
                        HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16"
                        Cursor="Hand" FontWeight="Semibold" Click="btnAdd_Click">
                    <TextBlock x:Name="btnAddText" Margin="8" Text="Add" Foreground="Black"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
