<Page x:Class="Focus_Bear.Habits.HabitsPostponedView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Habits"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{DynamicResource BackgroundColor}" IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="HabitsPostponedView">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

       <TextBlock Name="Heading"   Grid.Row="0" Margin="15,40,15,0" TextWrapping="Wrap" Text="xRoutine is postponed... " FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
 

        <Button Grid.Row="1" x:Name="btnResumeHabits" AutomationProperties.AutomationId="btnResumeHabits"  Style="{StaticResource  BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="45" HorizontalContentAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="0,0,0,40" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnResumeHabits_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnResumeHabitsText" Margin="15,0,15,0" Text="xResume Habits" Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
        </Button>

    </Grid>
</Page>
