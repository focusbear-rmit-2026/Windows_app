<Window x:Class="Focus_Bear.Habits.ChooseAnotherHabit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Habits"
        mc:Ignorable="d"
        Title="xChoose another habit" Height="550" Width="500" WindowStyle="ToolWindow" Topmost="True" ResizeMode="NoResize" >
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="20,0,20,0" Name="Heading" TextWrapping="Wrap" Text="xChoose the next habit to do from the following options:" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Left"/>

        <ListView Grid.Row="1" Margin="15,0,20,0" x:Name="ListHabits" AutomationProperties.AutomationId="lvHabits" VerticalAlignment="Top"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Cursor="Hand" SelectionChanged="ListHabits_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" >
                    <Setter Property="Focusable" Value="True" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate >

                <DataTemplate>
                    <Grid x:Name="NavBarItemHeader" Height="25"  Background="Transparent"  Margin="0,2,0,5" IsHitTestVisible="True" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SNumber, StringFormat=\{0\}}" FontSize="15"   FontWeight="Semibold" VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActivityName, StringFormat=\{0\}}" VerticalAlignment="Center" Margin="0,0,15,0" HorizontalAlignment="Left" Foreground="{DynamicResource ForegroundColor}" >

                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button Grid.Row="2"   x:Name="btnStart" AutomationProperties.AutomationId="btnStart"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Height="40"  MinWidth="200" HorizontalAlignment="Center"  HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontWeight="Semibold" Click="btnStart_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnStartTXT" Margin="8" Text="xStart...." Style="{DynamicResource ButtonTextBlockStyle}"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <TextBlock x:Name="Cancel" AutomationProperties.AutomationId="txtCancel" Grid.Row="3" Margin="20,0,20,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="14" MinHeight="22" Cursor="Hand">
             <Hyperlink x:Name="btnCancel" Click="btnCancel_Click"   TextDecorations="Underline" ><Run x:Name="CancelTXT" Text="xCancel"/></Hyperlink>
        </TextBlock>
    </Grid>
</Window>
