<local:FullScreenParent x:Class="Focus_Bear.Habits.HabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Habits"
        mc:Ignorable="d"
        Title="HabitWindow" Height="850" Width="900"   PreviewKeyDown="Window_PreviewKeyDown" WindowState="Maximized" WindowStyle="None" Closed="Window_Closed">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        
       
        
        <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xStay Focused...." Foreground="#e88800" FontSize="40" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Frame x:Name="AppFrameHabitScreens" Margin="0" NavigationUIVisibility="Hidden"   Grid.Row="1" Grid.Column="1" Foreground="{x:Null}" Visibility="Collapsed"  />
        <Frame x:Name="AppFrameLogQuantity" Margin="0" NavigationUIVisibility="Hidden"  Grid.Row="1" Grid.Column="1" Foreground="{x:Null}" Visibility="Collapsed" Opacity="0.5" />

       
        <Button   x:Name="btnPleaseSpareMe" IsDefault="False"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="180" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="14" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnPleaseSpareMe_Click"  >
            <Button.Content>
                <StackPanel  Orientation="Horizontal" Margin="5,2,0,0" VerticalAlignment="Center">
                    <Image Source="../Images/spare.png" Width="25" Height="25" HorizontalAlignment="Left"></Image>
                    <TextBlock Name="btnPleaseSpareMeTXT" Margin="8,8" Text="xPlease Spare Me "/>
                </StackPanel>
            </Button.Content>
        </Button>
        
        <Border x:Name="GridShade" CornerRadius="0" Grid.RowSpan="8" Margin="0,0,0,0" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed"  />

        <Grid x:Name="GridLogQuantityNag"  Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="280" Width="498" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="120"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="HeadingLogQuantity" Margin="0,0,0,0" TextWrapping="Wrap" Text="xxLog Quantity of activity" Foreground="#000" FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="1" Name="HeadingLogQuantityQuestion" Margin="0,0,0,0" TextWrapping="Wrap" Text="xxHow much did you do?" Foreground="#000" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox  Grid.Row="2" TabIndex="0" x:Name="Quantity"  Height="30"  Width="200" Margin="0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" PreviewTextInput="Quantity_PreviewTextInput" PreviewKeyDown="Quantity_PreviewKeyDown" PreviewKeyUp="Quantity_PreviewKeyUp">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <StackPanel  Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button    x:Name="btnCancel"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="160" Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontFamily="Segoe UI Semibold"  Click="btnCancel_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnCancelText" Margin="8" Text="xCancel"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button   x:Name="btnOK" IsDefault="True"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="160" Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnOK_Click"  >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnOKText" Margin="8" Text="xOK"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
 
        </Grid>

        <Grid x:Name="GridWhyDoYouWantToSkip"  ZIndex="9" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="280" Width="498" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="130"/>
                 <RowDefinition Height="50"/>
                <RowDefinition Height="120"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="HeadingWhySkip" Margin="0,0,0,0" TextWrapping="Wrap" Text="xxWhy do you want to skip?" Foreground="#000" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            
            <StackPanel  Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button    x:Name="btnAlreadyDidIt"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True" Foreground="#e88800" MinWidth="160" Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold"  Click="btnAlreadyDidIt_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnAlreadyDidItTXT" Margin="8" Text="xI already did it" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button   x:Name="btnCantDoItToday" IsDefault="True"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" MinWidth="160" Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnCantDoItToday_Click"  >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnCantDoItTodayTXT" Margin="8" Text="xCan't do it today"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>

        </Grid>

        <Grid x:Name="GridSkippingHabitIn"  Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Height="280" Width="498" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="120"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Name="HeadingSkippingIn" Margin="0,0,0,0" TextWrapping="Wrap" Text="xxSkipping habit in" Foreground="#000" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="1" Name="HeadingSkippingInTimer" Margin="0,0,0,0" TextWrapping="Wrap" Text="00:15" Foreground="#000" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
           
            <Button  Grid.Row="3"   x:Name="btnChangedMyMind" IsDefault="True"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="360" Height="35" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnChangedMyMind_Click"  >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnChangedMyMindTXT" Margin="8" Text="xI changed my mind - I will do"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

    </Grid>
</local:FullScreenParent>
