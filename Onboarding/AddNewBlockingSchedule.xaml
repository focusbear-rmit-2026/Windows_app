<Page x:Class="Focus_Bear.Onboarding.AddNewBlockingSchedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" >

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid>

            <Grid.RowDefinitions>
                <!-- Top progress take only required height -->
                <RowDefinition Height="1.5*" />

                <!-- Content fills remaining space -->
                <RowDefinition Height="6.5*" />

                <!-- Buttons take only required 15% height -->
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>
            <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
                                    Step1Percentage="100" 
                                    Step2Percentage="30" Step1ImageSource="../images/new/tick.png" Step1LabelColor="#EB912E" Step2LabelColor="#EB912E"  />
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43*" />
                    <RowDefinition Height="47*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image MaxHeight="260"  MaxWidth="260" Source="../Images/new/bear_askBlockingSchedule.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                    <!-- SPEECH BUBBLE -->
                    <controls:SpeechBubble x:Name="Bubble1"
                                        Text="xAn automatic blocking schedule helps me to nudge you at certain times"
                                        Direction="Right" FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                        <controls:SpeechBubble.RenderTransform>
                            <!-- Move LEFT of image -->
                            <TranslateTransform X="-220" Y="-30"/>
                        </controls:SpeechBubble.RenderTransform>

                    </controls:SpeechBubble>

                </Grid>
                <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xAdd a New Blocking Schedule" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock  Name="Description" Margin="0,10,0,0" TextWrapping="Wrap" Text="xYou can have distracting sites and apps blocked during work hours or at night ⏰" FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
                

            </Grid>

            <StackPanel  Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnAddNewBlock" AutomationProperties.AutomationId="btnAddNewBlock"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnAddNewBlock_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnAddNewBlockText" Margin="8" Text="xAdd New Block" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <TextBlock  x:Name="Skip" AutomationProperties.AutomationId="Skip"  TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
                     <Hyperlink x:Name="btnSkip"   Click="btnSkip_Click"  TextDecorations="Underline" ><Run x:Name="btnSkipText" Text="xSkip"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
        
    </Grid>
    
</Page>

