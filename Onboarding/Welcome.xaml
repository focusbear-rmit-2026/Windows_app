<Page x:Class="Focus_Bear.Onboarding.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <!-- Content fills remaining space -->
            <RowDefinition Height="8*" />

            <!-- Buttons take only required height -->
            <RowDefinition Height="2*" />
            <!-- reserve space for the hyperlink button and others-->
            <RowDefinition Height="40" />
            <RowDefinition Height="1" />
            <RowDefinition Height="40" />
       
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image MaxHeight="260"  MaxWidth="260" Source="../Images/new/bear_welcome.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
            Text="xHowdy! I'm Focus Bear Junior"
            Direction="Right"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"> 

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-235" Y="-30"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>

        <Button Grid.Row="1"   x:Name="btnHowdy" AutomationProperties.AutomationId="btnHowdy"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Bottom" Padding="0" Margin="7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnHowdy_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnHowdyText" Margin="8" Text="xHowdy!" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <TextBlock  Grid.Row="2" x:Name="HaveAccount" AutomationProperties.AutomationId="txtHaveAccount"  TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
             <Hyperlink x:Name="btnHaveAccount"   Click="btnHaveAccount_Click"   TextDecorations="Underline" ><Run x:Name="btnHaveAccountText" Text="xI already have a Focus Bear account"/></Hyperlink>
        </TextBlock>
        <Grid Grid.Row="3" Margin="0,0,0,0" Background="#454545"/>

        <TextBlock  Grid.Row="4" Name="Copyright"   TextWrapping="Wrap" Text="xx© 2022-2026 Focus Bear, All Rights Reserved." FontSize="12" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
      
    </Grid>
</Page>

