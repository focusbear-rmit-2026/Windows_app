<Page x:Class="Focus_Bear.Onboarding.OnboardingGoals"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingGoals" Background="#fff">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="185" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="*"  />
            <RowDefinition Height="180" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="135"  Width="135" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWelcome to Focus Bear" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel  Grid.Row="2"  Orientation="Vertical" VerticalAlignment="Center"  Margin="0,0,0,0">
            <TextBlock  Name="WhatGoals" Margin="0,0,0,50" TextWrapping="Wrap" Text="xWhat are your Goals?" Foreground="#272727" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Width="700"  Margin="20,0,0,0">
                <CheckBox x:Name="HealthyHabits" FontSize="18" Checked="HealthyHabits_Checked" Unchecked="HealthyHabits_Unchecked" Cursor="Hand"></CheckBox>
                <TextBlock  Name="TXTCheckBoxHealthyHabits" Margin="15,-6,0,0" Height="90" Width="650" TextWrapping="Wrap" Text="xHelp me develop healthy habits in the morning (e.g. meditate before starting work) and evening (e.g. have dinner with loved ones)" Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Width="700" Margin="20,0,0,0">
                <CheckBox x:Name="StayFocused" FontSize="18" Checked="StayFocused_Checked" Unchecked="StayFocused_Unchecked" Cursor="Hand"></CheckBox>
                <TextBlock  Name="TXTCheckBoxFocused" Margin="15,-6,0,0" Height="70" Width="650" TextWrapping="Wrap" Text="xHelp me stay focused during the work day" Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="3"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800"  Height="40" Width="400" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
