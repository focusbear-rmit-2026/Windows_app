<Page x:Class="Focus_Bear.Onboarding.OnboardingGoals"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingGoals" Background="#fff">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="185" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="*"  />
            <RowDefinition Height="180" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="135"  Width="135" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWelcome to Focus Bear" Foreground="#e88800" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel  Grid.Row="2"  Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="0,0,0,0">
            <TextBlock  Name="WhatGoals" Margin="0,0,0,50" TextWrapping="Wrap" Text="xWhat are your Goals?" Foreground="#272727" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Width="300"  Margin="20,0,0,0">
                <CheckBox x:Name="HealthyHabits" FontSize="18" Checked="HealthyHabits_Checked" Unchecked="HealthyHabits_Unchecked" Cursor="Hand"></CheckBox>
                <TextBlock  Name="TXTCheckBoxHealthyHabits" Margin="15,-6,0,0" Height="60"  TextWrapping="Wrap" Text="xBuild healthy habits" Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <Image x:Name="InfoHealthyHabits"   Source="../images/info.png" Width="18"  Margin="10,-2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"   ></Image>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Width="300" Margin="20,0,0,0">
                <CheckBox x:Name="StayFocused" FontSize="18" Checked="StayFocused_Checked" Unchecked="StayFocused_Unchecked" Cursor="Hand"></CheckBox>
                <TextBlock  Name="TXTCheckBoxFocused" Margin="15,-6,0,0" Height="60"   TextWrapping="Wrap" Text="xStay focused at work " Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <Image x:Name="InfoStayFocused"   Source="../images/info.png" Width="18" Margin="10,-2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"   ></Image>
            </StackPanel>
            <TextBlock  Name="AnythingElse" Margin="0" Height="50" Width="550" TextWrapping="Wrap" Text="xAnything else you hope Focus Bear can help with? (We'll try to take your feedback on board)" Foreground="#000" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
            <TextBox   TabIndex="0" x:Name="AnythingElseVALUE" Margin="0,15,0,0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="18" TextAlignment="Left" MaxLines="1" Height="30" TextChanged="AnythingElseVALUE_TextChanged">

            </TextBox>
        </StackPanel>

        <Button Grid.Row="3"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
