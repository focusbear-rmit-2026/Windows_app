<Page x:Class="Focus_Bear.Onboarding.OnboardingWelcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingWelcome" Loaded="Page_Loaded">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="105" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="Auto" MinHeight="270" />
            <RowDefinition Height="*"  />
            <RowDefinition Height="120" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xLet's take a quick 30 second break" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <StackPanel  Grid.Row="2"  Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Name="Suggest" Margin="0,0,10,0" TextWrapping="Wrap" Text="xTaking breaks throughout the day helps with stress and focus." FontSize="23" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <Button x:Name="btnInfo" Style="{StaticResource BtnStyleInfo}" Click="btnInfo_Click"  MinWidth="35" Height="35" Cursor="Hand" >
                <StackPanel Orientation="Vertical">
                    <Image Source="../images/info.png" Margin="0,0,0,0" Height="24" Width="24" />
                </StackPanel>
            </Button>
        </StackPanel>
        
        <TextBlock  Grid.Row="2" Name="Description" Visibility="Collapsed" Margin="180,0,180,0" TextWrapping="Wrap" Text="xEvery morning, I will help you quiet your urge to check email/Facebook and help you to do your morning routine instead. You can configure your own routine later but for now, I'll give you a suggested activity: 30 seconds of mindful breathing. While you breathe deeply, think of how awesome you'll be if you stick to your morning routine every day."  FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />

         
            <StackPanel Grid.Row="3"  Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock    Name="WhatActivity" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWhat 30 seconds of activity do you want to do?" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <ComboBox Name="ComboBoxActivityType"    Width="200" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,30,0,0"    FontSize="15" SelectionChanged="ComboBoxActivityType_SelectionChanged">
            </ComboBox>
            <TextBlock    Name="ActivityName" Margin="0,10,0,0" TextWrapping="Wrap" Text="xEnter name of activity" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            <TextBox    Height="30" x:Name="TxtSomethingElse"    Margin="0,30" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" Width="341" Visibility="Collapsed" TextChanged="TxtSomethingElse_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
        </StackPanel>
        
        <Button Grid.Row="4"  x:Name="btnStartMindfulBreathing"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" MinWidth="400" HorizontalAlignment="Center" HorizontalContentAlignment="Center"  VerticalAlignment="Top" Padding="0" Margin="0,30,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnStartMindfulBreathing_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal" Margin="20,0,20,0">
                    <TextBlock x:Name="btnStartMindfulBreathingTXT" Text="xMindful Breathing" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
