<Page x:Class="Focus_Bear.Onboarding.SetupDistractionBlocking"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="SetupDistractionBlocking">

    <Grid>
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <!-- Top progress take only required height -->
                <RowDefinition Height="1.5*" />

                <!-- Content fills remaining space -->
                <RowDefinition Height="6.5*" />

                <!-- Buttons take only required height -->
                <RowDefinition Height="1.5*" />

            </Grid.RowDefinitions>
            <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
                          Step1Percentage="0" 
                          Step2Percentage="0" />
            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <!-- Content fills remaining space -->
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="7*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xSet up Scheduled Distraction Blocking" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock  Name="Description" Margin="0,10,0,0" TextWrapping="Wrap" Text="xHere’s what it will look like:" FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>

                <Image Grid.Row="1" Source="../Images/new/setDistraction.png" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center"  />

            </Grid>

            <StackPanel  Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnNoThanks" AutomationProperties.AutomationId="btnNoThanks"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNoThanks_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnNoThanksText" Margin="8" Text="xNo Thanks" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="btnSetupDistractionBlocking" AutomationProperties.AutomationId="btnSetupDistractionBlocking"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="43" MinWidth="300" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnSetupDistractionBlocking_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnSetupDistractionBlockingText" Margin="8" Text="xSet up distraction blocking" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Grid>
        <!-- Floating element -->
        <Grid Height="270" x:Name="SideImage"
                 Background="Transparent"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Panel.ZIndex="99" Margin="0,150,-45,0">    
            <!-- ensures it's on top -->
            <Image Source="../Images/new/bear_setDistraction.png" Stretch="Uniform"/>
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
                     Text="xSet up distraction blocking in two quick steps!"
                     Direction="Right" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" FontSize="13">  

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-160" Y="-40"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>
    </Grid>
       
</Page>

