<UserControl x:Class="Focus_Bear.Onboarding.OnboardingViewController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Onboarding"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" AutomationProperties.AutomationId="OnboardingViewController">
    <Grid>
        <!-- Main content -->
        <Frame x:Name="OnboardingFrame"
           NavigationUIVisibility="Hidden"
           JournalOwnership="OwnsJournal"/>

        <!-- Floating Back Button -->
        <Button x:Name="BtnBack" AutomationProperties.AutomationId="btnBack"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="40" Height="40" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" Margin="17,17" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="BtnBack_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock  Text="‹" VerticalAlignment="Center" Margin="0,0,0,7" FontSize="35" Foreground="#EB912E"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
