<Page x:Class="Focus_Bear.Onboarding.OnboardingAskOccupation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Focus Bear" Background="#fff">

    <Grid>
        

        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="105" />
            <RowDefinition Height="40" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWelcome to Focus Bear" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="2" Name="Occupation" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWhich of the following best describes your occupation?" Foreground="#272727" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"  />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0">
                <RadioButton x:Name="RadioButton1" GroupName="Occupation1"  Margin="20,10" Content="xUniversity student" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"   Checked="RadioButton1_Checked" Cursor="Hand"  Click="RadioButton1_Click" />
                <RadioButton x:Name="RadioButton2" GroupName="Occupation2" Margin="20,10"  Content="xSoftware dev" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton2_Checked" Cursor="Hand" Click="RadioButton2_Click" />
                <RadioButton x:Name="RadioButton3" GroupName="Occupation3" Margin="20,10"  Content="xGraphic designer" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton3_Checked" Cursor="Hand" Click="RadioButton3_Click" />
                <RadioButton x:Name="RadioButton4" GroupName="Occupation4" Margin="20,10"  Content="xBusiness owner" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton4_Checked" Cursor="Hand"  Click="RadioButton4_Click"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Column="1">
                <RadioButton x:Name="RadioButton5" GroupName="Occupation5"   Margin="20,10" Content="xOther office work" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"   Checked="RadioButton5_Checked" Cursor="Hand" Click="RadioButton5_Click" />
                <RadioButton x:Name="RadioButton6" GroupName="Occupation6"  Margin="20,10"  Content="xField worker (not in front of computer)" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton6_Checked" Cursor="Hand" Click="RadioButton6_Click"  />
                <RadioButton x:Name="RadioButton7" GroupName="Occupation7"   Margin="20,10"  Content="xParent (setting it up for child)" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton7_Checked" Cursor="Hand" Click="RadioButton7_Click" />
                <RadioButton x:Name="RadioButton8" GroupName="Occupation8"  Margin="20,10"  Content="xOther" FontSize="18" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton8_Checked" Cursor="Hand" Click="RadioButton8_Click" />
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="1"  MinHeight="30" x:Name="TxtOtherJob" MaxLength="250"  TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,5,5,5"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" Width="456" Visibility="Visible" HorizontalAlignment="Center" TextChanged="TxtOtherJob_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
        </Grid>
        
        <Button Grid.Row="5"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
