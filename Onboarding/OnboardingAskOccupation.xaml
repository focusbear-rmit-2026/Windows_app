<Page x:Class="Focus_Bear.Onboarding.OnboardingAskOccupation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Focus Bear">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.Background>
            <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="100" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="50" />
            <RowDefinition Height="130" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWelcome to Focus Bear" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="2" Name="Occupation" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWhich of the following best describes your occupation?" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Bottom">
            <TextBlock  Name="Description"   TextWrapping="Wrap" Text="xThis will be used to recommend the most suitable features for your work."  FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <Image x:Name="InfoDescription"   Source="{DynamicResource InfoImage}" Width="20"  Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"   ></Image>
        </StackPanel>
        
        <Grid Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0">
           
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"  />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <RadioButton x:Name="RadioButton1" GroupName="Occupation1" Width="230"  Margin="10,10" Content="xUniversity student" FontSize="16" Style="{StaticResource OccupationRadioButtonStyle}"   Checked="RadioButton1_Checked" Cursor="Hand"   />
                <RadioButton x:Name="RadioButton2" GroupName="Occupation1" Width="230" Margin="10,10"  Content="xBusiness owner" FontSize="16" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton2_Checked" Cursor="Hand"  />
                <RadioButton x:Name="RadioButton3" GroupName="Occupation1" Width="230"  Margin="10,10" Content="xEmployee" FontSize="16" Style="{StaticResource OccupationRadioButtonStyle}"   Checked="RadioButton3_Checked" Cursor="Hand"  />
                <RadioButton x:Name="RadioButton4" GroupName="Occupation1" Width="200" Margin="10,10"  Content="xFreelancer" FontSize="16" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton4_Checked" Cursor="Hand"  />
                <RadioButton x:Name="RadioButton5" GroupName="Occupation1" Width="200" Margin="10,10"  Content="xOther" FontSize="16" Style="{StaticResource OccupationRadioButtonStyle}"  Checked="RadioButton5_Checked" Cursor="Hand"  />
            </StackPanel>
           
        </Grid>
        <Grid Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="30,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" ></ColumnDefinition>
                <ColumnDefinition Width="250" ></ColumnDefinition>
                <ColumnDefinition Width="250" ></ColumnDefinition>
                <ColumnDefinition Width="220" ></ColumnDefinition>
                <ColumnDefinition Width="220" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="OptionsStudent" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Visibility="Collapsed" >
                <TextBlock  Name="TitleUniversityStudent"   TextWrapping="Wrap" Margin="0,0" Text="xSelect level of study:"  FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <RadioButton x:Name="Study1" GroupName="UniversityStudent" Width="250"  Margin="0,10" Content="xHigh school" FontSize="15"  Cursor="Hand"   />
                <RadioButton x:Name="Study2" GroupName="UniversityStudent" Width="250" Margin="0,10"  Content="xUndergraduate" FontSize="15"  Cursor="Hand" />
                <RadioButton x:Name="Study3" GroupName="UniversityStudent" Width="250"  Margin="0,10" Content="xGraduate" FontSize="15" Cursor="Hand" />
                <RadioButton x:Name="Study4" GroupName="UniversityStudent" Width="250" Margin="0,10"  Content="xPostgraduate xPostgraduate xPostgraduate xPostgraduate " FontSize="15"   Cursor="Hand"  />
                <Border BorderBrush="#f9e98e" BorderThickness="2" Width="250" Height="70" Margin="0,5,0,0">
                    <Grid Background="#fefbec"    >
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock x:Name="PayForFee" VerticalAlignment="Top"  Margin="5,5,5,0" TextWrapping="Wrap" Width="240" FontSize="13" Foreground="Black"> xFYI your university might be able to pay for premium access to Focus Bear. Email support@focusbear.io for details."
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Name="OptionsEmployee" Visibility="Collapsed" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left" >
                <TextBlock  Name="TitleEmployee"   TextWrapping="Wrap" Margin="0,0" Text="xType of work:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <RadioButton x:Name="Employee1" GroupName="Employee" Width="250"  Margin="0,10" Content="xProgrammer" FontSize="15" Checked="Employee1_Checked" Cursor="Hand"  />
                <RadioButton x:Name="Employee2" GroupName="Employee" Width="250" Margin="0,10"  Content="xGraphic designer" FontSize="15" Checked="Employee2_Checked" Cursor="Hand"  />
                <RadioButton x:Name="Employee3" GroupName="Employee" Width="250"  Margin="0,10" Content="xOther work from office" FontSize="15" Checked="Employee3_Checked" Cursor="Hand"  />
                <TextBox  Height="34" Visibility="Collapsed" x:Name="TxtOtherOfficeWOrk" MaxLength="200"  TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,5,5,5" VerticalAlignment="Top"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" Width="185" HorizontalAlignment="Left" >
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
                <RadioButton x:Name="Employee4" GroupName="Employee" Width="250" Margin="0,10"  Content="xNon desk based work" FontSize="15"   Checked="Employee4_Checked" Cursor="Hand" />
                <TextBox  Height="34" Visibility="Collapsed" x:Name="TxtNonDeskBasedWork" MaxLength="200"  TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,5,5,5" VerticalAlignment="Top"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" Width="185"  HorizontalAlignment="Left" >
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
            </StackPanel>
            <StackPanel Name="OptionsFreelancer" Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Left" Visibility="Collapsed" >
                <TextBlock  Name="TitleFreelancer"   TextWrapping="Wrap" Margin="0,0,0,15" Text="xType of work:" FontSize="15" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <TextBox Grid.Column="4"  Height="34" x:Name="TxtFreelancer" MaxLength="200"  TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,5,5,5" VerticalAlignment="Top"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" Width="185" Visibility="Visible" HorizontalAlignment="Left" >
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
            </StackPanel>
            <TextBox Visibility="Collapsed" Grid.Column="4"  Height="34" x:Name="TxtOtherJob" MaxLength="200"  TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,5,5,5" VerticalAlignment="Top"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" Width="195" HorizontalAlignment="Left"  >
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
        </Grid>
        <Button Grid.Row="6"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
