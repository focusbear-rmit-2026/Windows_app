<Page x:Class="Focus_Bear.Onboarding.SetupHabits"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <!-- Content fills remaining space -->
                <RowDefinition Height="8*" />

                <!-- Buttons take only required height -->
                <RowDefinition Height="2*" />

            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <!-- Content fills remaining space -->
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xHold on a minute!" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock  Name="Description" Margin="0,10,0,0" TextWrapping="Wrap" Text="xResearch shows that habits like sleeping better, meditating, and exercising improve your focus" FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>

                <Image Grid.Row="1" MaxHeight="260"  Source="../Images/new/bear_setHabitsAll.png" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center"  />

            </Grid>

            <StackPanel  Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                <Button x:Name="btnOkay" AutomationProperties.AutomationId="btnOkay"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnOkay_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnOkayText" Margin="8" Text="xOkay..." Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <TextBlock  Grid.Row="2" x:Name="Skip" AutomationProperties.AutomationId="Skip"  TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
                <Hyperlink x:Name="btnSkip"   Click="btnSkip_Click"   TextDecorations="Underline" ><Run x:Name="btnSkipText" Text="xSkip"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
        <!-- Floating element -->
        <Grid Height="270" x:Name="SideImage"
                 Background="Transparent"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Panel.ZIndex="99" Margin="0,-150,-35,0">    
            <!-- ensures it's on top -->
            <Image Source="../Images/new/bear_setHabits.png" Stretch="Uniform"/>
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
                     Text="xWe will never compromise on your privacy!"
                     Direction="Right" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" FontSize="13">  

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-150" Y="-40"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>
    </Grid>
       
</Page>

