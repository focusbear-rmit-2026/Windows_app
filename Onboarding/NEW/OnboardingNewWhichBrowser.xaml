<Page x:Class="Focus_Bear.Onboarding.NEW.OnboardingNewWhichBrowser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.NEW"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Height="660" Width="750"
      Title="OnboardingNewWelcome">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="400" />
            <RowDefinition Height="80" />
            <RowDefinition Height="100" />

        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Margin="0,10,0,0" Name="Heading" TextWrapping="Wrap" Text="xOops! Which browser did you try?" Foreground="{DynamicResource ForegroundColor}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>

        <Image Grid.Row="1"  Margin="0,10,0,0"  Source="../../images/img_browsers.png" Stretch="Uniform" Height="350"  VerticalAlignment="Top" HorizontalAlignment="Center"   />
        <TextBlock  Grid.Row="2" Name="Welcome" Margin="40,0,40,0" TextWrapping="Wrap" Text="xDid you use Google Chrome, Firefox, Brave Browser or Microsoft Edge?\nWe can only block if you use those browsers." Foreground="{DynamicResource ForegroundColor}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>


        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="0,0,10,0"   x:Name="btnDidntBlocked"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="216" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnDidntBlocked_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnDidntBlockedText" Margin="8" Text="xStill not working" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Margin="10,0,0,0"   x:Name="btnItWorked"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="43" MinWidth="216"  HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnItWorked_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnItWorkedText" Margin="8" Text="xI just tried those browsers and it worked!" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
        </StackPanel>

    </Grid>
</Page>
