<Page x:Class="Focus_Bear.Onboarding.NEW.OnboardingNewBlockingSchedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.NEW"
      mc:Ignorable="d" 
     d:DesignHeight="450" d:DesignWidth="800" Height="660" Width="750"
      Title="OnboardingNewBlockingSchedule">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Background>
            <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />

        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Margin="0,10,0,0" Name="Heading" TextWrapping="Wrap" Text="xBlocking Schedule"  FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1" Name="Welcome" Margin="0,0" TextWrapping="Wrap" Text="xWhen do you want to block distracting sites?"  FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel  Grid.Row="2" Orientation="Vertical" Margin="60,0,10,0" >
            <RadioButton x:Name="RadioButton1" GroupName="Occupation1"  Margin="10,10,0,10" Content="xUntil I finish work" FontSize="16" FontWeight="Bold"    Checked="RadioButton1_Checked" Cursor="Hand" Padding="5,-5,0,0"  />
            <TextBlock  Name="Description1" Margin="30,0,40,20" TextWrapping="Wrap" Text="xFocus Bear will block the distracting sites for most of the day until you finish work. You'll get some free time before it's time for bed and then distractions will be blocked again while you're sleeping."  FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
            <RadioButton x:Name="RadioButton2" GroupName="Occupation1"   Margin="10,10,0,10"  Content="xWhen I tell you to" FontSize="16"  FontWeight="Bold"  Checked="RadioButton2_Checked" Cursor="Hand" Padding="5,-5,0,0" />
            <TextBlock  Name="Description2" Margin="30,0,40,20" TextWrapping="Wrap" Text="xFocus Bear will only block distracting sites when you start a focus session"  FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
            <RadioButton x:Name="RadioButton3" GroupName="Occupation1"  Margin="10,10,0,10" Content="xOn a custom schedule" FontSize="16"  FontWeight="Bold" Checked="RadioButton3_Checked" Cursor="Hand" Padding="5,-5,0,0" />
            <TextBlock  Name="Description3" Visibility="Collapsed" Margin="30,0,40,0" TextWrapping="Wrap" Text="xComing soon"  FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left"/>
            
        </StackPanel>
        <Button Grid.Row="3"   x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnContinueText" Margin="8" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>


    </Grid>
</Page>
