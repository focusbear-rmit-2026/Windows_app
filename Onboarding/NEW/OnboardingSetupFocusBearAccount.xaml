<Page x:Class="Focus_Bear.Onboarding.NEW.OnboardingSetupFocusBearAccount"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:Models="clr-namespace:Focus_Bear.Models"
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.NEW"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Height="660" Width="750"
      Title="OnboardingNewWelcome" Background="#fff">


    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="140" />
            <RowDefinition Height="100" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*"   />
         
            
        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Margin="0,10,0,0" Name="Heading" TextWrapping="Wrap" Text="xSetting up a Focus Bear Account" Foreground="#000" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <Image Grid.Row="1" Height="140"  Width="140" Models:ImageBehavior.AnimatedSource="../../images/fbicon-256.png" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock  Grid.Row="2" Name="Description" Margin="40,18,40,0" TextWrapping="Wrap" Text="xHow about setting up an account so you can sync your block preferences across your devices?" Foreground="#000" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Border Grid.Row="3" BorderBrush="#f9e98e" BorderThickness="2" Width="550" Height="60" Margin="0,10,0,0">
            <Grid Background="#fefbec"    >
                <StackPanel Orientation="Horizontal">
                    <Image Source="../../images/bulb_small.png" Width="31" Height="33" Margin="10,0,10,0"></Image>
                    <TextBlock x:Name="AccountCost" VerticalAlignment="Center" TextWrapping="Wrap" Width="480" FontSize="13"> xSetting up an account doesn't cost anything - you still get a 31 day free trial- but it is necessary to enable the more advanced features.</TextBlock>
                </StackPanel>
            </Grid>
        </Border>
         
        <StackPanel  Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button  Grid.ColumnSpan="2" x:Name="btnNotRightNow"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="216" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="20" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnNotRightNow_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnNotRightNowText" Margin="8" Text="xNot right now"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button  Grid.ColumnSpan="2" x:Name="btnSignup"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   MinWidth="216" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="20" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnSignup_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnSignupText" Margin="8" Text="xSure - let me sign up"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
        

    </Grid>
</Page>
