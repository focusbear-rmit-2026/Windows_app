<Page x:Class="Focus_Bear.Onboarding.NEW.OnboardingNewPrivacy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.NEW"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Height="660" Width="750"
      Title="OnboardingNewWelcome" Background="#fff">


    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="135" />
            <RowDefinition Height="80" />
            <RowDefinition Height="220" />
            <RowDefinition Height="40"   />
            <RowDefinition Height="100" />
            
        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Margin="0,10,0,0" Name="Heading" TextWrapping="Wrap" Text="xPrivacy and Security" Foreground="#000" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>

        <Image Grid.Row="1" Height="120"  Width="120" Source="../../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
        <TextBlock  Grid.Row="2" Name="Welcome" Margin="40,18,40,0" TextWrapping="Wrap" Text="xWe take your privacy and security very seriously and will never share your data ever." Foreground="#000" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="3" Name="Descriptiopn1" Margin="40,20,40,0" TextWrapping="Wrap" Text="xx🙈 We do not log which websites or apps you use.\n\n🔄 We do sync your habit data to our server but this is only to support cross device distraction blocking.\n\n🔒 Your data is encrypted and we don't let anyone else see it." Foreground="#272727" FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Center"/>
        <TextBlock x:Name="ViewPrivacy"  Grid.Row="4"  TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
             <Hyperlink x:Name="btnViewPrivacy"  Foreground="#000" Click="btnViewPrivacy_Click"   TextDecorations="Underline" ><Run x:Name="btnViewPrivacyText" Text="xClick here to view Privacy Policy"/></Hyperlink>
        </TextBlock>

        <Button Grid.Row="5"   x:Name="btnLetsDoIt"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnLetsDoIt_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="buttonLetsDoItText" Margin="8" Text="xContinue"/>
                    </StackPanel>
                </Button.Content>
            </Button>

        
           </Grid>
</Page>
