<Page x:Class="Focus_Bear.Onboarding.NEW.OnboardingNewDistractionsShieldActivated"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.NEW"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Height="660" Width="750"
      Title="OnboardingNewWelcome" Background="#fff">


    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="400" />
            <RowDefinition Height="80" />
            <RowDefinition Height="100" />

        </Grid.RowDefinitions>
        <TextBlock  Grid.Row="0" Margin="0,10,0,0" Name="Heading" TextWrapping="Wrap" Text="xDistraction Shield activated!" Foreground="#000" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>

        <Image Grid.Row="1"  Margin="0,10,0,0"  Source="../../images/blocked.png" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center"   />
        <TextBlock  Grid.Row="2" Name="Welcome" Margin="40,0,40,0" TextWrapping="Wrap" Text="xTry it out - please attempt to access BLOCKED_URL through your web browser. It should block the site.." Foreground="#000" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>


        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="0,0,10,0"   x:Name="btnDidntBlocked"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="216" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnDidntBlocked_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnDidntBlockedText" Margin="8" Text="xIt didn't block it 😒"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Margin="10,0,0,0"   x:Name="btnItBlocked"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800" Width="216" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnItBlocked_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnItBlockedText" Margin="8" Text="xIt blocked it!"/>
                </StackPanel>
            </Button.Content>
        </Button>
        </StackPanel>

    </Grid>
</Page>
