<Page x:Class="Focus_Bear.Onboarding.OnboardingExplainDeepFocus"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
       xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Focus Bear">

    <Grid VerticalAlignment="Center">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Background>
            <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="50"   />
            <RowDefinition Height="50"   />
            <RowDefinition Height="*"  />
            <RowDefinition Height="105"  />
        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Row="0"  Margin="0,10,0,0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="50,7,50,0" TextWrapping="Wrap" Text="xGet into deep focus" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="2"  Name="Description" Margin="100,0,100,0" TextWrapping="Wrap" Text="xFocus Bear can help you get more deep work done by blocking distractions. You tell the app what you want to do and it uses AI to keep you on track."  FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <Viewbox Grid.Row="3"  Stretch="Uniform">
            <DockPanel  Margin="50,25,50,25" Width="853" Height="495">
                <wv2:WebView2 Name="webView"  />
            </DockPanel>
        </Viewbox>

        <Button Grid.Row="5"  x:Name="btnGotIt"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnGotIt_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnGotItTXT" Text="xGot It" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>