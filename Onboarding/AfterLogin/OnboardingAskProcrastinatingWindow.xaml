<Window x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingAskProcrastinatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
        mc:Ignorable="d"
        Title="Focus Bear" Height="660" Width="750" ResizeMode="NoResize" Topmost="True">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid   Name="GridHowDidYouHearAboutFocusBear"  Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"   />
                <RowDefinition Height="Auto" MinHeight="140" />
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" MinHeight="80" />
                <RowDefinition Height="100" />
                <RowDefinition Height="80" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="1" Height="140"  Width="140" Source="../../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="191,0,191,5"/>
            <TextBlock  Grid.Row="2" x:Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xTime to do something difficult"  FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="3" x:Name="Description" Margin="50,0,50,0" TextWrapping="Wrap" Text="xWhat's something you've been procrastinating on? Focus Bear will help you get it done right after this."  FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox  Grid.Row="4" Name="TxtIntention" Visibility="Visible"  TextWrapping="Wrap"  AcceptsReturn="True"  Height="90" Margin="50,0,50,0" VerticalAlignment="Top"  FontSize="15" TextChanged="TxtIntention_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button  x:Name="btnFirst"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="200"  HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnFirst_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnFirstTxt" Text="xFirst" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button  x:Name="btnSecond"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="200" HorizontalContentAlignment="Center"  VerticalAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnSecond_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnSecondTxt" Text="xSecond" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button  x:Name="btnThird"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" MinWidth="200"  HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnThird_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnThirdTxt" Text="xThird" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            <Button Grid.Row="6"  x:Name="btnLetsDoIt"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="300" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnLetsDoIt_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnLetsDoItTxt" Text="xLet's Do It" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            
        </Grid>
    </Grid>
</Window>
