<Page x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingConfirmForAI"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
      mc:Ignorable="d" 
      Height="660" Width="750"
      Title="OnboardingSetWorkType"  >

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="540" />
            <RowDefinition Height="60" />

        </Grid.RowDefinitions>
        
        <StackPanel  Grid.Row="0"  Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock    Name="Heading" Margin="40,0,40,0" TextWrapping="Wrap" Text="xDo you want to use AI to decide if websites should be allowed?"  FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <Image  Source="../../images/FocusTips/ai-block.png" Width="300"></Image>
            <TextBlock    Name="Description" Margin="40,10,40,0" TextWrapping="Wrap" Text="xWe'll use Open AI to decide if the site is valid based on your current focus mode, intention, the URL, the website title and the first 100 characters of the content. This is anonymous - no identifying details are shared." FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
         </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button  x:Name="btnNoThanks" AutomationProperties.AutomationId="btnNoThanks"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="40" Width="236" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,10,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNoThanks_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnNoThanksTXT" Text="xNo Thanks" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
            <Button   x:Name="btnOK" AutomationProperties.AutomationId="btnOK"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" Width="236" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="10,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnOK_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock x:Name="btnOKTXT" Text="xOK" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
