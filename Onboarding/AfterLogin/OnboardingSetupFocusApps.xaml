<Page x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingSetupFocusApps"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
      mc:Ignorable="d" 
      Height="660" Width="750"
      Title="OnboardingSetupFocusApps" Background="#fff">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="120" />
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto"  MinHeight="250" />
            <RowDefinition Height="Auto" MinHeight="100"  />
            <RowDefinition Height="100"   />

        </Grid.RowDefinitions>

        <TextBlock  Name="WhatAppsHeading" Margin="20,0,20,20" TextWrapping="Wrap" Text="xWhat apps do you normally use while you're doing WORK_TYPE?" Foreground="#272727" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="1"  Name="AddApps" Width="450" Margin="0,0,0,5"  TextWrapping="NoWrap" Text="xAdd the apps you plan to use:" Foreground="#000" FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Center" />
        <Border  Grid.Row="2" BorderThickness="1" BorderBrush="LightGray" Width="450">
            <Grid Background="#fff"    >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="27"/>
                </Grid.RowDefinitions>
                <ListView   Grid.Row="0"   x:Name="ListAllowedApps" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling"   ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" Foreground="{x:Null}"   >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AppName, StringFormat=\{0\}}" Foreground="#000"  FontSize="13" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="1" Background="LightGray" ></Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button   x:Name="btnAddApp"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800" Height="20" Width="20" HorizontalContentAlignment="Center" Padding="0" Margin="5,2,0,1" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnAddApp_Click"  >

                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Name="btnAddAppTXT" Height="20"  Width="20" Source="../../Images/plus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button   x:Name="btnDeleteApp"   Style="{StaticResource BtnStylePlusMinus}" IsEnabled="True" Foreground="#e88800"  Height="20" Width="20" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="5,2,0,1" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnDeleteApp_Click" >

                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <Image Name="btnDeleteAppTXT" Height="20"  Width="20" Source="../../Images/minus.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Visible"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"  Name="DontWorry" Margin="20,20,20,0"  TextWrapping="Wrap" Text="xDon't worry you can still use other apps if you need to but these are the apps that are most likely to be productive for you while you're doing WORK_TYPE. You can change these settings later on." Foreground="#000" FontSize="15" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Row="4"  x:Name="btnContinue" Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800"  Height="40" Width="300" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,50,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue"/>
                </StackPanel>
            </Button.Content>
        </Button>

    </Grid>
</Page>
