<Window x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
        mc:Ignorable="d"
        Title="Focus Bear" Height="660" Width="750" ResizeMode="NoResize" Topmost="True">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="20" />
            <RowDefinition Height="Auto" MinHeight="60" />

        </Grid.RowDefinitions>

        <Frame Grid.Row="0" x:Name="FrameNotes" Margin="0" NavigationUIVisibility="Hidden"    Foreground="{x:Null}" Visibility="Collapsed" />
        <Grid Grid.Row="0" Name="GridSignupSuccess"  Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"   />
                <RowDefinition Height="Auto" MinHeight="30" />
                <RowDefinition Height="Auto" MinHeight="80" />
                <RowDefinition Height="Auto" MinHeight="50" />
                <RowDefinition Height="Auto" MinHeight="40" />

            </Grid.RowDefinitions>

            <Image Grid.Row="1" Height="140"  Width="140" Source="../../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="191,0,191,5"/>
            <TextBlock  Grid.Row="2" x:Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xSignup Successful" Foreground="#000" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="3" Name="Description" Margin="40,0,40,0" TextWrapping="Wrap" Text="xGreat you're all signed up. I'll just give you a few tips before you start using it." Foreground="#000" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="4" Name="Description1" Margin="40,30,40,0" TextWrapping="Wrap" Text="xxClick next to explore the tips to use Focus Bear." Foreground="#272727" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            
        </Grid>

        <Grid Grid.Row="0" Name="GridSignupImportantNotes"  Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"   />
                <RowDefinition Height="290"   />
                <RowDefinition Height="Auto" MinHeight="40" />
                <RowDefinition Height="Auto" MinHeight="100" />
                <RowDefinition Height="Auto" MinHeight="30" />

            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0" x:Name="HeadingImpNote" Margin="0,0,0,0" TextWrapping="Wrap" Text="xImportant Notes" Foreground="#000" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <Image Grid.Row="1" Height="auto" x:Name="NoteImage" Source="../../Images/FBicon-64.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <TextBlock  Grid.Row="2" x:Name="NoteTitle" Margin="0,0,0,0" TextWrapping="Wrap" Text="xBuilding Better Habits" Foreground="#000" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="3" Name="NoteDescription" Margin="40,0,40,0" TextWrapping="Wrap" Text="xxFocus Bear will help you develop stronger habits in the morning and evening by blocking distractions. But don't worry - if you need to access your computer in a hurry, just click the \Please spare me\ button in the top right.." Foreground="#272727" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="4" x:Name="PrivacyPolicy" Margin="0,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="22" Cursor="Hand" Visibility="Collapsed">
             <Hyperlink x:Name="btnPrivacyPolicy"  Foreground="#000" Click="btnPrivacyPolicy_Click" TextDecorations="Underline" ><Run x:Name="btnPrivacyPolicyTXT" Text="xClick here to view Privacy Policy" /></Hyperlink>
            </TextBlock>
        </Grid>

        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <Button x:Name="Dot1" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="True" />
            <Button x:Name="Dot2" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
            <Button x:Name="Dot3" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
            <Button x:Name="Dot4" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
        </StackPanel>
        <Button Grid.Row="2" x:Name="btnBack"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" Foreground="#e88800"  Height="30" Width="133" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnBack_Click" Visibility="Collapsed">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnBackTXT" Text="xBack"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <Button Grid.Row="2" x:Name="btnNext"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True" Foreground="#e88800"  Height="30" Width="133" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnNext_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnNextTXT" Text="xNext"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Window>
