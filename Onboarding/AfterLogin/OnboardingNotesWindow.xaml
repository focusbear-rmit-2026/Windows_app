<Window x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
        mc:Ignorable="d"
        Title="Focus Bear" Height="660" Width="750" ResizeMode="NoResize" Topmost="True">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid   Name="GridHowDidYouHearAboutFocusBear"  Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"   />
                <RowDefinition Height="Auto" MinHeight="140" />
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" MinHeight="150" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="1" Height="140"  Width="140" Source="../../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="191,0,191,5"/>
            <TextBlock  Grid.Row="2" x:Name="HeadingHear" Margin="0,0,0,0" TextWrapping="Wrap" Text="xHow did you hear about Focus Bear?"  FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <StackPanel  Grid.Row="3"  Orientation="Vertical"  HorizontalAlignment="Center">

                <TextBox    Height="130" x:Name="TxtSomewhereElse" AutomationProperties.AutomationId="txtBoxSomewhereElse"   Margin="0,30" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="Black" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" Width="450" Visibility="Visible" TextChanged="TxtSomewhereElse_TextChanged">
                    <TextBox.Effect>
                        <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                    </TextBox.Effect>
                    <TextBox.FocusVisualStyle>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.FocusVisualStyle>
                </TextBox>
            </StackPanel>

            <Button Grid.Row="5"  x:Name="btnContinue" AutomationProperties.AutomationId="btnContinue"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="300" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnContinueTxt" Text="xContinue" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid  Name="GridWantFeedback"  Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"   />
                <RowDefinition Height="Auto" MinHeight="140" />
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" MinHeight="150" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="1" Height="150"  Width="218" Source="../../Images/team.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="191,0,191,5"/>
            <TextBlock  Grid.Row="2" x:Name="HeadingWantFeedback" Margin="50,0,50,0" TextWrapping="Wrap" Text="xWe want your feedback"  FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="3" x:Name="DescriptionWantFeedback" Margin="50,0,50,0" TextWrapping="Wrap" Text="xWe're a small independent team, not a faceless mega-corporation. Focus Bear is still a new app and we really want your feedback. If you have suggestions, please email support@focusbear.io." FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            <Button Grid.Row="5"  x:Name="btnContinueFeedback" AutomationProperties.AutomationId="btnContinueFeedback"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="300" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinueFeedback_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnContinueFeedbackTxt" Text="xContinue" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
        
        <Grid  Name="GridVideoDesc"  Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" x:Name="AccountReady" Margin="0,0,0,0" TextWrapping="Wrap" Text="xYour account's ready to go!"  FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Center"/>
            <TextBlock  Grid.Row="1" x:Name="Desc" Margin="0,10,0,0" TextWrapping="Wrap" Text="xHere's a short video that explains how to use Focus Bear." FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Center"/>
            <Image Grid.Row="2" Source="../../images/img_videoScreenshot.png"></Image>
            <Button Grid.Row="3"  x:Name="btnPlayVideo" AutomationProperties.AutomationId="btnPlayVideo"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" Width="300" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnPlayVideo_Click" >
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnPlayVideoTxt" Text="xPlay the Video" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <TextBlock x:Name="NoThanksTxt" AutomationProperties.AutomationId="txtNoThanks" Grid.Row="4"  TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="17" Height="30" Cursor="Hand">
             <Hyperlink x:Name="btnNoThanks"  Click="btnNoThanks_Click"   TextDecorations="Underline" ><Run x:Name="btnNoThanksText" Text="xNo Thanks"/></Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
