<Page x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingSetupFocusTips"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
      mc:Ignorable="d" 
      Height="660" Width="750"
      Title="OnboardingSetupFocusTips" Background="#fff">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>

       

            <Grid  Name="GridFocusTips"  Visibility="Visible">
            
       <Grid.RowDefinitions>
            <RowDefinition Height="535" />
            <RowDefinition Height="Auto" MinHeight="20" />
            <RowDefinition Height="Auto" MinHeight="60" />

        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"   />
                <RowDefinition Height="365"   />
                <RowDefinition Height="Auto" MinHeight="40" />
                <RowDefinition Height="Auto" MinHeight="80" />


            </Grid.RowDefinitions>
            <TextBlock  Grid.Row="0" x:Name="HeadingAllSetup" Margin="0,0,0,0" TextWrapping="Wrap" Text="xAll Setup" Foreground="#000" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
            <Image Grid.Row="1" Margin="40,0,40,0" Height="auto" x:Name="TipImage" Source="../../Images/focustips/focustip_1.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <TextBlock  Grid.Row="2" x:Name="TipTitle" Margin="0,0,0,0" TextWrapping="Wrap" Text="xTip 1:" Foreground="#000" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
                <TextBlock  Grid.Row="3" Name="TipDescription" Margin="40,0,40,0" TextWrapping="Wrap" Text="xxYou can try it out now by clicking the Play icon next to your new focus mode in the list that appears on clicking the Focus Bear menu icon in the System Tray." Foreground="#272727" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
            
        </Grid>


        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <Button x:Name="Dot0" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="True" />
            <Button x:Name="Dot1" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
            <Button x:Name="Dot2" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
            <Button x:Name="Dot3" Width="13" Height="13"  Margin="0,0,5,0" Style="{StaticResource BtnStyleEllipseSmall}" IsEnabled="False" />
        </StackPanel>
        <Button Grid.Row="2" x:Name="btnBack"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"    Height="30" Width="133" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnBack_Click" Visibility="Collapsed">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnBackTXT" Text="xBack"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <Button Grid.Row="2" x:Name="btnNext"   Style="{StaticResource BtnStyleLightOrangeBorderedSmall}" IsEnabled="True"   Height="30" Width="133" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,20,0" FontSize="15" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnNext_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnNextTXT" Text="xNext"/>
                </StackPanel>
            </Button.Content>
        </Button>
        </Grid>
    </Grid>
</Page>
