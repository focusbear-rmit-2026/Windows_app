<Page x:Class="Focus_Bear.Onboarding.AfterLogin.OnboardingSetWorkType"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding.AfterLogin"
      mc:Ignorable="d" 
      Height="660" Width="750"
      Title="OnboardingSetWorkType" Loaded="Page_Loaded">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="300" />
            <RowDefinition Height="Auto" MinHeight="200"/>
            <RowDefinition Height="100"   />

        </Grid.RowDefinitions>
        
        <StackPanel  Grid.Row="0"  Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock    Name="TypeOfWork" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWhat type of work do you mainly do?."  FontSize="24" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock    Name="Customize" Margin="0,15,0,0" TextWrapping="Wrap" Text="xWe'll customise your focus mode depending on type of work you do."  FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <ComboBox Name="ComboBoxWorkType"  Grid.Row="2" Width="200" MinHeight="30" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,30,0,0"   FontSize="15"   SelectionChanged="ComboBoxWorkType_SelectionChanged">
            </ComboBox>
            <TextBox    MinHeight="30" x:Name="TxtSomethingElse" MaxLength="250" Margin="0,30,0,0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,2,5,5"  BorderThickness="1" FontSize="15" TextAlignment="Left" MaxLines="1" Width="341" Visibility="Collapsed" TextChanged="TxtSomethingElse_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
                </TextBox.Effect>
                <TextBox.FocusVisualStyle>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.FocusVisualStyle>
            </TextBox>
            <Label Name="MaxChars" HorizontalAlignment="Center" Visibility="Collapsed">xMax 25 Characters</Label>
        </StackPanel>
        <TextBlock Grid.Row="1"   Name="SetupFocusMode" Margin="20,0,20,0" TextWrapping="Wrap" Text="xGot it. Let's set up a Focus Mode to help you be super productive while you're doing WORK_TYPE." FontSize="18" FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Row="2"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" Width="300" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="0,30,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
