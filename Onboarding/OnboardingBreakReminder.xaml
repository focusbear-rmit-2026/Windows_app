<Page x:Class="Focus_Bear.Onboarding.OnboardingBreakReminder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:localView="clr-namespace:Focus_Bear.Utils"
 
      mc:Ignorable="d" 
     d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingAskWorkTime">
 
        <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
         
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="105" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="*"  />
            <RowDefinition Height="180" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xBreak reminders"  FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel  Grid.Row="2"  Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"  Width="650"   Margin="0,0,0,0">

            <TextBlock  Name="HowFrequently" Margin="-20,0,0,0"     TextWrapping="Wrap" Text="xHow frequently do you want to  take breaks?" FontSize="22" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />

            <Grid  Height="33" Margin="0,20,0,0" Width="200" VerticalAlignment="Top">
                <TextBox   TabIndex="0" x:Name="MinutesValue" AutomationProperties.AutomationId="txtBoxMinutes" Width="200" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="18" TextAlignment="Left" MaxLines="1" Height="30" TextChanged="MinutesValue_TextChanged" Margin="0,1,0,0" VerticalAlignment="Top">

                </TextBox>
                <Button x:Name="cmdUp" AutomationProperties.AutomationId="btnCmdUp" x:FieldModifier="private" FontSize="10" Padding="0,-2,0,0" Content="▲" Width="13"  Click="cmdUp_Click" Margin="0,-15,0,0" HorizontalAlignment="Right" Height="13" />
                <Button x:Name="cmdDown" AutomationProperties.AutomationId="btnCmdDown" x:FieldModifier="private" FontSize="10" Padding="0,0,0,0" Content="▼" Width="13" Click="cmdDown_Click" Margin="0,0,0,3" HorizontalAlignment="Right" Height="15" VerticalAlignment="Bottom" />
            </Grid>
 
            <TextBlock  Name="Minutes" Margin="130,0,0,0"    TextWrapping="Wrap" Text="xminutes"  FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Center" />
            <StackPanel  Orientation="Horizontal">
                <TextBlock Name="Suggest" Margin="0,0,0,0" TextWrapping="Wrap" Text="x(Optometrists recommend a 20 second break every 20 minutes)" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
                <Button x:Name="btnInfo" AutomationProperties.AutomationId="btnInfo" Style="{StaticResource BtnStyleInfo}" Click="btnInfo_Click"   MinWidth="35" Height="35" Cursor="Hand"  >
                    <StackPanel Orientation="Vertical">
                        <Image Source="{DynamicResource InfoImage}" Margin="0,0,0,0" Height="24" Width="24" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Name="SuggestDesc" Visibility="Collapsed" Margin="0,50,0,0" TextWrapping="Wrap" Text="xTo avoid screen headaches and neck strain, Focus Bear will encourage you to take breaks at regular intervals. We give you a 30 second warning so you can postpone the break if it's a bad time. We also detect if you're in a meeting and don't show breaks as that might lead to awkward screensharing moments otherwise!"  FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="3"  x:Name="btnContinue" AutomationProperties.AutomationId="btnContinue"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" Width="400" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,80" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
 
</Page>
