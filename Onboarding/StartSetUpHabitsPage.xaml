<Page x:Class="Focus_Bear.Onboarding.StartSetUpHabitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="StartSetUpHabitsPage">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*" />
            <!-- 80% container -->
            <RowDefinition Height="2*" />
            <!-- 20% buttons -->
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- Content fills remaining space -->
                <RowDefinition Height="5*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Image MaxHeight="260" MaxWidth="260" Source="../Images/new/bear_startSetHabits.png" Stretch="Uniform" HorizontalAlignment="Center"  />
                <!-- SPEECH BUBBLE -->
                <controls:SpeechBubble x:Name="Bubble1"
                            Text="xWant me to bring aboard some new habits?"
                            Direction="Right"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"> 

                    <controls:SpeechBubble.RenderTransform>
                        <!-- Move LEFT of image -->
                        <TranslateTransform X="-235" Y="-30"/>
                    </controls:SpeechBubble.RenderTransform>

                </controls:SpeechBubble>
            
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top" Margin="0,30,0,0">
                <TextBlock Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xNeed some fresh ideas for habits?" FontSize="35" FontWeight="SemiBold"  TextAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Name="Description" Margin="0,10,0,0" TextWrapping="Wrap" Text="xIf you have your own habit list, you can import them too." FontSize="15" FontWeight="Normal" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>

        </Grid>
        <Grid Grid.Row="1">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnAlreadyHaveHabits" AutomationProperties.AutomationId="btnAlreadyHaveHabits"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,7,20,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnAlreadyHaveHabits_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnAlreadyHaveHabitsText" Margin="8" Text="xNay - I already have some habits" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="btnGiveMeSomeIdeas" AutomationProperties.AutomationId="btnGiveMeSomeIdeas"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnGiveMeSomeIdeas_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnGiveMeSomeIdeasText" Margin="8" Text="xSign me up, Scotty!" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

