<Page x:Class="Focus_Bear.Onboarding.OnboardingAskWorkTime"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:localView="clr-namespace:Focus_Bear.Utils"
 
      mc:Ignorable="d" 
     d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingAskWorkTime">
    <Grid>
        <Grid>
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="105"   />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="*"  />
            <RowDefinition Height="90" />

        </Grid.RowDefinitions>
       
            
        <Image Grid.Row="0" Height="99"  Width="99" Margin="0,0,0,0" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xWhen do you want to start and finish work?"  FontSize="25" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Viewbox Grid.Row="2" Stretch="Uniform" Margin="50,20,50,0"  >
            
            <StackPanel   Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center"  Width="650"   Margin="0,0,0,0">
                    <StackPanel   Orientation="Horizontal"   Margin="20,0,0,0">

                        <TextBlock  Name="WakeupTime" Margin="-20,0,0,0"     TextWrapping="Wrap" Text="xWhat time do you wake up?" FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left" />
                        <localView:HourControl x:Name="WakeupTimePicker" AutomationProperties.AutomationId="tpWakeTime" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Cursor="Hand"  Margin="15,0,0,0"  ValueChanged="WakeupTimePicker_ValueChanged"/>
                        <Button x:Name="btnNextWakeupTime" AutomationProperties.AutomationId="btnNextWakeUpTime"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="25" Width="110" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNextWakeupTime_Click">
                            <Button.Content>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock x:Name="btnNextWakeupTimeTXT" Text="xNext" Foreground="Black"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="StartupTimeSection" IsEnabled="False" IsHitTestVisible="False" Opacity="0" Orientation="Horizontal"   Margin="20,30,0,0">
                 
                    <TextBlock Name="StartupTime" Margin="-20,0,0,0"     TextWrapping="Wrap" Text="xWhat time do you start work?" FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left" />
                        <localView:HourControl x:Name="StartupTimePicker" AutomationProperties.AutomationId="tpStartupTime" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Cursor="Hand"  Margin="15,0,0,0"  ValueChanged="StartupTimePicker_ValueChanged"/>
                        <Button x:Name="btnNextStartWork" AutomationProperties.AutomationId="btnNextStartWork"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="25" Width="110" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNextStartWork_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnNextStartWorkTXT" Text="xNext" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
            </StackPanel>

                    <StackPanel x:Name="FinishWorkSection" IsEnabled="False" IsHitTestVisible="False" Opacity="0"  Orientation="Horizontal"  Margin="20,30,0,0" >
                    <TextBlock  Name="ShutdownTime" Margin="-20,0,0,0"    TextWrapping="Wrap" Text="xWhat time do you finish work?" FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left" />
                        <localView:HourControl x:Name="ShutdownTimePicker" AutomationProperties.AutomationId="tpShutdownTime" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Cursor="Hand"  Margin="15,0,0,0" ValueChanged="ShutdownTimePicker_ValueChanged" />
                        <Button x:Name="btnNextFinishWork" AutomationProperties.AutomationId="btnNextFinishWork"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="25" Width="110" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNextFinishWork_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnNextFinishWorkTXT" Text="xNext" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                </StackPanel>
                    <StackPanel x:Name="SleepTimeSection" IsEnabled="False" IsHitTestVisible="False" Opacity="0" Orientation="Horizontal"  Margin="20,30,0,0">
                        <TextBlock  Name="SleepTime" Margin="-20,0,0,0"    TextWrapping="Wrap" Text="xWhat time do you want to go to sleep?"  FontSize="20" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Left" />
                        <localView:HourControl x:Name="SleepTimePicker" AutomationProperties.AutomationId="tpSleepTime" HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Cursor="Hand"  Margin="15,0,0,0" ValueChanged="SleepTimePicker_ValueChanged" />
                        <Button x:Name="btnNextSleep" AutomationProperties.AutomationId="btnNextSleep"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="25" Width="110" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="20,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNextSleep_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                                <TextBlock x:Name="btnNextSleepTXT" Text="xNext" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                    </Button>
                </StackPanel>
                <TextBlock Name="Schedule" Opacity="0"   Margin="0,50,0,0" TextWrapping="Wrap" Text="xYour schedule looks like:\n\n🐥 MORNING_ROUTINE_START_TIME - MORNING_ROUTINE_END_TIME - Morning routine\n\n💼 MORNING_ROUTINE_END_TIME - START_WORK_TIME - Prepare to start work (buffer time)\n\n💪 START_WORK_TIME - END_WORK_TIME - Work\n\n🥱 END_WORK_TIME - EVENING_ROUTINE_END_TIME - Do evening routine.\n\n😴 EVENING_ROUTINE_END_TIME - Finish evening routine - computer locked (you can unlock it if you need it)" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
        </StackPanel>
        </Viewbox>
            <Button Grid.Row="3"  x:Name="btnContinue" AutomationProperties.AutomationId="btnContinue" Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,20,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>

        
    </Grid>

        <Grid>
            <Grid x:Name="GridPopup" Width="250" Margin="100,100,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Background="LightGoldenrodYellow">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="70" />

                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0"   Height="auto" Width="250"   Fill="LightGoldenrodYellow" HorizontalAlignment="Right" Stroke="Orange" RadiusX="7" RadiusY="7"   />
                <Image Name="Logo" Grid.Row="0"   Width="40"  Margin="20,20,0,0"  Source="../Images/fbicon-64.png"   VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <TextBlock Name="HeadingSchedule" Grid.Row="0"   Margin="70,30,10,0"    VerticalAlignment="Top"  Foreground="Black" FontSize="15" FontWeight="Semibold" >xSet your schedule</TextBlock>
                <TextBlock Name="Title" Grid.Row="0" TextWrapping="Wrap"  Margin="20,70,20,0"     VerticalAlignment="Top"  Foreground="Black" FontSize="15" FontWeight="Semibold" >xWhat time do you start work?</TextBlock>
                <TextBlock Name="Description" Grid.Row="0" TextWrapping="Wrap"  Margin="20,110,20,20"  VerticalAlignment="Top"  Foreground="Black" FontSize="15" FontFamily="Segoe UI" >xChoose the earliest possible time you would want to start work. You’ll do your morning routine before starting work. You can start later than this time if you need to.</TextBlock>

            </Grid >

            <Path x:Name="Arrow" StrokeThickness="1" Stroke="Orange" Fill="LightGoldenrodYellow" VerticalAlignment="Top" 
              HorizontalAlignment="Left" 
              Margin="329,185,0,0">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="20,0">
                            <PolyLineSegment Points="40,20 20,40"/>
                            <LineSegment Point="20,0" IsStroked="False"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Grid>
    </Grid>
</Page>
