<Page x:Class="Focus_Bear.Onboarding.BlockedUrlsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="BlockedUrlsPage">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top progress take only required height -->
                    <RowDefinition Height="1.5*" />

                    <!-- Content fills remaining space -->
                    <RowDefinition Height="6.5*" />

                    <!-- Buttons take only required 15% height -->
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
                                    Step1Percentage="60" 
                                    Step2Percentage="0" Step1ImageSource="../images/new/eye_orange.png" Step1LabelColor="#EB912E" />
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18*" />
                        <RowDefinition Height="82*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xChoose websites to block" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20*" />
                            <RowDefinition Height="70*" />
                            <RowDefinition Height="10*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" MaxWidth="810" BorderThickness="1" Background="#FFFEF7" BorderBrush="#EB912E" CornerRadius="10">
                            <Grid VerticalAlignment="Center" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- Takes all remaining space -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Button takes its own width -->
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="34"  Visibility="Visible" x:Name="TxtURL" Style="{StaticResource WatermarkTextBoxStyle}"
                                    Tag="✏️ Enter URL or keyword to block" AutomationProperties.AutomationId="txtBoxURL" MaxLength="200"  TextWrapping="Wrap" Background="#fff" BorderBrush="#EB912E" Padding="5,5,5,5" VerticalAlignment="Top"  BorderThickness="1" FontSize="16" TextAlignment="Left" MaxLines="1" HorizontalContentAlignment="Left"  HorizontalAlignment="Stretch" Margin="10,0,0,0" >
                                    <TextBox.Effect>
                                        <DropShadowEffect ShadowDepth="3"
                                                        Direction="330"
                                                        Color="Gray"
                                                        Opacity="0.1"
                                                        BlurRadius="6"
    />
                                    </TextBox.Effect>
                                    <TextBox.FocusVisualStyle>
                                        <Style>
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.FocusVisualStyle>
                                </TextBox>
                                <Button Grid.Column="1" x:Name="btnAdd" AutomationProperties.AutomationId="btnAdd"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="33" Height="33" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" Margin="10,0,10,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnAdd_Click">
                                    <Button.Content>
                                        <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock  Text="+" VerticalAlignment="Center" Margin="0,0,0,5" FontSize="30" Foreground="#EB912E"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" MaxWidth="810" Margin="0,10,0,0" BorderThickness="1" Background="#FFFEF7" BorderBrush="#EB912E" CornerRadius="10">
                            <Grid Background="Transparent">
                                         
                                <Border MaxWidth="810" Margin="10,10,10,10" BorderThickness="1" Background="#FFFEF7" BorderBrush="#EB912E" CornerRadius="20">
                                    <ListView x:Name="ListBLockedURLs" AutomationProperties.AutomationId="lvBlockedURLs" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling" BorderBrush="Transparent"  ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}"   Margin="10,10" VerticalAlignment="Top">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox  IsChecked="{Binding Path=IsItemChecked}" AutomationProperties.AutomationId="chk0"/>
                                                        <TextBlock Grid.Column="0" Text="{Binding sURL, StringFormat=\{0\}}" FontSize="15" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" Padding="0,-2,0,0" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Name="CountBlockedSites" Margin="0,10,0,0"  TextWrapping="Wrap"  Text="x3 Sites will always be blocked"   FontSize="15" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Left"   />
                    </Grid>

                </Grid>

                <StackPanel  Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    
                    <Button x:Name="btnProceed" AutomationProperties.AutomationId="btnProceed"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="0,5,0,20" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnProceed_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Name="btnProceedText" Margin="8" Text="xProceed" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                   
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Height="270" x:Name="SideImage"
         Background="Transparent"
         HorizontalAlignment="Right"
         VerticalAlignment="Bottom"
         Panel.ZIndex="99" Margin="0,10,-57,15">
            <!-- ensures it's on top -->
            <Image Source="../Images/new/bear_setDistraction.png" Stretch="Uniform"/>
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
             Text="xDon’t worry, we don’t track which websites you’re using"
             Direction="Right" 
             HorizontalAlignment="Center"
             VerticalAlignment="Center" FontSize="13">

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-170" Y="0"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>
    </Grid>
    
</Page>

