<Page x:Class="Focus_Bear.Onboarding.OnboardingConfirmBreaks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
       d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Focus Bear">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Background>
        <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
    </Grid.Background>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="105" />
        <RowDefinition Height="40" />
        <RowDefinition MinHeight="150" />
        <RowDefinition MinHeight="310"  />
        <RowDefinition Height="110" />

    </Grid.RowDefinitions>

    <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,10,0,0" TextWrapping="Wrap" Text="xFocus Bear" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
    
        <StackPanel  Grid.Row="2"  Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center"  Margin="100,30,100,0">
                <TextBlock  Name="RememberBreaks" Margin="0,10,0,10" TextWrapping="Wrap" Text="xFocus Bear can help you remember to take breaks regularly throughout the day. This will help avoid screen headaches and actually improve your productivity. You can even do microworkouts during the breaks 💪" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock  Name="Warning" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWarning: you will get popups asking you to take breaks. Some people find them annoying. You can skip/postpone the breaks but your eyes and body will really appreciate it if you do take breaks!" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <Image x:Name="InfoWarn"   Source="../images/info.png" Width="18"  Margin="10,0,0,3" VerticalAlignment="Bottom" HorizontalAlignment="Left"  ></Image>
            </StackPanel>
        </StackPanel>
   
    <Viewbox Grid.Row="3" Stretch="Uniform" Margin="0,10,0,0"  >
        <StackPanel   Name="HabitsCare"    Orientation="Vertical" HorizontalAlignment="Center"  Margin="0,0,0,10" >
                <TextBlock  Name="CareAboutBreaks" Margin="0,10,0,0" TextWrapping="Wrap" Text="xHow much do you care about taking breaks?"  FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock  Name="SelectOne" Margin="0,5,0,10" TextWrapping="Wrap" Text="xSelect one that apply"  FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />

                <RadioButton x:Name="DoNotCare"   Margin="0,20,0,10" Content="xMeh - don't really care" FontSize="18" Style="{StaticResource HabitsCareRadioButtonStyle}"   Checked="DoNotCare_Checked" Cursor="Hand"  />
                <RadioButton x:Name="NotCommitted"  Margin="0,10,0,10"  Content="xI probably should take breaks but am not that committed" FontSize="18" Style="{StaticResource HabitsCareRadioButtonStyle}"  Checked="NotCommitted_Checked" Cursor="Hand"  />
                <RadioButton x:Name="MostlyCommitted"  Margin="0,10,0,10"  Content="xMostly committed - I'll take breaks most of the time" FontSize="18" Style="{StaticResource HabitsCareRadioButtonStyle}"  Checked="MostlyCommitted_Checked" Cursor="Hand"  />
                <RadioButton x:Name="Committed"  Margin="0,10,0,10"  Content="xSuper committed - i vow to take breaks regularly" FontSize="18" Style="{StaticResource HabitsCareRadioButtonStyle}"  Checked="Committed_Checked" Cursor="Hand"  />
            <TextBlock  Name="CareDesc" Margin="0,10,0,0" TextWrapping="Wrap" Text="xNo worries. You can always enable breaks later from Preferences > Breaks > Enable Breaks" FontSize="18"   FontWeight="Normal" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Viewbox>
    <Button Grid.Row="4"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
        <Button.Content>
            <StackPanel  Orientation="Horizontal">
                <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
            </StackPanel>
        </Button.Content>
    </Button>
    </Grid>
</Page>
