<Page x:Class="Focus_Bear.Onboarding.BlockedAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      xmlns:utils="clr-namespace:Focus_Bear.Utils" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="BlockedAppsPage">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <utils:SmartKeywordIcon x:Key="SmartConverter"/>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top progress take only required height -->
                    <RowDefinition Height="1.5*" />

                    <!-- Content fills remaining space -->
                    <RowDefinition Height="6.5*" />

                    <!-- Buttons take only required 15% height -->
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
                                    Step1Percentage="80" 
                                    Step2Percentage="0" Step1ImageSource="../images/new/eye_orange.png" Step1LabelColor="#EB912E" />
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18*" />
                        <RowDefinition Height="82*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xChoose apps to block" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border  MaxWidth="810" Margin="0,10,0,0" BorderThickness="1" Background="#FFF7EB" BorderBrush="#EB912E" CornerRadius="10">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <ListView Grid.Row="0" x:Name="ListBlockedApps" AutomationProperties.AutomationId="lvBlockedApps" SelectionMode="Single"  VirtualizingPanel.IsVirtualizing="True"  VirtualizingPanel.VirtualizationMode="Recycling" BorderBrush="Transparent"  ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}"   Margin="10,10" VerticalAlignment="Top">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="ItemHeader"  Background="Transparent"  Margin="0,0,0,0" IsHitTestVisible="True" Cursor="Hand" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" 
                                                       Source="{Binding DisplayIcon, Converter={StaticResource SmartConverter}}" 
                                                       Width="18" 
                                                       Height="18" 
                                                       Margin="5,0,5,0"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding AppName, StringFormat=\{0\}}" FontSize="15" Cursor="Hand"  VerticalAlignment="Center" Margin="5,0,0,0" Padding="0,-2,0,0" HorizontalAlignment="Left"/>
                                                
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid Grid.Row="1" Background="#EB912E"></Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,12,0,0">
                                    <Button x:Name="btnAdd" AutomationProperties.AutomationId="btnAdd"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Height="33" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" Margin="10,0,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnAdd_Click">
                                        <Button.Content>
                                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock  Text="+" VerticalAlignment="Center" Margin="8,1,0,5" FontSize="25" Foreground="Black"/>
                                                <TextBlock x:Name="btnAddText" Text="xAdd" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="13" Foreground="Black"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>

                                    <Button x:Name="btnRemove" AutomationProperties.AutomationId="btnRemove"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Height="33" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalAlignment="Top" Padding="0" Margin="10,0,10,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnRemove_Click">
                                        <Button.Content>
                                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock  Text="-" VerticalAlignment="Center" Margin="8,0,0,5" FontSize="30" Foreground="Black"/>
                                                <TextBlock x:Name="btnRemoveText" Text="xRemove" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="14"  Foreground="Black" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>

                <StackPanel  Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Button x:Name="btnProceed" AutomationProperties.AutomationId="btnProceed"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnProceed_Click">
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Name="btnProceedText" Margin="8" Text="xProceed" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock  x:Name="Skip" AutomationProperties.AutomationId="txtSkip"  TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextDecorations="{x:Null}"   FontSize="15" Height="30" Cursor="Hand">
                        <Hyperlink x:Name="btnSkip" AutomationProperties.AutomationId="btnSkip"  Click="btnSkip_Click"  TextDecorations="Underline" ><Run x:Name="btnSkipText" Text="xSkip"/></Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Grid>
        </Grid>
        <Grid Height="270" x:Name="SideImage"
         Background="Transparent"
         HorizontalAlignment="Right"
         VerticalAlignment="Bottom"
         Panel.ZIndex="99" Margin="0,10,-57,15">
            <!-- ensures it's on top -->
            <Image Source="../Images/new/bear_setDistraction.png" Stretch="Uniform"/>
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
             Text="xDon’t worry, we don’t track which apps you’re using"
             Direction="Right" 
             HorizontalAlignment="Center"
             VerticalAlignment="Center" FontSize="13">

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-170" Y="0"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>
    </Grid>
    
</Page>

