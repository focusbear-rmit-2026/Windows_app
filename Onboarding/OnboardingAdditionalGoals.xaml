<Page x:Class="Focus_Bear.Onboarding.OnboardingAdditionalGoals"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      mc:Ignorable="d" 
     d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Focus Bear">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="105" />
            <RowDefinition Height="40" />
            <RowDefinition MinHeight="430"  />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="99"  Width="99" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,10,0,0" TextWrapping="Wrap" Text="xWelcome to Focus Bear" Foreground="#e88800" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <Viewbox Grid.Row="2" Stretch="Uniform" Margin="0,10,0,0" Height="400" >
            <StackPanel  Grid.Row="2"  Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center"  Margin="0,0,0,0">
                <TextBlock  Name="SetGoals" Margin="0,0,0,10" TextWrapping="Wrap" Text="xSet your Goals and Preferences " FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock  Name="GladDesc" Margin="0,10,0,0" TextWrapping="Wrap" Text="xGlad you're as passionate about building routines as we are!"  FontSize="21" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock  Name="WhatGoals" Margin="0,10,0,30" TextWrapping="Wrap" Text="x Are there other goals you want to achieve with Focus Bear?"  FontSize="23" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />

                <TextBlock  Name="SelectAll" Margin="0,0,0,10"  Width="300" TextWrapping="Wrap" Text="xSelect all that apply"  FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center" />

                <CheckBox x:Name="CheckMeditateConsistently" AutomationProperties.AutomationId="chkMeditateConsistently" Width="300" FontSize="18"  Cursor="Hand" Padding="10,-6,0,0" Margin="10">xMeditate consistently</CheckBox>
                <CheckBox x:Name="CheckSleepBetter" AutomationProperties.AutomationId="chkSleepBetter" Width="300" FontSize="18"  Cursor="Hand" Padding="10,-6,0,0" Margin="10">xSleep better</CheckBox>
                <CheckBox x:Name="CheckExerciseMore" AutomationProperties.AutomationId="chkExerciseMore" Width="300"  FontSize="18" Cursor="Hand" Padding="10,-6,0,0" Margin="10">xExercise more</CheckBox>
                <CheckBox x:Name="CheckImproveWorkLifeBalance" AutomationProperties.AutomationId="chkImproveWorkLifeBalance" Width="300" FontSize="18" Cursor="Hand" Padding="10,-6,0,0" Margin="0,10,0,15">xImprove work life balance</CheckBox>

                <TextBlock  Name="AnythingElse" Margin="0" Height="50" Width="550" TextWrapping="Wrap" Text="xAnything else you hope Focus Bear can help with? (We'll try to take your feedback on board)"  FontSize="18" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" />
                <TextBox   TabIndex="0" x:Name="AnythingElseVALUE" AutomationProperties.AutomationId="txtBoxAnythingElse" Margin="0,15,0,0" TextWrapping="Wrap" Background="#FFF" BorderBrush="#000" Foreground="#000" Padding="5,1,5,1"  BorderThickness="1" FontSize="18" TextAlignment="Left" MaxLines="1" Height="30" TextChanged="AnythingElseVALUE_TextChanged">

                </TextBox>
            </StackPanel>
        </Viewbox>

        <Button Grid.Row="4"  x:Name="btnContinue" AutomationProperties.AutomationId="btnContinue" AnythingElse  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,10,0,0" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Page>
