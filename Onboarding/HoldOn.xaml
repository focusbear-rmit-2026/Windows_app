<Page x:Class="Focus_Bear.Onboarding.HoldOn"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <!-- Content fills remaining space -->
            <RowDefinition Height="8*" />

            <!-- Buttons take only required height -->
            <RowDefinition Height="2*" />
       
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- Content fills remaining space -->
                <RowDefinition Height="3*" />
                <RowDefinition Height="7*" />
            </Grid.RowDefinitions>
        
            <TextBlock  Grid.Row="0"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xHold on a minute!" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">

                <Image MaxHeight="260"  MaxWidth="260" Source="../Images/new/bear_hold.png" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center"  />
                <!-- SPEECH BUBBLE -->
                <controls:SpeechBubble x:Name="Bubble1"
                            Text="xArr… if you want to focus better, you’ve got to get your habits shipshape first."
                            Direction="Right"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:SpeechBubble.RenderTransform>
                        <!-- Move LEFT of image -->
                        <TranslateTransform X="-235" Y="20"/>
                    </controls:SpeechBubble.RenderTransform>

                </controls:SpeechBubble>

            </Grid>
        </Grid>

        <Button Grid.Row="1"  x:Name="btnOkay" AutomationProperties.AutomationId="btnOkay"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnOkay_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnOkayText" Margin="8" Text="xOkay..." Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
              
    </Grid>
</Page>

