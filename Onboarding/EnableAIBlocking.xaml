<Page x:Class="Focus_Bear.Onboarding.EnableAIBlocking"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      IsVisibleChanged="Page_IsVisibleChanged" >

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        
        <Grid>

            <Grid.RowDefinitions>
                <!-- Top progress take only required height -->
                <RowDefinition Height="1.5*" />

                <!-- Content fills remaining space -->
                <RowDefinition Height="6.5*" />

                <!-- Buttons take only required 15% height -->
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>

            <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
              Step1Percentage="0" 
              Step2Percentage="0" Step1ImageSource="../images/new/eye_orange.png" Step1LabelColor="#EB912E" />
            
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*" />
                    <!-- 28.6% -->
                    <RowDefinition Height="25*" />
                    <!-- 54.3% -->
                    <RowDefinition Height="45*" />
                    <!-- 17.1% -->
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image MaxHeight="260"  MaxWidth="260" Source="../Images/new/bear_useAi.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                    <!-- SPEECH BUBBLE -->
                    <controls:SpeechBubble x:Name="Bubble1"
                                        Text="xDon’t worry, the AI provider doesn’t get your data!"
                                        Direction="Right" FontSize="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                        <controls:SpeechBubble.RenderTransform>
                            <!-- Move LEFT of image -->
                            <TranslateTransform X="-180" Y="-30"/>
                        </controls:SpeechBubble.RenderTransform>

                    </controls:SpeechBubble>

                </Grid>
                <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xDo you want to use AI to block distractions?" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock  Name="Description" Margin="0,10,0,0" TextWrapping="Wrap" Text="xFocus Bear can use AI to detect if you’re getting distracted and guide you back on track." FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid  Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">

                    <StackPanel Orientation="Horizontal">

                        <!-- ITEM 1 -->
                        <Grid Width="195" Height="135" Margin="0,0,20,0">

                            <!-- Rectangle -->
                            <Border Width="195" 
                                    Height="110"
                                    Background="{DynamicResource SoftCreamColor}"
                                    CornerRadius="15"
                                    VerticalAlignment="Bottom">
                                <TextBlock Name="Item1" Margin="10,32,10,0" TextWrapping="Wrap" Text="xThe AI never knows who you are." FontSize="15" FontWeight="Normal"  VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Circle (half out, half in) -->
                            <Border Width="50"
                                    Height="50"
                                    Background="#EB912E"
                                    CornerRadius="50"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,0"
                                    Panel.ZIndex="1">

                                <Image Source="../images/new/privacy3.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                        </Grid>

                        <!-- ITEM 2 -->
                        <Grid Width="195" Height="135" Margin="0,0,20,0">

                            <Border Width="195"
                                    Height="110"
                                    Background="{DynamicResource SoftCreamColor}"
                                    CornerRadius="15"
                                    VerticalAlignment="Bottom">
                                <TextBlock Name="Item2" Margin="10,32,10,0" TextWrapping="Wrap" Text="xYour browsing stays private - we don't share it with AI providers." FontSize="15" FontWeight="Normal"  VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />
                            </Border>

                            <Border Width="50"
                                    Height="50"
                                    Background="#EB912E"
                                    CornerRadius="50"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,0"
                                    Panel.ZIndex="1">

                                <Image Source="../images/new/privacy1.png" Width="20" Height="20"/>
                            </Border>

                        </Grid>

                        <!-- ITEM 3 -->
                        <Grid Width="195" Height="135">

                            <Border Width="195"
                        Height="110"
                        Background="{DynamicResource SoftCreamColor}"
                        CornerRadius="15"
                        VerticalAlignment="Bottom">
                                <TextBlock Name="Item3" Margin="10,32,10,0" TextWrapping="Wrap" Text="xYou can turn this off whenever you like." FontSize="15" FontWeight="Normal" VerticalAlignment="Top" TextAlignment="Center" HorizontalAlignment="Center" />

                            </Border>

                            <Border Width="50"
                                    Height="50"
                                    Background="#EB912E"
                                    CornerRadius="50"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,0"
                                    Panel.ZIndex="1">       

                                <Image Source="../images/new/privacy4.png" Width="20" Height="20"/>
                            </Border>

                        </Grid>

                    </StackPanel>

                </Grid>

            </Grid>

            <StackPanel  Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button x:Name="btnNoThanks" AutomationProperties.AutomationId="btnNoThanks"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNoThanks_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnNoThanksText" Margin="8" Text="xNo Thanks" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="btnMakeMeIndistractible" AutomationProperties.AutomationId="btnMakeMeIndistractible"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,20,7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnMakeMeIndistractible_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnMakeMeIndistractibleText" Margin="8" Text="xMake me indistractible" Foreground="Black"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Grid>
        
    </Grid>
    
</Page>

