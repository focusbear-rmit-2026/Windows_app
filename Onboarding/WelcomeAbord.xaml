<Window x:Class="Focus_Bear.Onboarding.WelcomeAbord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="Focus Bear" Height="660" Width="750"  ResizeMode="NoResize" Closed="Window_Closed">

    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="150" />
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto" MinHeight="50" />
            <RowDefinition Height="Auto" MinHeight="40" />
            <RowDefinition Height="Auto" MinHeight="63" />
            <RowDefinition Height="Auto" MinHeight="10" />
            <RowDefinition Height="Auto" MinHeight="35" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="120"  Width="120" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="191,0,191,5"/>
        <TextBlock  Grid.Row="1" Margin="0,0,0,0" TextWrapping="Wrap" Text="Focus Bear" Foreground="#000" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="2" Name="Welcome" Margin="0,18,0,0" TextWrapping="Wrap" Text="Welcome Abord!" Foreground="#000" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="3" Name="Descriptiopn1" Margin="40,30,40,0" TextWrapping="Wrap" Text="xxLooking forward!" Foreground="#272727" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="4" Name="Descriptiopn2" Margin="40,20,40,30" TextWrapping="Wrap" Text="xxYou won't..!" Foreground="#272727" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <StackPanel  Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Grid.Row="5" Grid.ColumnSpan="2" x:Name="btnABitLaterPlease"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Width="216" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnABitLaterPlease_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnABitLaterPleaseText" Margin="8" Text="xA bit later please"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Row="5" Grid.ColumnSpan="2" x:Name="btnLetsDoIt"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Width="216" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="20" Cursor="Hand" FontWeight="Semibold" Click="btnLetsDoIt_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="buttonLetsDoItText" Margin="8" Text="xLet's do it"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
        <Separator Grid.Row="6" Margin="0,50,0,0"/>

        <TextBlock  Grid.Row="7" Name="Copyright" Margin="13" TextWrapping="Wrap" Text="xx© 2022 Focus Bear, All Rights Reserved." Foreground="#272727" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

        <Border x:Name="GridShade" CornerRadius="0" Grid.RowSpan="9" Margin="0,0,0,-10" Background="#FF060606" Opacity="0.65"   Visibility="Collapsed" IsVisibleChanged="GridShade_IsVisibleChanged"/>
    </Grid>
</Window>
