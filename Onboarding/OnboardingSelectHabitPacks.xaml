<Page x:Class="Focus_Bear.Onboarding.OnboardingSelectHabitPacks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
       d:DesignHeight="1080" d:DesignWidth="1920"
      Title="OnboardingSelectHabitPacks" Background="#fff">
   
        <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="../images/background.png" AlignmentY="Top" AlignmentX="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="185" />
            <RowDefinition Height="Auto" MinHeight="70" />
            <RowDefinition Height="60"  />
            <RowDefinition Height="*"  />
            <RowDefinition Height="150" />

        </Grid.RowDefinitions>

        <Image Grid.Row="0" Height="135"  Width="135" Source="../Images/FBicon-256.png" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1"  Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="xChoose a habit pack to get started" Foreground="#000" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox Name="ComboBoxPack"  Grid.Row="2"  Width="250" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0"  SelectedIndex="0" FontSize="15" SelectionChanged="ComboBoxPack_SelectionChanged">
        </ComboBox>
        <Viewbox Grid.Row="3"  Stretch="Uniform">

            <DockPanel  Margin="50,25,50,25" Width="853" Height="505">
                <wv2:WebView2 Name="webView"  />
            </DockPanel>
        </Viewbox>

        <Button Grid.Row="4"  x:Name="btnContinue"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Foreground="#e88800"  Height="40" Width="400" VerticalAlignment="Top" HorizontalContentAlignment="Center" Padding="0" Margin="0,0,0,0" FontSize="17" Cursor="Hand" FontFamily="Segoe UI Semibold" Click="btnContinue_Click" >
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock x:Name="btnContinueTXT" Text="xContinue"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
  
</Page>
