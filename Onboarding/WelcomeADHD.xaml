<Page x:Class="Focus_Bear.Onboarding.WelcomeADHD"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Focus_Bear.Onboarding"
      xmlns:controls="clr-namespace:Focus_Bear.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome" Loaded="Page_Loaded" IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="WelcomeADHD">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <!-- Content fills remaining space -->
            <RowDefinition Height="8*" />

            <!-- Buttons take only required height -->
            <RowDefinition Height="2*" />
       
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image MaxHeight="280"  MaxWidth="280" Source="../Images/new/bear_adhd.png" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"  />
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
                        Text="xI’m actually not that good at focusing though"
                        Direction="Right"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"> 

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-235" Y="-30"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>

            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble2" Opacity="0"
                        Text="xI’ve got ADHD and get distracted all the time 😢"
                        Direction="Left"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="245" Y="30"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
            
        </Grid>

        <StackPanel  Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnNeverHadIssue" AutomationProperties.AutomationId="btnNeverHadIssue"  Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,7,20,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnNeverHadIssue_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnNeverHadIssueText" Margin="8" Text="xI never had that issue" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button x:Name="btnMeToo" AutomationProperties.AutomationId="btnMeToo"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0" Margin="7,7" FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnMeToo_Click">
                <Button.Content>
                    <StackPanel  Orientation="Horizontal">
                        <TextBlock Name="btnMeTooText" Margin="8" Text="xMee too!" Foreground="Black"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>

    </Grid>
</Page>

