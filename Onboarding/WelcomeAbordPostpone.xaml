<Window x:Class="Focus_Bear.Onboarding.WelcomeAbordPostpone"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        mc:Ignorable="d"
        Title="WelcomeAbordPostpone" Height="300" Width="498" WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown"  >
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="72"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button  Grid.Row="0" x:Name="btnClose" Content="Button" Style="{DynamicResource BtnStyleCloseRed}" SnapsToDevicePixels="True" HorizontalAlignment="Right" Height="34" VerticalAlignment="Top" Width="34" ToolTip="Close" Click="btnClose_Click" Grid.Column="1" Cursor="Hand"/>
        <TextBlock  Grid.Row="1" Name="Heading" Margin="0,0,0,0" TextWrapping="Wrap" Text="If you have something urgent, you can postpone the Onboarding process for few Minutes." FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel  Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock  Margin="0,0,0,0" Name="PostponeMinsText" TextWrapping="Wrap" Text="xSelect minutes to postpone:" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center"/>

            <ComboBox Name="ComboBoxMinutes" Width="50" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"  SelectedIndex="0">
                <ComboBoxItem Content="5"></ComboBoxItem>
                <ComboBoxItem Content="10"></ComboBoxItem>
                <ComboBoxItem Content="15"></ComboBoxItem>
                <ComboBoxItem Content="20"></ComboBoxItem>
                <ComboBoxItem Content="25"></ComboBoxItem>
                <ComboBoxItem Content="30"></ComboBoxItem>
                <ComboBoxItem Content="45"></ComboBoxItem>
                <ComboBoxItem Content="60"></ComboBoxItem>
                <ComboBoxItem Content="90"></ComboBoxItem>
            </ComboBox>


        </StackPanel>

        <Button Grid.Row="3" Grid.ColumnSpan="2" x:Name="btnPostponeOnboarding"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True" Width="216" Height="43" HorizontalContentAlignment="Center" Padding="0" Margin="7,7" FontSize="16" Cursor="Hand" FontWeight="Semibold" Click="btnPostponeOnboarding_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnPostponeText" Margin="8" Text="xPostpone Onboarding" Foreground="Black"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>

   
</Window>
