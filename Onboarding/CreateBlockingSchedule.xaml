<Page x:Class="Focus_Bear.Onboarding.CreateBlockingSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Focus_Bear.Preferences"
             xmlns:localView="clr-namespace:Focus_Bear.Utils"
             xmlns:controls="clr-namespace:Focus_Bear.Controls"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             mc:Ignorable="d"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             d:DesignHeight="900" d:DesignWidth="900" IsVisibleChanged="Page_IsVisibleChanged" AutomationProperties.AutomationId="CreateBlockingSchedule">
    <Page.Resources>
        <local:DaysOfWeekIndexConverter x:Key="DaysOfWeekIndexConverter" />
        <local:EnumBooleanConverter x:Key="EnumBooleanConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    </Page.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="../Theme/PreferencesStyle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top progress take only required height -->
                    <RowDefinition Height="1.5*" />

                    <!-- Content fills remaining space -->
                    <RowDefinition Height="6.5*" />

                    <!-- Buttons take only required 15% height -->
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>
                <controls:StepProgressBar Grid.Row="0" x:Name="ProgressControl" HorizontalAlignment="Center"
                        Step1Percentage="100"
                        Step2Percentage="70" Step1ImageSource="../images/new/tick.png" Step1LabelColor="#EB912E" Step2LabelColor="#EB912E"  />


                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15*" />
                        <RowDefinition Height="85*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Name="Heading" Margin="0,0,0,10" TextWrapping="Wrap" Text="xSet Block Details" FontSize="35" FontWeight="SemiBold" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="810">

                            <!-- Card 1: Name + Schedule + Active time -->
                            <Border Padding="20"
                                Background="{DynamicResource SoftCreamColor}"
                                CornerRadius="12"
                                BorderBrush="#FFF2E1C1"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <StackPanel>

                                    <!-- Block name -->
                                    <TextBlock x:Name="BlockName" Text="xBlock name" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" TabIndex="0" x:Name="BlockingScheduleName" Style="{StaticResource RoundedTextBoxStyle}" AutomationProperties.AutomationId="txtBlockingScheduleName" TextWrapping="Wrap" MaxLength="45" FontSize="13" TextAlignment="Left" MaxLines="1" MinHeight="34" VerticalContentAlignment="Center">
                                            <Binding Path="name"/>
                                        </TextBox>
                                        <Button Grid.Column="1" x:Name="BtnEmojiPicker" AutomationProperties.AutomationId="btnEmojiPicker" Style="{StaticResource EmojiPickerButtonStyle}" Margin="10,0,0,0" ToolTip="Choose an emoji for this schedule" Click="BtnEmojiPicker_Click">
                                            <emoji:TextBlock x:Name="EmojiPickerText" FontSize="17"/>
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="EmojiContextMenu" Placement="Bottom">
                                                    <MenuItem Header="None" AutomationProperties.AutomationId="miEmojiNone" Click="EmojiMenuItem_Click"/>
                                                    <Separator/>
                                                    <MenuItem Tag="🧠" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🧠" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🌅" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🌅" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🌙" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🌙" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="⚡️" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="⚡️" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🏕️" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🏕️" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🛠️" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🛠️" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🎯" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🎯" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="😎" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="😎" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="💪" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="💪" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="📵" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="📵" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="💻" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="💻" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="📚" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="📚" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🎨" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🎨" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🏋️" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🏋️" FontSize="16"/></MenuItem.Header></MenuItem>
                                                    <MenuItem Tag="🧘" Click="EmojiMenuItem_Click"><MenuItem.Header><emoji:TextBlock Text="🧘" FontSize="16"/></MenuItem.Header></MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>

                                    <!-- Weekday selector -->
                                    <TextBlock x:Name="Title" Text="xBlocking schedule" FontWeight="SemiBold" Margin="0,20,0,10"/>

                                    <!-- Quick-select presets -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,4">
                                        <ToggleButton x:Name="BtnWeekdays" AutomationProperties.AutomationId="btnWeekdays" Style="{StaticResource DayPresetToggleButtonStyle}" Content="xWeekdays" Click="BtnWeekdays_Click"/>
                                        <ToggleButton x:Name="BtnWeekends" AutomationProperties.AutomationId="btnWeekends" Style="{StaticResource DayPresetToggleButtonStyle}" Content="xWeekends" Click="BtnWeekends_Click"/>
                                        <ToggleButton x:Name="BtnEveryday" AutomationProperties.AutomationId="btnEveryday" Style="{StaticResource DayPresetToggleButtonStyle}" Content="xEveryday" Click="BtnEveryday_Click"/>
                                    </StackPanel>

                                    <UniformGrid Rows="1" Columns="7" HorizontalAlignment="Left">
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Mon" AutomationProperties.AutomationId="tglMon" Content="xMon" IsChecked="{Binding Monday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Tue" AutomationProperties.AutomationId="tglTue" Content="xTue" IsChecked="{Binding Tuesday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Wed" AutomationProperties.AutomationId="tglWed" Content="xWed" IsChecked="{Binding Wednesday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Thu" AutomationProperties.AutomationId="tglThu" Content="xThu" IsChecked="{Binding Thursday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Fri" AutomationProperties.AutomationId="tglFri" Content="xFri" IsChecked="{Binding Friday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Sat" AutomationProperties.AutomationId="tglSat" Content="xSat" IsChecked="{Binding Saturday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                        <ToggleButton Style="{StaticResource DayCircleToggleButtonStyle}" x:Name="Sun" AutomationProperties.AutomationId="tglSun" Content="xSun" IsChecked="{Binding Sunday}" Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                                    </UniformGrid>

                                    <!-- Active time -->
                                    <TextBlock x:Name="ActiveTimeTitle" Text="xActive time" FontWeight="SemiBold" Margin="0,24,0,10"/>
                                    <localView:TimeRangeSlider x:Name="ActiveTimeSlider" AutomationProperties.AutomationId="sldActiveTime" HorizontalAlignment="Stretch"/>

                                </StackPanel>
                            </Border>

                            <!-- Card 2: Strictness (no block list yet during onboarding - no focus modes exist) -->
                            <Border Padding="20"
                                Margin="0,16,0,0"
                                Background="{DynamicResource SoftCreamColor}"
                                CornerRadius="12"
                                BorderBrush="#FFF2E1C1"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StrictnessLevel" Text="xStrictness level:" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <RadioButton x:Name="RadioFlexible" AutomationProperties.AutomationId="radioFlexible" GroupName="StrictnessLevel" Style="{StaticResource StrictnessRadioButtonStyle}" Tag="CHILL_MODE" Content="xFlexible"
                                                     IsChecked="{Binding BlockLevel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=CHILL_MODE, Mode=TwoWay}" Checked="StrictnessRadio_Checked"/>
                                        <RadioButton x:Name="RadioModerate" AutomationProperties.AutomationId="radioModerate" GroupName="StrictnessLevel" Style="{StaticResource StrictnessRadioButtonStyle}" Tag="STRICT" Content="xModerate"
                                                     IsChecked="{Binding BlockLevel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=STRICT, Mode=TwoWay}" Checked="StrictnessRadio_Checked"/>
                                        <RadioButton x:Name="RadioStrict" AutomationProperties.AutomationId="radioStrict" GroupName="StrictnessLevel" Style="{StaticResource StrictnessRadioButtonStyle}" Tag="IRON_FOCUS" Content="xStrict"
                                                     IsChecked="{Binding BlockLevel, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=IRON_FOCUS, Mode=TwoWay}" Checked="StrictnessRadio_Checked"/>
                                    </StackPanel>

                                    <TextBlock x:Name="StrictnessDescription" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource ForegroundGrey}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- More Options (expanded by default during onboarding, matching mac) -->
                            <Expander x:Name="MoreOptionsExpander" AutomationProperties.AutomationId="expMoreOptions" Padding="0" Margin="0,16,0,20" HorizontalAlignment="Stretch" Cursor="Hand" Style="{StaticResource CardExpanderStyle}" Expanded="MoreOptionsExpander_Expanded">
                                <Expander.Header>
                                    <TextBlock x:Name="MoreOptionsHeaderText" FontSize="14" Padding="0,0,0,0" FontWeight="Normal" TextAlignment="Left"/>
                                </Expander.Header>

                                <StackPanel Margin="20,10,20,10">
                                    <StackPanel Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <CheckBox  x:Name="SkipMicroBreaks"   AutomationProperties.AutomationId="chkSkipMicroBreaks" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0" IsChecked="{Binding bMicroBreaksEnabled, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">xxSkip microbreaks</CheckBox>
                                        <Image x:Name="MicroBreaksInfo"  Source="{DynamicResource InfoImage}" Margin="5,10,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <CheckBox  x:Name="UseAIToDecide"  AutomationProperties.AutomationId="chkUseAIToDecide" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="5,-3,0,0" IsChecked="{Binding bAIBlockingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">xxUse AI to decide if websites should be allowed</CheckBox>
                                        <Image x:Name="UseAIToDecideInfo"  Source="{DynamicResource InfoImage}"  Margin="5,10,0,0" Width="20" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <StackPanel  Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Button x:Name="btnAddBlock" AutomationProperties.AutomationId="btnAddBlock"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="43" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="0"   FontSize="17" Cursor="Hand" FontWeight="Semibold" Click="btnAddBlock_Click"  >
                        <Button.Content>
                            <StackPanel  Orientation="Horizontal">
                                <TextBlock Name="btnAddBlockText" Margin="8" Text="xAdd Block" Foreground="Black"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>
        <Grid Height="270" x:Name="SideImage"
                 Background="Transparent"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Panel.ZIndex="99" Margin="0,10,-57,15">
            <!-- ensures it's on top -->
            <Image Source="../Images/new/bear_setDistraction.png" Stretch="Uniform"/>
            <!-- SPEECH BUBBLE -->
            <controls:SpeechBubble x:Name="Bubble1"
                         Text="xFor example, block distracting websites during work hours"
                         Direction="Right"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" FontSize="13">

                <controls:SpeechBubble.RenderTransform>
                    <!-- Move LEFT of image -->
                    <TranslateTransform X="-170" Y="-40"/>
                </controls:SpeechBubble.RenderTransform>

            </controls:SpeechBubble>
        </Grid>
    </Grid>
</Page>
