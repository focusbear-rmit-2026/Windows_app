<Window x:Class="Focus_Bear.SetIntention.ShowIntention"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.SetIntention"
        mc:Ignorable="d"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}"
        Title="Focus Bear" Height="315" Width="360" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Image Name="TopIcon" Grid.Column="0"  Margin="0,10,0,10" Height="64" Width="64" Source="../Images/FBicon-64.png"   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock  Grid.Row="1" Name="Heading"  Margin="10,5,10,0" TextWrapping="Wrap" Text="xYou intention for facebook.com" Foreground="{DynamicResource ForegroundColor}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBox  Grid.Row="2" IsReadOnly="True" Name="TxtIntention" AutomationProperties.AutomationId="txtBoxIntention" Visibility="Visible"  TextWrapping="Wrap" AcceptsReturn="True"    Height="70" Margin="15" VerticalAlignment="Top"  FontSize="15" >
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="3"
                          Direction="330"
                          Color="Gray"
                          Opacity="0.5"
                          BlurRadius="6"
                           />
            </TextBox.Effect>
            <TextBox.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.FocusVisualStyle>
        </TextBox>
        <Button  Grid.Row="3"  x:Name="btnBlockIt" AutomationProperties.AutomationId="btnBlockIt"  Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Width="300" Height="30" HorizontalContentAlignment="Center" Padding="0" Margin="0,5" FontSize="14" Cursor="Hand" FontWeight="Semibold" Click="btnBlockIt_Click">
            <Button.Content>
                <StackPanel  Orientation="Horizontal">
                    <TextBlock Name="btnBlockItText" Margin="1" Text="xI'm done. Block this site now"/>
                </StackPanel>
            </Button.Content>
        </Button>

    </Grid>
</Window>
