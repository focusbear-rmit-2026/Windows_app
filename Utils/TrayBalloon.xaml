<Window x:Class="Focus_Bear.TrayBalloon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        x:Name="window"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        Title="Focus Bear"  Width="340" Height="80" WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded" MouseDown="Window_MouseDown" ShowInTaskbar="False" Deactivated="window_Deactivated" AutomationProperties.AutomationId="TrayBalloon">
    <Window.Resources>
        <Storyboard x:Key="WinFade">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="window">
                <EasingDoubleKeyFrame KeyTime="0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WinFade}"/>
        </EventTrigger>
    </Window.Triggers>
    <Grid Background="#2B2B2B">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AppTitle" Margin="0" TextWrapping="Wrap" Text="" Foreground="White" FontSize="14" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Left" Grid.Column="2"/>
        <TextBlock x:Name="TrayBaloonTipMsg" TextWrapping="Wrap" Text="" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Margin="0,4,0,0" Grid.Row="1"  />
        <Image Width="42" Height="42"  Margin="0" Source="../Images/FBicon-64.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" VerticalAlignment="Center" Grid.RowSpan="2" HorizontalAlignment="Center"/>

    </Grid>
</Window>
