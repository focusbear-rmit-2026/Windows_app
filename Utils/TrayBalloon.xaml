<Window x:Class="Focus_Bear.TrayBalloon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear"
        x:Name="window"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        Title="Focus Bear"  Width="340" MinHeight="80" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Loaded="Window_Loaded" MouseDown="Window_MouseDown" ShowInTaskbar="False" Deactivated="window_Deactivated" AutomationProperties.AutomationId="TrayBalloon">
    <Window.Resources>
        <Storyboard x:Key="WinFade">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="window">
                <EasingDoubleKeyFrame KeyTime="0" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WinFade}"/>
        </EventTrigger>
    </Window.Triggers>
    <Grid Background="#2B2B2B">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AppTitle" Margin="0" TextWrapping="Wrap" Text="" Foreground="White" FontSize="14" VerticalAlignment="Bottom" TextAlignment="Center" HorizontalAlignment="Left" Grid.Column="2"/>
        <TextBlock x:Name="TrayBaloonTipMsg" TextWrapping="Wrap" Text="" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Margin="0,4,12,12" Grid.Row="1"  />
        <Image Width="42" Height="42"  Margin="0" Source="../Images/FBicon-64.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" VerticalAlignment="Center" Grid.RowSpan="2" HorizontalAlignment="Center"/>

        <!-- Optional action row (e.g. "Request unlock" during a teacher class session) with an auto-close
             countdown. Hidden unless an action is supplied. -->
        <StackPanel x:Name="ActionPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,12" Visibility="Collapsed">
            <Button x:Name="btnAction" Content="" Padding="12,5" Cursor="Hand" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Click="btnAction_Click">
                <!-- Full template so our orange sticks (the default button template shows a light-blue hover). -->
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="#F5A623">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E08E1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C97F17"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="TxtCountdown" Text="" Foreground="#B0B0B0" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
