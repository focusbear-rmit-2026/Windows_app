<UserControl x:Class="Focus_Bear.Utils.HourControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Focus_Bear.Utils"
             mc:Ignorable="d" 
             Height="27" Width="146">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#727272" />
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="DarkGray" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#fff" />
        <SolidColorBrush x:Key="SolidBorderBrush" Color="Black" />

        <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBoxBase}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBoxBase}">
                        <Border   Name="Border" CornerRadius="0"   Padding="2" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="{StaticResource SolidBorderBrush}"  BorderThickness="0" >
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DisabledBackgroundBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Background="Bisque" Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="13" />
            <RowDefinition Height="13" />
        </Grid.RowDefinitions>
        <TextBox Name="NUDHTextBox" AutomationProperties.AutomationId="txtBox0" Margin="1,0,0,0" Foreground="#000" BorderBrush="#FF454545" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDHTextBox_PreviewKeyUp" TextChanged="NUDHTextBox_TextChanged" FontSize="14" Padding="0,0,0,0" MouseWheel="NUDTextBox_MouseWheel" BorderThickness="0" TextAlignment="Right" TabIndex="0"  GotFocus="NUDHTextBox_GotFocus" Background="{x:Null}" MaxLength="2" Width="25" Height="24"/>
        <TextBox Foreground="#000" AutomationProperties.AutomationId="txtBox1" BorderBrush="#000" Text=":" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" TextAlignment="Right" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDHTextBox_PreviewKeyUp" TextChanged="NUDHTextBox_TextChanged" FontSize="14" BorderThickness="0" HorizontalAlignment="Center" Padding="-1,0,0,0" Background="{x:Null}" Margin="0" Height="24"/>
        <TextBox Name="NUDMTextBox" AutomationProperties.AutomationId="txtBox2" Foreground="#000" BorderBrush="#FF454545" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDMTextBox_PreviewKeyDown" PreviewKeyUp="NUDMTextBox_PreviewKeyUp" TextChanged="NUDMTextBox_TextChanged" FontSize="14" Padding="0,0,0,0" MouseWheel="NUDTextBox_MouseWheel" BorderThickness="0" TabIndex="1"  GotFocus="NUDMTextBox_GotFocus" Background="{x:Null}" MaxLength="2" Width="25" Height="24"/>
        <TextBox Foreground="#000" AutomationProperties.AutomationId="txtBox3" BorderBrush="#FF454545" Text=":" Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDHTextBox_PreviewKeyUp" TextChanged="NUDHTextBox_TextChanged" FontSize="14" BorderThickness="0" HorizontalAlignment="Center" Padding="-2,-1,0,0" Margin="0" Background="{x:Null}" Height="24"/>
        <!--<TextBox Name="NUDSTextBox" Foreground="#FFE1E1E1" BorderBrush="#FF454545" Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDTextBox_PreviewKeyUp" TextChanged="NUDTextBox_TextChanged" FontSize="14" Padding="0,2,0,0" MouseWheel="NUDTextBox_MouseWheel" BorderThickness="0" TabIndex="2" Width="18" HorizontalAlignment="Left" GotFocus="NUDSTextBox_GotFocus" Background="{x:Null}"/>-->
        <TextBox x:Name="NUDSTextBox" AutomationProperties.AutomationId="txtBox4" Foreground="#000" BorderBrush="#FF454545" Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDTextBox_PreviewKeyUp" TextChanged="NUDTextBox_TextChanged" FontSize="14" Padding="0,0,0,0" MouseWheel="NUDTextBox_MouseWheel" BorderThickness="0" TabIndex="2" Width="27" HorizontalAlignment="Left" GotFocus="NUDSTextBox_GotFocus" Background="{x:Null}" MaxLength="2" Height="24"/>
        <TextBox Name="NUDAMPTextBox" AutomationProperties.AutomationId="txtBox5" Foreground="#000" BorderBrush="#FF454545" Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" PreviewKeyDown="NUDTextBox_PreviewKeyDown" PreviewKeyUp="NUDTextBox_PreviewKeyUp" TextChanged="NUDAMPTextBox_TextChanged" LostFocus="NUDAMPTextBox_LostFocus" FontSize="14" Padding="0,1,0,0" MouseWheel="NUDTextBox_MouseWheel" BorderThickness="0" TabIndex="2" Width="27" HorizontalAlignment="Left" GotFocus="NUDAMPTextBox_GotFocus" Margin="27,0,0,0" Background="{x:Null}" MaxLength="2" Height="24"/>
        <RepeatButton Name="NUDButtonUP" AutomationProperties.AutomationId="repeatButtonUp" Grid.Column="5" Grid.Row="0" FontSize="8" FontFamily="Marlett" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="NUDButtonUP_Click" Margin="0,2,2,0" Width="19" HorizontalAlignment="Left" BorderBrush="#FF545454" Background="#FF989898">5</RepeatButton>
        <RepeatButton Name="NUDButtonDown" AutomationProperties.AutomationId="repeatButtonDown" Grid.Column="5" Grid.Row="1" FontSize="8"  FontFamily="Marlett" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="11" VerticalAlignment="Top" Click="NUDButtonDown_Click" Margin="0,0,2,0" Width="19" HorizontalAlignment="Left" BorderBrush="#FF545454" Background="#FF989898">6</RepeatButton>
    </Grid>
</UserControl>
