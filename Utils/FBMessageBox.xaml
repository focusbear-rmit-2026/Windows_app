<Window x:Class="Focus_Bear.Utils.FBMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focus_Bear.Utils"
        mc:Ignorable="d"
        Title="FBMessageBox" Height="Auto"   Width="250" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="None" Topmost="True" >
    <Border  Grid.Row="1"  BorderBrush="LightGray" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="72"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Width="60" Height="60"  Margin="0" Source="../Images/FBicon-64.png" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Stretch="Fill" VerticalAlignment="Bottom"   HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" x:Name="Caption" TextWrapping="Wrap" Text="xxThis is a simple caption  else."  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,10,20,0" MaxWidth="360" FontWeight="Bold"  TextAlignment="Center" Visibility="Collapsed" />

            <TextBlock Grid.Row="2" x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Text="xxThis is a simple text for testing and nothing else. This is a simple text for testing and nothing else." MaxWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,0"   TextAlignment="Center" />
            <StackPanel Grid.Row="3"  Orientation="Vertical" Margin="0,20,0,10">
                <Button  x:Name="btnOK"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,20,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Click="btnOK_Click">
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnOKTxt" Text="xOK"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button   x:Name="btnYes"   Style="{StaticResource BtnStyleLightOrangeBordered}" IsEnabled="True"   Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,0,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Visibility="Collapsed" Click="btnYes_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnYesTxt" Text="xYes"  Padding="15,0,15,0"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button    x:Name="btnNo"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,0,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Visibility="Collapsed" Click="btnNo_Click" >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnNoTxt" Text="xNo" Padding="15,0,15,0"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button    x:Name="btnCancel"   Style="{StaticResource BtnStyleClearOrangeBordered}" IsEnabled="True"  Height="30" MinWidth="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"  Margin="20,0,20,20" FontSize="15" Cursor="Hand" FontWeight="Semibold" Visibility="Collapsed" Click="btnCancel_Click"  >
                    <Button.Content>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Name="btnCancelTxt" Text="xCancel"  Padding="15,0,15,0"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            <CheckBox Grid.Row="4"  x:Name="DoNotShowAnymore" Margin="10,0,0,10" Checked="DoNotShowAnymore_Checked" Unchecked="DoNotShowAnymore_Unchecked" Visibility="Collapsed">xDon't show this anymore</CheckBox>
        </Grid>
    </Border>
</Window>
