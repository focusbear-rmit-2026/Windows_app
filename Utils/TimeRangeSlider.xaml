<UserControl x:Class="Focus_Bear.Utils.TimeRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             d:DesignWidth="500" AutomationProperties.AutomationId="TimeRangeSlider">
    <UserControl.Resources>
        <Style x:Key="RangeThumbSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Background explicitly null (not Transparent, and not inherited from the
                             app's implicit Grid style) - a Transparent brush still participates in
                             hit-testing, which would let this Slider's empty track area swallow
                             clicks meant for the OTHER overlapping Slider's Thumb. -->
                        <Grid Background="{x:Null}">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent" BorderThickness="0" Focusable="False" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="#E88800" StrokeThickness="3">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Start/End shown as two separate rounded chips with a dash between, left-aligned - matches
             mac's Active time display instead of a single centered text line. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,14">
            <Border Background="{DynamicResource TextBoxBackgroundColor}" BorderBrush="LightGray" BorderThickness="2" CornerRadius="8" Padding="14,8" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <TextBlock x:Name="StartTimeLabel" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"/>
            </Border>
            <TextBlock Text="–" FontSize="14" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundGrey}"/>
            <Border Background="{DynamicResource TextBoxBackgroundColor}" BorderBrush="LightGray" BorderThickness="2" CornerRadius="8" Padding="14,8" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <TextBlock x:Name="EndTimeLabel" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}"/>
            </Border>
        </StackPanel>

        <Grid x:Name="TrackGrid" Background="Transparent" Height="20" Margin="10,0,10,0" SizeChanged="TrackGrid_SizeChanged">
            <Border Height="6" Background="{DynamicResource TabChosenColor}" CornerRadius="3" VerticalAlignment="Center"/>
            <Border x:Name="RangeHighlight" Height="6" Background="#E88800" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
            <Slider x:Name="StartSlider" AutomationProperties.AutomationId="sldTimeRangeStart" Style="{StaticResource RangeThumbSliderStyle}" Minimum="0" Maximum="1439" IsSnapToTickEnabled="True" TickFrequency="15" ValueChanged="Slider_ValueChanged"/>
            <Slider x:Name="EndSlider" AutomationProperties.AutomationId="sldTimeRangeEnd" Style="{StaticResource RangeThumbSliderStyle}" Minimum="0" Maximum="1439" IsSnapToTickEnabled="True" TickFrequency="15" ValueChanged="Slider_ValueChanged"/>
        </Grid>

        <Grid Background="Transparent" Margin="10,6,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="12AM" FontSize="11" Foreground="{DynamicResource ForegroundGrey}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="6AM" FontSize="11" Foreground="{DynamicResource ForegroundGrey}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="12PM" FontSize="11" Foreground="{DynamicResource ForegroundGrey}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="6PM" FontSize="11" Foreground="{DynamicResource ForegroundGrey}" HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</UserControl>
